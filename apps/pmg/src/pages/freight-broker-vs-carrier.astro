---
/**
 * Freight broker vs carrier. City-level NAP only. No street. No lead form.
 * Title, meta, H1, and FAQ copy are locked to the ship spec.
 */
import Base from '../layouts/Base.astro';
import site from '../data/site.json';

const siteURL = Astro.site?.toString() ?? `${site.canonicalOrigin}/`;
const pagePath = '/freight-broker-vs-carrier/';

const title = 'Freight Broker vs Carrier | Parcel Management Group';
const description =
  'A freight broker finds and manages carriers for your freight. A carrier owns the trucks or planes. PMG is a registered broker in Ventura, CA. Call (805) 984-4114.';

const faq = [
  {
    q: 'What is the difference between a freight broker and a carrier?',
    a: 'A carrier owns the trucks or planes. A broker finds the right carrier for your freight and manages the move. Parcel Management Group is a registered freight broker (USDOT 3266041 · MC 1030328).',
  },
  {
    q: 'Is Parcel Management Group a broker or a carrier?',
    a: 'PMG is a freight broker. We shop carriers, book the load, and support you after pickup. We serve shippers nationwide from Ventura, CA 93001. Call (805) 984-4114.',
  },
  {
    q: 'When should I use a freight broker instead of calling a carrier directly?',
    a: 'Use a broker when you want one team to compare options across small package, LTL, and full truckload, get a clear quote, and stay involved if something goes wrong. For small packages, you can also join PMG’s free Small Package Program — no fees and no contract.',
  },
  {
    q: 'How do I get a quote from Parcel Management Group?',
    a: 'Tell us what you ship, where it goes, and when you need it. We compare carriers and send a clear quote. See How freight quoting works or call (805) 984-4114.',
  },
];

const seo = {
  title,
  description,
  schema: [
    {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: 'Freight broker vs carrier: what shippers need to know',
      url: `${siteURL}freight-broker-vs-carrier/`,
      description,
      mainEntity: { '@id': `${siteURL}#organization` },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((qa) => ({
        '@type': 'Question',
        name: qa.q,
        acceptedAnswer: { '@type': 'Answer', text: qa.a },
      })),
    },
  ],
};
---
<Base title={seo.title} description={seo.description} canonical={pagePath} schema={seo.schema}>
  <section class="page-hero" aria-label="Freight broker vs carrier">
    <div class="wrap">
      <span class="eyebrow">Broker vs carrier</span>
      <h1>Freight broker vs carrier: what shippers need to know</h1>
    </div>
  </section>
  <section class="page-body">
    <div class="wrap prose">
      <p>A freight broker shops carriers and manages the move so you get a clear rate and support. A carrier owns the trucks or planes and hauls the freight. Parcel Management Group is a registered freight broker (USDOT 3266041 · MC 1030328) in Ventura, CA 93001. Call <a href="tel:+18059844114">(805) 984-4114</a>.</p>

      <h2>Broker vs carrier</h2>
      <ul>
        <li><strong>Carrier:</strong> Owns or operates the trucks, planes, or other equipment that move your freight.</li>
        <li><strong>Broker:</strong> Finds the right carrier for your load, books it, and stays with you if something goes wrong.</li>
        <li><strong>PMG role:</strong> We are the broker. We compare options across small package, LTL, and full truckload, then book and support the move.</li>
      </ul>

      <h2>When a broker helps</h2>
      <p>Use a broker when you want one team to compare modes and carriers, keep quoting simple, and handle issues after pickup. PMG also runs a free Small Package Program for UPS and FedEx — no fees and no contract to your business.</p>

      <h2>How quoting works with PMG</h2>
      <p>Tell us what you ship, where it goes, and when you need it. We compare carriers and send a clear quote. Details: <a href="/how-freight-quoting-works/">How freight quoting works</a>.</p>

      <p>Call <a href="tel:+18059844114">(805) 984-4114</a> or <a href="/#contact">start a chat</a>.</p>

      <p class="related">
        <a href="/services/">Services</a>
        <span aria-hidden="true">·</span>
        <a href="/about/">About</a>
        <span aria-hidden="true">·</span>
        <a href="/blog/reduce-shipping-costs-high-volume/">Reduce shipping costs</a>
        <span aria-hidden="true">·</span>
        <a href="/blog/parcel-audit-vs-freight-audit/">Parcel audit vs freight audit</a>
      </p>
    </div>
  </section>
  <section class="page-body" aria-label="Broker vs carrier questions">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">FAQ</span>
        <h2>Freight broker vs carrier, in short.</h2>
      </div>
      <div class="faq faq-static">
        {faq.map((qa) => (
          <div class="qa">
            <h3>{qa.q}</h3>
            <div class="a">
              {qa.q.startsWith('How do I get a quote') ? (
                <p>
                  Tell us what you ship, where it goes, and when you need it. We compare carriers and send a clear quote. See <a href="/how-freight-quoting-works/">How freight quoting works</a> or call (805) 984-4114.
                </p>
              ) : (
                <p>{qa.a}</p>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
