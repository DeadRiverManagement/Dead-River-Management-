---
/**
 * What is a freight broker. City-level NAP only. No street. No lead form.
 * Title, meta, H1, and FAQ copy are locked to the ship spec.
 */
import Base from '../layouts/Base.astro';
import site from '../data/site.json';

const siteURL = Astro.site?.toString() ?? `${site.canonicalOrigin}/`;
const pagePath = '/what-is-a-freight-broker/';

const title = 'What Is a Freight Broker? | Parcel Management Group';
const description =
  'A freight broker finds and manages carriers for your freight so you get a clear rate and support. PMG is a registered broker in Ventura, CA. Call (805) 984-4114.';

const faq = [
  {
    q: 'What is a freight broker?',
    a: 'A freight broker finds and manages carriers for your freight. They shop options, book the load, and stay with you if something goes wrong. Parcel Management Group is a registered freight broker (USDOT 3266041 · MC 1030328).',
  },
  {
    q: 'Is Parcel Management Group a freight broker?',
    a: 'Yes. PMG is a registered freight broker based in Ventura, CA 93001. We serve shippers nationwide across small package, LTL, and full truckload. Call (805) 984-4114.',
  },
  {
    q: 'What is the difference between a freight broker and a carrier?',
    a: 'A carrier owns the trucks or planes. A broker finds the right carrier for your freight and manages the move. See Freight broker vs carrier for the full comparison.',
  },
  {
    q: 'How do I get a quote from a freight broker like PMG?',
    a: 'Tell us what you ship, where it goes, and when you need it. We compare carriers and send a clear quote. See How freight quoting works or call (805) 984-4114.',
  },
];

const seo = {
  title,
  description,
  schema: [
    {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: 'What is a freight broker?',
      url: `${siteURL}what-is-a-freight-broker/`,
      description,
      mainEntity: { '@id': `${siteURL}#organization` },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((qa) => ({
        '@type': 'Question',
        name: qa.q,
        acceptedAnswer: { '@type': 'Answer', text: qa.a },
      })),
    },
  ],
};
---
<Base title={seo.title} description={seo.description} canonical={pagePath} schema={seo.schema}>
  <section class="page-hero" aria-label="What is a freight broker">
    <div class="wrap">
      <span class="eyebrow">Freight broker</span>
      <h1>What is a freight broker?</h1>
    </div>
  </section>
  <section class="page-body">
    <div class="wrap prose">
      <p>A freight broker shops carriers and manages the move so you get a clear rate and support after pickup. Parcel Management Group is a registered freight broker (USDOT 3266041 · MC 1030328) in Ventura, CA 93001. We help with small package, LTL, and full truckload. Call <a href="tel:+18059844114">(805) 984-4114</a>.</p>

      <h2>What a freight broker does</h2>
      <ul>
        <li>Compares carriers and service levels for your shipment.</li>
        <li>Books the load and shares a clear quote.</li>
        <li>Stays involved if something goes wrong after pickup.</li>
        <li>Helps you choose the right mode: small package, LTL, or full truckload.</li>
      </ul>

      <h2>Broker vs carrier</h2>
      <p>A carrier owns the trucks or planes. A broker finds the right carrier and manages the move. Full comparison: <a href="/freight-broker-vs-carrier/">/freight-broker-vs-carrier/</a>. A freight forwarder is a different role. See <a href="/what-is-a-freight-forwarder/">what is a freight forwarder</a>.</p>

      <h2>How quoting works with PMG</h2>
      <p>Tell us what you ship, where it goes, and when you need it. We compare carriers and send a clear quote. Details: <a href="/how-freight-quoting-works/">/how-freight-quoting-works/</a>.</p>

      <p>Call <a href="tel:+18059844114">(805) 984-4114</a> or <a href="/#contact">start a chat</a>.</p>

      <p class="related">
        <a href="/services/">Services</a>
        <span aria-hidden="true">·</span>
        <a href="/about/">About</a>
        <span aria-hidden="true">·</span>
        <a href="/blog/reduce-shipping-costs-high-volume/">Reduce shipping costs</a>
      </p>
    </div>
  </section>
  <section class="page-body" aria-label="Freight broker questions">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">FAQ</span>
        <h2>Freight brokers, in short.</h2>
      </div>
      <div class="faq faq-static">
        {faq.map((qa) => (
          <div class="qa">
            <h3>{qa.q}</h3>
            <div class="a">
              {qa.q.startsWith('What is the difference') ? (
                <p>
                  A carrier owns the trucks or planes. A broker finds the right carrier for your freight and manages the move. See <a href="/freight-broker-vs-carrier/">Freight broker vs carrier</a> for the full comparison.
                </p>
              ) : qa.q.startsWith('How do I get a quote') ? (
                <p>
                  Tell us what you ship, where it goes, and when you need it. We compare carriers and send a clear quote. See <a href="/how-freight-quoting-works/">How freight quoting works</a> or call (805) 984-4114.
                </p>
              ) : (
                <p>{qa.a}</p>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
