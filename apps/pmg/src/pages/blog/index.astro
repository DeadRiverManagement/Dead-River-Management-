---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const blogFaq = [
  {
    q: 'What topics does the Parcel Management Group Ship Tips blog cover?',
    html: 'Guides on cutting small-package, LTL, and full-truckload costs — including parcel audits, DIM weight, late-delivery refunds, carrier tracking (TForce Freight and Forward Air), prepay-and-add, and how to write a shipping address. Start at any guide below, or browse from the <a href="/blog/">blog index</a>.',
    text: 'Guides on cutting small-package, LTL, and full-truckload costs — including parcel audits, DIM weight, late-delivery refunds, carrier tracking (TForce Freight and Forward Air), prepay-and-add, and how to write a shipping address. Start at any guide on the blog index.',
  },
  {
    q: 'Who are these shipping guides for?',
    html: 'US businesses that ship with UPS, FedEx, LTL, or full truckload and want plain-English answers on rates, refunds, and mode choice. Parcel Management Group is a registered freight broker (USDOT 3266041 · MC 1030328) based in Ventura, CA 93001, serving shippers nationwide. Call (805) 984-4114.',
    text: 'US businesses that ship with UPS, FedEx, LTL, or full truckload and want plain-English answers on rates, refunds, and mode choice. Parcel Management Group is a registered freight broker (USDOT 3266041 · MC 1030328) based in Ventura, CA 93001, serving shippers nationwide. Call (805) 984-4114.',
  },
  {
    q: 'How do I get a freight or parcel quote after reading a guide?',
    html: 'Tell Parcel Management Group what you ship, where it goes, and when you need it. We compare carrier options and send a clear quote. For small packages, you can join the free Small Package Program — no fees and no contract. Call <a href="tel:+18059844114">(805) 984-4114</a> or start a chat.',
    text: 'Tell Parcel Management Group what you ship, where it goes, and when you need it. We compare carrier options and send a clear quote. For small packages, you can join the free Small Package Program — no fees and no contract. Call (805) 984-4114 or start a chat.',
  },
];

const seo = {
  title: 'Ship Tips & Shipping Cost Insights | Parcel Management Group',
  description: 'Practical guides on cutting small package, LTL and full truckload shipping costs, carrier rate changes, DIM weight, refund recovery and more from the PMG team.',
  schema: [
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: blogFaq.map((qa) => ({
        '@type': 'Question',
        name: qa.q,
        acceptedAnswer: { '@type': 'Answer', text: qa.text },
      })),
    },
  ],
};

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
---
<Base title={seo.title} description={seo.description} schema={seo.schema}>
  <section class="blog-index">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">Ship Tips</span>
        <h1>Shipping insights, <span class="gold-text">in plain English.</span></h1>
        <p class="lede">Straight answers on shipping costs, carrier changes and refunds, written by the team that negotiates them every day.</p>
      </div>

      {posts.length === 0 && <p class="lede">New articles are on the way. Check back soon.</p>}

      <div class="post-grid">
        {posts.map((post) => (
          <a class="post-card" href={`/blog/${post.id}/`}>
            {post.data.heroImage && (
              <img src={post.data.heroImage} alt={post.data.heroAlt ?? ''} loading="lazy" width="1536" height="1024" />
            )}
            <div class="post-card-body">
              <span class="mono post-meta">{post.data.category} · {fmt(post.data.pubDate)}</span>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
              <span class="post-more">Read the guide →</span>
            </div>
          </a>
        ))}
      </div>

      <section class="blog-index-faq" aria-label="Ship Tips questions">
        <div class="sec-head">
          <span class="eyebrow">FAQ</span>
          <h2>Ship Tips, in short.</h2>
        </div>
        <div class="faq">
          {blogFaq.map((qa) => (
            <div class="qa">
              <button aria-expanded="false">{qa.q}</button>
              <div class="a"><p set:html={qa.html} /></div>
            </div>
          ))}
        </div>
      </section>
    </div>
  </section>
</Base>
