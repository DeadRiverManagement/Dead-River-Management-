---
/**
 * LTL vs FTL. City-level NAP only. No street. No lead form.
 * Title, meta, H1, and FAQ copy are locked to the ship spec.
 */
import Base from '../layouts/Base.astro';
import site from '../data/site.json';

const siteURL = Astro.site?.toString() ?? `${site.canonicalOrigin}/`;
const pagePath = '/ltl-vs-ftl/';

const title = 'LTL vs FTL Shipping | Parcel Management Group';
const description =
  'LTL shares a truck; FTL uses a full trailer. Pick the mode that fits your freight size and timeline. PMG is a registered broker in Ventura, CA. Call (805) 984-4114.';

const faq = [
  {
    q: 'What is the difference between LTL and FTL shipping?',
    a: 'LTL (less-than-truckload) shares a truck with other shippers and you pay for the space you use. FTL (full truckload) uses a dedicated trailer for your freight. Choose based on freight size, volume, and timing.',
  },
  {
    q: 'When should I use LTL instead of FTL?',
    a: 'Use LTL for pallet freight that does not need a full trailer. Use FTL when you need dedicated capacity, have enough volume to fill a trailer, or need freight that should not share space. Parcel Management Group helps you pick the right mode.',
  },
  {
    q: 'Does Parcel Management Group handle both LTL and FTL?',
    a: 'Yes. PMG is a registered freight broker (USDOT 3266041 · MC 1030328) based in Ventura, CA 93001. We compare carriers for LTL and full truckload and support you after pickup. Call (805) 984-4114.',
  },
  {
    q: 'How do I get an LTL or FTL quote from PMG?',
    a: 'Tell us what you ship, where it goes, and when you need it. We compare carriers and send a clear quote. See How freight quoting works or call (805) 984-4114.',
  },
];

const seo = {
  title,
  description,
  schema: [
    {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: 'LTL vs FTL: which shipping mode fits?',
      url: `${siteURL}ltl-vs-ftl/`,
      description,
      mainEntity: { '@id': `${siteURL}#organization` },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((qa) => ({
        '@type': 'Question',
        name: qa.q,
        acceptedAnswer: { '@type': 'Answer', text: qa.a },
      })),
    },
  ],
};
---
<Base title={seo.title} description={seo.description} canonical={pagePath} schema={seo.schema}>
  <section class="page-hero" aria-label="LTL vs FTL">
    <div class="wrap">
      <span class="eyebrow">LTL vs FTL</span>
      <h1>LTL vs FTL: which shipping mode fits?</h1>
    </div>
  </section>
  <section class="page-body">
    <div class="wrap prose">
      <p>LTL (less-than-truckload) shares truck space with other shippers. FTL (full truckload) uses a dedicated trailer for your freight. Parcel Management Group is a registered freight broker (USDOT 3266041 · MC 1030328) in Ventura, CA 93001. We help you pick the right mode and get a clear quote. Call <a href="tel:+18059844114">(805) 984-4114</a>.</p>

      <h2>What LTL means</h2>
      <ul>
        <li>Pallet freight that is too big for small package but does not need a full trailer.</li>
        <li>You share space and pay for the space and service you use.</li>
        <li>Good when volume or timing does not fill a trailer.</li>
        <li>More detail: <a href="/what-is-ltl-shipping/">/what-is-ltl-shipping/</a>.</li>
      </ul>

      <h2>What FTL means</h2>
      <ul>
        <li>Your freight fills (or needs) a full trailer.</li>
        <li>Dedicated capacity from pickup to delivery.</li>
        <li>Useful for large volume, tight timing, or freight that should not share space.</li>
        <li>PMG books full truckload when that mode fits.</li>
      </ul>

      <h2>How to choose</h2>
      <p>Use small package for boxes usually under 150 lbs. Use LTL for pallet freight that does not need a full truck. Use FTL when you need a dedicated trailer. PMG helps you choose. Services: <a href="/services/">/services/</a>.</p>

      <h2>How quoting works with PMG</h2>
      <p>Tell us what you ship, where it goes, and when you need it. We compare carriers and send a clear quote. Details: <a href="/how-freight-quoting-works/">/how-freight-quoting-works/</a>.</p>

      <p>Call <a href="tel:+18059844114">(805) 984-4114</a> or start a chat at <a href="/#contact">/#contact</a>.</p>

      <p class="related">
        <a href="/what-is-a-freight-broker/">What is a freight broker</a>
        <span aria-hidden="true">·</span>
        <a href="/freight-broker-vs-carrier/">Broker vs carrier</a>
        <span aria-hidden="true">·</span>
        <a href="/about/">About</a>
        <span aria-hidden="true">·</span>
        <a href="/blog/reduce-shipping-costs-high-volume/">Reduce shipping costs</a>
      </p>
    </div>
  </section>
  <section class="page-body" aria-label="LTL vs FTL questions">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">FAQ</span>
        <h2>LTL vs FTL, in short.</h2>
      </div>
      <div class="faq faq-static">
        {faq.map((qa) => (
          <div class="qa">
            <h3>{qa.q}</h3>
            <div class="a">
              {qa.q.startsWith('How do I get an LTL or FTL quote') ? (
                <p>
                  Tell us what you ship, where it goes, and when you need it. We compare carriers and send a clear quote. See <a href="/how-freight-quoting-works/">How freight quoting works</a> or call (805) 984-4114.
                </p>
              ) : (
                <p>{qa.a}</p>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
