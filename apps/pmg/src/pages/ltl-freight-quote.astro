---
/**
 * LTL freight quote. City-level NAP only. No street. No lead form.
 * Title, meta, H1, and FAQ copy are locked to the ship spec.
 */
import Base from '../layouts/Base.astro';
import site from '../data/site.json';

const siteURL = Astro.site?.toString() ?? `${site.canonicalOrigin}/`;
const pagePath = '/ltl-freight-quote/';

const title = 'LTL Freight Quote | Parcel Management Group';
const description =
  'Need an LTL freight quote? Share freight details with PMG. We compare carriers and send a clear rate. Registered broker in Ventura, CA 93001. Call (805) 984-4114.';

const faq = [
  {
    q: 'How do I get an LTL freight quote from Parcel Management Group?',
    a: 'Tell us what you ship, where it goes, and when you need it. We compare carriers and send a clear LTL rate. Call (805) 984-4114 or start a chat on parcelmanagementgroup.com.',
  },
  {
    q: 'What details do you need for an accurate LTL quote?',
    a: 'Share origin and destination, freight description, weight, pallet or piece count, dimensions if available, ready date, and any accessorial needs such as liftgate or appointment. More detail usually means a clearer rate.',
  },
  {
    q: 'Is Parcel Management Group a carrier or a broker?',
    a: 'PMG is a registered freight broker (USDOT 3266041 · MC 1030328) based in Ventura, CA 93001. We find and manage carriers for your LTL freight. We do not own the trucks.',
  },
  {
    q: 'When should I request LTL instead of full truckload?',
    a: 'Request LTL when your pallet freight does not need a full trailer. Request FTL when you need dedicated capacity. PMG helps you choose and quote the right mode. See LTL vs FTL or call (805) 984-4114.',
  },
];

const seo = {
  title,
  description,
  schema: [
    {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: 'Get an LTL freight quote',
      url: `${siteURL}ltl-freight-quote/`,
      description,
      mainEntity: { '@id': `${siteURL}#organization` },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((qa) => ({
        '@type': 'Question',
        name: qa.q,
        acceptedAnswer: { '@type': 'Answer', text: qa.a },
      })),
    },
  ],
};
---
<Base title={seo.title} description={seo.description} canonical={pagePath} schema={seo.schema}>
  <section class="page-hero" aria-label="LTL freight quote">
    <div class="wrap">
      <span class="eyebrow">LTL freight quote</span>
      <h1>Get an LTL freight quote</h1>
    </div>
  </section>
  <section class="page-body">
    <div class="wrap prose">
      <p>Need an LTL freight quote? Tell Parcel Management Group what you ship, where it goes, and when you need it. We compare carriers and send a clear rate. PMG is a registered freight broker (USDOT 3266041 · MC 1030328) in Ventura, CA 93001. Call <a href="tel:+18059844114">(805) 984-4114</a>.</p>

      <h2>What you get with an LTL quote from PMG</h2>
      <ul>
        <li>A clear rate for less-than-truckload freight that shares truck space.</li>
        <li>Carrier options compared for your freight size, lanes, and timing.</li>
        <li>Support after pickup from a registered broker, not a carrier.</li>
        <li>More on LTL: <a href="/what-is-ltl-shipping/">/what-is-ltl-shipping/</a>.</li>
      </ul>

      <h2>What to share for a faster quote</h2>
      <ul>
        <li>Origin and destination (city/state or ZIP).</li>
        <li>Freight description, weight, pallet or piece count, and dimensions if you have them.</li>
        <li>Ready date and any accessorial needs (liftgate, appointment, residential).</li>
        <li>How quoting works: <a href="/how-freight-quoting-works/">/how-freight-quoting-works/</a>.</li>
      </ul>

      <h2>LTL vs full truckload (short)</h2>
      <p>Use LTL when pallet freight does not need a full trailer. Use FTL when you need a dedicated trailer. Side-by-side: <a href="/ltl-vs-ftl/">/ltl-vs-ftl/</a>. PMG books both modes when they fit.</p>

      <h2>Broker, not carrier</h2>
      <p>A freight broker finds and manages carriers for your freight. A carrier owns the trucks. PMG is the broker. Details: <a href="/what-is-a-freight-broker/">/what-is-a-freight-broker/</a> and <a href="/freight-broker-vs-carrier/">/freight-broker-vs-carrier/</a>.</p>

      <p>Call <a href="tel:+18059844114">(805) 984-4114</a> or start a chat at <a href="/#contact">/#contact</a>.</p>

      <p class="related">
        <a href="/services/">Services</a>
        <span aria-hidden="true">·</span>
        <a href="/about/">About</a>
        <span aria-hidden="true">·</span>
        <a href="/blog/reduce-shipping-costs-high-volume/">Reduce shipping costs</a>
      </p>
    </div>
  </section>
  <section class="page-body" aria-label="LTL freight quote questions">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">FAQ</span>
        <h2>LTL freight quote FAQ</h2>
      </div>
      <div class="faq faq-static">
        {faq.map((qa) => (
          <div class="qa">
            <h3>{qa.q}</h3>
            <div class="a">
              {qa.q.startsWith('When should I request LTL') ? (
                <p>
                  Request LTL when your pallet freight does not need a full trailer. Request FTL when you need dedicated capacity. PMG helps you choose and quote the right mode. See <a href="/ltl-vs-ftl/">LTL vs FTL</a> or call (805) 984-4114.
                </p>
              ) : (
                <p>{qa.a}</p>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
