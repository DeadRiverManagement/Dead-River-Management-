---
/**
 * What is a freight forwarder. City-level NAP only. No street. No lead form.
 * Title, meta, H1, and FAQ copy match the live pmg-site guide.
 */
import Base from '../layouts/Base.astro';
import site from '../data/site.json';

const siteURL = Astro.site?.toString() ?? `${site.canonicalOrigin}/`;
const pagePath = '/what-is-a-freight-forwarder/';

const title = 'What Is a Freight Forwarder? | Parcel Management Group';
const description =
  'A freight forwarder arranges moves and paperwork for shippers. See how forwarding differs from a broker. Ventura, CA 93001. Call (805) 984-4114.';

const faq = [
  {
    q: 'What is a freight forwarder?',
    a: 'A freight forwarder arranges the move and the paperwork for a shipment, often across more than one mode or border. Parcel Management Group is a registered broker in Ventura, CA 93001. Call (805) 984-4114.',
  },
  {
    q: 'How is a freight forwarder different from a freight broker?',
    a: 'A freight broker finds and manages motor carriers for truck freight. A freight forwarder often plans multi-leg or international moves and documents. PMG is a registered freight broker.',
  },
  {
    q: 'Do I need a freight forwarder for domestic LTL?',
    a: 'Many domestic LTL and full truckload moves work with a freight broker. Share freight details with PMG for a clear rate. Call (805) 984-4114.',
  },
  {
    q: 'What documents does a freight forwarder handle?',
    a: 'Forwarders often help with bills of lading and, on international moves, customs paperwork. Keep the paperwork aligned with the quote and the pickup.',
  },
];

const seo = {
  title,
  description,
  schema: [
    {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: 'What is a freight forwarder?',
      url: `${siteURL}what-is-a-freight-forwarder/`,
      description,
      mainEntity: { '@id': `${siteURL}#organization` },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((qa) => ({
        '@type': 'Question',
        name: qa.q,
        acceptedAnswer: { '@type': 'Answer', text: qa.a },
      })),
    },
  ],
};
---
<Base title={seo.title} description={seo.description} canonical={pagePath} schema={seo.schema}>
  <section class="page-hero" aria-label="What is a freight forwarder">
    <div class="wrap">
      <span class="eyebrow">Freight forwarder</span>
      <h1>What is a freight forwarder?</h1>
    </div>
  </section>
  <section class="page-body">
    <div class="wrap prose">
      <p>A freight forwarder arranges the move and the paperwork for a shipment. Forwarders often handle international or multi-leg freight and may book ocean, air, or inland legs. Parcel Management Group is a registered freight broker (USDOT 3266041 · MC 1030328) in Ventura, CA 93001. Call <a href="tel:+18059844114">(805) 984-4114</a>.</p>

      <h2>What a freight forwarder does</h2>
      <ul>
        <li>Plans the shipment and the documents that travel with it.</li>
        <li>Often books more than one leg, such as ocean, air, or inland trucking.</li>
        <li>Helps line up bills of lading and, on international moves, customs paperwork.</li>
        <li>Document basics: <a href="/what-is-a-bill-of-lading/">what is a bill of lading</a>.</li>
      </ul>

      <h2>Freight forwarder vs freight broker</h2>
      <p>A freight broker finds and manages motor carriers for truck freight. A freight forwarder often plans multi-leg or international moves and documents. Parcel Management Group is a registered freight broker. We are not a freight forwarder. Broker role: <a href="/what-is-a-freight-broker/">what is a freight broker</a>. Carrier comparison: <a href="/freight-broker-vs-carrier/">freight broker vs carrier</a>.</p>

      <h2>When shippers call a broker instead</h2>
      <p>Many domestic LTL and full truckload moves work with a freight broker. Share origin, destination, weight, and timing for a clear rate. Mode guides: <a href="/what-is-ftl/">what is FTL</a>, <a href="/ltl-vs-ftl/">LTL vs FTL</a>, and <a href="/what-is-ltl-shipping/">what is LTL shipping</a>. Get a rate: <a href="/ltl-freight-quote/">LTL freight quote</a>. How a quote is built: <a href="/how-freight-quoting-works/">how freight quoting works</a>.</p>

      <p>Call <a href="tel:+18059844114">(805) 984-4114</a> or <a href="/#contact">start a chat</a>.</p>

      <p class="related">
        <a href="/services/">Services</a>
        <span aria-hidden="true">·</span>
        <a href="/about/">About</a>
        <span aria-hidden="true">·</span>
        <a href="/what-is-a-freight-broker/">What is a freight broker</a>
      </p>
    </div>
  </section>
  <section class="page-body" aria-label="Freight forwarder questions">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow">FAQ</span>
        <h2>Freight forwarder FAQ</h2>
      </div>
      <div class="faq faq-static">
        {faq.map((qa) => (
          <div class="qa">
            <h3>{qa.q}</h3>
            <div class="a"><p>{qa.a}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
