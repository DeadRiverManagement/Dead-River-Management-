{
  "cleanUrls": true,
  "bulkRedirectsPath": "redirects/html-one-hop.json",
  "trailingSlash": false,
  "framework": "astro",
  "crons": [
    {
      "path": "/api/instantly-reconcile",
      "schedule": "*/5 * * * *"
    }
  ],
