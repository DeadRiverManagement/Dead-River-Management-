---
import { business, gbpSameAs, nav, socials, TEAM_SUPPORT_LINE } from '../data/site';
import BrandLogo from './BrandLogo.astro';
import PreferredSource from './PreferredSource.astro';
import { socialIcons } from '../data/social-icons';
const year = new Date().getFullYear();

const icons = socialIcons;
---
<footer>
  <div class="wrap">
    <div class="foot">
      <div class="about">
        <a class="brand" href="/"><BrandLogo /></a>
        <p>{business.footerBlurb}</p>
        <PreferredSource theme="dark" />
        <p>Not Dead River Company (fuel).</p>
        <p>
          {business.city} and the borderland<br />
          {TEAM_SUPPORT_LINE}<br />
          <a href={`tel:${business.phoneE164}`}>{business.phone}</a><br />
          <a href={`mailto:${business.email}`}>{business.email}</a><br />
          <a href={gbpSameAs[0]} rel="me noopener" target="_blank">Google Business Profile</a>
        </p>
        <ul class="social" aria-label={`${business.name} on social media`}>
          {socials.map((s) => (
            <li>
              <a href={s.href} rel="me noopener" target="_blank" aria-label={s.label} title={s.label}>
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" focusable="false">
                  <path d={icons[s.icon]} />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h2>Plans</h2>
        <ul>{nav.plans.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </div>
      <div>
        <h2>Services</h2>
        <ul>{nav.services.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </div>
      <div>
        <h2>Company</h2>
        <ul>{nav.company.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </div>
    </div>
    <div class="foot-bot">
      <span>© {year} {business.name}. All rights reserved.</span>
      <span>{business.tagline}</span>
    </div>
  </div>
</footer>
