---
// Preview only: King Kong's header. Phone on the left, logo centred, "menu"
// and a hamburger on the right, and a full-screen stacked menu when opened.
import Logo from './growth/Logo.astro';
import { brand } from '../data/growth';
const items = [
  ['Agency', '/kk/agency'],
  ['Software', '/kk/software'],
  ['Local SEO', '/kk/local-seo'],
  ['AEO', '/kk/aeo'],
  ['Google ads', '/kk/google-ads'],
  ['Local Services Ads', '/kk/local-services-ads'],
  ['Landing pages', '/kk/landing-pages'],
  ['Facebook ads', '/kk/facebook-ads'],
  ['Cold email', '/kk/cold-email'],
  ['Results', '/kk/results'],
  ['Marketing advice', '/kk/marketing-advice'],
  ['About us', '/kk/about-us'],
  ['The book', '/downloads/marketing-is-fcking-easy.pdf'],
];
---

<div class="kkh-root" data-kkh>
<header class="kkh">
  <a class="kkh-phone" href={brand.phoneHref} aria-label="Call us">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1L6.6 10.8z"/></svg>
    <em>{brand.phone}</em>
  </a>
  <a class="kkh-logo" href="/kk" aria-label="Dead River Management home"><Logo /></a>
  <button class="kkh-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="kkh-menu" data-kkh-toggle>
    <span class="kkh-word">menu</span>
    <span class="kkh-box"><i></i><i></i><i></i></span>
  </button>
</header>
  <nav class="kkh-menu" id="kkh-menu" aria-label="Menu">
    <ul>{items.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul>
    <div class="kkh-ready">
      <p>Ready to take action?</p>
      <a class="button" href="/kk/strategy-session">Get Started</a>
    </div>
  </nav>
</div>

<script>
  const h = document.querySelector('[data-kkh]');
  const t = h?.querySelector('[data-kkh-toggle]');
  if (h && t) {
    const set = (open) => { h.classList.toggle('is-open', open); t.setAttribute('aria-expanded', String(open)); document.documentElement.classList.toggle('kkh-lock', open); };
    t.addEventListener('click', () => set(!h.classList.contains('is-open')));
    h.querySelectorAll('.kkh-menu a').forEach((a) => a.addEventListener('click', () => set(false)));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
  }
  // Scroll reveals, count-ups and the globe. All opt-in by attribute so pages without them pay nothing.
  const motionOk = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;
  const revealTargets = document.querySelectorAll('.kk-band .wrap > h2, .kk-band .wrap > h3, .kk-band .wrap > .kk-kicker, .kk-stats > div, .kk-tile, .kk-t, .kk-feature-t, .kk-book-grid > *, .kk-offer-grid > *, .kk-grid-6 > *, .kk-gallery > *, .kk-article');
  if (motionOk && 'IntersectionObserver' in window) {
    revealTargets.forEach((el, i) => { el.classList.add('kk-rv'); el.style.setProperty('--rd', ((i % 4) * 90) + 'ms'); });
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('kk-in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px' });
    revealTargets.forEach((el) => io.observe(el));
    const counts = document.querySelectorAll('[data-count]');
    const co = new IntersectionObserver((es) => es.forEach((e) => { if (!e.isIntersecting) return; co.unobserve(e.target); const el = e.target, end = +el.dataset.count, pre = el.dataset.prefix || '', suf = el.dataset.suffix || '', t0 = performance.now(); const step = (now) => { const p = Math.min(1, (now - t0) / 1400), v = Math.round(end * (1 - Math.pow(1 - p, 3))); el.textContent = pre + v + suf; if (p < 1) requestAnimationFrame(step); }; requestAnimationFrame(step); }), { threshold: 0.6 });
    counts.forEach((el) => co.observe(el));
  }
  document.querySelectorAll('[data-tilt]').forEach((box) => { const img = box.firstElementChild; box.addEventListener('pointermove', (e) => { const r = box.getBoundingClientRect(); img.style.setProperty('--ry', ((e.clientX - r.left) / r.width - 0.5) * 22 + 'deg'); img.style.setProperty('--rx', (0.5 - (e.clientY - r.top) / r.height) * 16 + 'deg'); }); box.addEventListener('pointerleave', () => { img.style.removeProperty('--ry'); img.style.removeProperty('--rx'); }); });
  const globe = document.querySelector('[data-kk-globe]');
  if (globe && motionOk) import('../scripts/kk-globe.js').then((m) => m.mountGlobe(globe));
  // The hero video starts tilted and smaller, then widens to nearly full screen as you scroll,
  // finishing when its top reaches the upper fifth of the window. Like King Kong's hero.
  const v = document.querySelector('.kk-hero .kk-video');
  if (v) {
    if (!window.matchMedia('(prefers-reduced-motion: no-preference)').matches) v.classList.add('kk-grown');
    else {
      let raf = 0;
      const tick = () => { raf = 0; v.style.setProperty('--p', '0'); const top = v.getBoundingClientRect().top + scrollY; const end = Math.max(120, top - innerHeight * 0.2); const p = Math.min(1, Math.max(0, scrollY / end)); v.style.setProperty('--p', (1 - Math.pow(1 - p, 2)).toFixed(4)); };
      const onScroll = () => { if (!raf) raf = requestAnimationFrame(tick); };
      addEventListener('scroll', onScroll, { passive: true }); addEventListener('resize', onScroll); tick();
    }
  }
</script>

<style is:global>
  .kkh { position: fixed; inset: 0 0 auto 0; z-index: 121; height: 64px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 22px; background: rgba(10, 10, 11, 0.9); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-bottom: 1px solid rgba(255, 255, 255, 0.06); color: var(--ink); }
  .kkh-phone { display: inline-flex; align-items: center; gap: 9px; justify-self: start; color: var(--ink); text-decoration: none; font-size: 15px; }
  .kkh-phone svg { color: var(--copper); }
  .kkh-phone em { font-style: normal; }
  .kkh-logo { justify-self: center; display: block; line-height: 0; }
  .kkh-logo svg, .kkh-logo img { height: 34px; width: auto; }
  .kkh-toggle { justify-self: end; display: inline-flex; align-items: center; gap: 12px; background: none; border: 0; color: var(--ink); cursor: pointer; padding: 8px 0; font: inherit; font-size: 15px; }
  .kkh-box { position: relative; width: 28px; height: 18px; display: block; }
  .kkh-box i { position: absolute; left: 0; width: 28px; height: 2.5px; background: #fff; border-radius: 2px; transition: transform 0.25s ease, opacity 0.2s ease, top 0.25s ease; }
  .kkh-box i:nth-child(1) { top: 0; } .kkh-box i:nth-child(2) { top: 7.5px; } .kkh-box i:nth-child(3) { top: 15px; }
  .kkh-root.is-open .kkh-box i:nth-child(1) { top: 7.5px; transform: rotate(45deg); }
  .kkh-root.is-open .kkh-box i:nth-child(2) { opacity: 0; }
  .kkh-root.is-open .kkh-box i:nth-child(3) { top: 7.5px; transform: rotate(-45deg); }
  .kkh-menu { position: fixed; inset: 64px 0 0 0; z-index: 120; display: none; flex-direction: column; align-items: center; justify-content: safe center; gap: 18px; padding: 16px 20px 28px; background: rgba(10, 10, 11, 0.92); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); overflow-y: auto; }
  .kkh-root.is-open .kkh-menu { display: flex; }
  .kkh-menu ul { list-style: none; margin: 0; padding: 0; text-align: center; }
  .kkh-menu li a { display: block; font-family: var(--display); font-weight: 800; font-size: clamp(28px, 3.6vw, 42px); line-height: 1.1; letter-spacing: -0.03em; text-transform: uppercase; color: #fff; text-decoration: none; transition: color 0.15s ease; }
  .kkh-menu li a:hover { color: var(--ember); }
  .kkh-ready { text-align: center; }
  .kkh-ready p { margin: 0 0 12px; color: var(--muted); font-size: 15px; }
  html.kkh-lock { overflow: hidden; }
  .kk .kk-hero { padding-top: calc(clamp(56px, 8vw, 110px) + 64px); }
  .kkf-page, .kk-lightpage { padding-top: 64px; }
  .kkh-logo img { filter: brightness(0) invert(1); }
  @media (max-width: 720px) {
    .kkh { padding: 0 14px; height: 58px; }
    .kkh-phone em, .kkh-word { display: none; }
    .kkh-phone { width: 36px; height: 36px; border-radius: 50%; border: 1.5px solid var(--copper); justify-content: center; }
    .kkh-logo svg, .kkh-logo img { height: 28px; }
    .kkh-menu { inset: 58px 0 0 0; gap: 16px; }
    .kkh-menu li a { font-size: clamp(24px, 6.6vw, 30px); }
      .kk .kk-hero { padding-top: calc(clamp(56px, 8vw, 110px) + 58px); }
    .kkf-page, .kk-lightpage { padding-top: 58px; }
  }
</style>
