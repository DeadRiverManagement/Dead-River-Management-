---
// Page hero. Pass scene="liquid" or scene="signals" for a live WebGL header.
import HeroScene from './HeroScene.astro';
const { eyebrow, title, intro, scene } = Astro.props;
---

<section class:list={['page-hero', 'wrap', { 'has-scene': !!scene }]}>
  {scene && <HeroScene variant={scene} />}
  <div class="page-hero-copy">
    <p class="eyebrow" data-rise>{eyebrow}</p>
    <h1 data-split>{title}</h1>
    <p class="intro" data-rise>{intro}</p>
    <slot />
  </div>
</section>
