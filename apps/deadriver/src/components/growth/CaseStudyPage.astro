---
import Growth from '../../layouts/Growth.astro';
import Arrow from './Arrow.astro';
import type { CaseStudyPage } from '../../data/case-study-pages';
const { c, logo } = Astro.props as {
  c: CaseStudyPage;
  logo?: { src: string; width: number; height: number };
};
const name = c.company;
---

<Growth title={c.seoTitle} description={c.description}>
  <section class="page-hero wrap">
    <p class="eyebrow">{c.eyebrow}</p>
    <h1>{c.headline}</h1>
    {c.intro.map((p) => <p class="intro">{p}</p>)}
    <div class="cs-hero-row">
      {logo && <img class="cs-logo" src={logo.src} width={logo.width} height={logo.height} alt={name + ' logo'} />}
      <ul class="cs-stats">
        {c.stats.map((s) => <li>{s}</li>)}
      </ul>
    </div>
    <a href="/work" class="back-link">← All case studies</a>
  </section>


  <section class="section soft">
    <div class="wrap split cs-body">
      <div class="cs-main">
        <p class="eyebrow">The problem</p>
        <h2>{c.problem.heading}</h2>
        {c.problem.paragraphs.map((p) => <p>{p}</p>)}
        {c.problem.listLead && <h3>{c.problem.listLead}</h3>}
        <ul class="cs-x">
          {c.problem.list.map((x) => <li>{x}</li>)}
        </ul>
        {c.problem.after && <p class="cs-lead">{c.problem.after}</p>}
      </div>
      <aside class="case-graphic cs-glance">
        <p class="eyebrow">The result at a glance</p>
        <h2 class="case-graphic-title">{name}</h2>
        <dl class="cs-facts">
          {c.glance.facts.map(([k, v]) => (
            <div><dt>{k}</dt><dd>{v}</dd></div>
          ))}
        </dl>
        <h3>What we did:</h3>
        <ul class="check-list">{c.glance.did.map((d) => <li>{d}</li>)}</ul>
        <h3>Key metrics:</h3>
        <ul class="check-list">{c.glance.metrics.map((m) => <li>{m}</li>)}</ul>
      </aside>
    </div>
  </section>

  <section class="section wrap">
    <p class="eyebrow">The solution</p>
    <h2>{c.solution.heading}</h2>
    <p class="intro">{c.solution.intro}</p>
    <ol class="cs-goals">{c.solution.goals.map((g) => <li>{g}</li>)}</ol>
    <ol class="cs-timeline" aria-label="Timeline" style={`--n:${c.solution.phases.length}`}>
      {c.solution.phases.map((ph) => {
        const [when, what] = ph.title.split(': ');
        return (
          <li>
            <span>{when}</span>
            <strong>{what}</strong>
          </li>
        );
      })}
    </ol>
    <p class="cs-lead">{c.solution.lead}</p>
    <div class:list={["cs-phases", { "cs-phases-3": c.solution.phases.length === 3 }]}>
      {c.solution.phases.map((ph) => (
        <article class="feature-panel">
          <h3>{ph.title}</h3>
          <ul class="check-list">{ph.items.map((i) => <li>{i}</li>)}</ul>
        </article>
      ))}
    </div>
  </section>

  <section class="section soft">
    <div class="wrap">
      <p class="eyebrow">The result</p>
      <h2>{c.result.heading}</h2>
      {c.result.paragraphs.map((p) => <p class="intro">{p}</p>)}
      <h3 class="cs-sub">{c.result.metricsLead}</h3>
      <ul class="cs-metrics">{c.result.metrics.map((m) => <li>{m}</li>)}</ul>
      {c.beforeAfter && (
        <>
          <h3 class="cs-sub">Before vs. after</h3>
          <div class="table-scroll cs-ba-wrap">
            <table class="cs-ba">
              <thead>
                <tr><th scope="col"><span class="sr-only">Metric</span></th><th scope="col">Before</th><th scope="col">After</th></tr>
              </thead>
              <tbody>
                {c.beforeAfter.map(([m, b, a]) => (
                  <tr><th scope="row">{m}</th><td>{b}</td><td>{a}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      )}
      {c.cost && (
        <>
          <h3 class="cs-sub">What this cost</h3>
          <div class="cs-cost">
            {c.cost.map((x) => (
              <article>
                <p class="mini-label">{x.label}</p>
                <strong>{x.value}</strong>
                <p>{x.note}</p>
              </article>
            ))}
          </div>
        </>
      )}
      {c.result.after && <p class="cs-lead">{c.result.after}</p>}
      <blockquote class="cs-quote">
        <p>“{c.result.quote}”</p>
        <cite>{c.result.cite}</cite>
      </blockquote>
      {c.industry && <a class="text-link" href={c.industry.href}>{c.industry.label} <Arrow /></a>}
    </div>
  </section>

  <section class="section wrap">
    <div class="cs-apply">
      <p class="eyebrow">How this applies to your business</p>
      <h2>{c.apply.heading}</h2>
      {c.apply.paragraphs.map((p) => <p>{p}</p>)}
      <ul class="check-list">{c.apply.list.map((x) => <li>{x}</li>)}</ul>
      {c.notFor && (
        <>
          <h3 class="cs-not-h">This system is NOT a good fit if:</h3>
          <ul class="cs-x">{c.notFor.map((x) => <li>{x}</li>)}</ul>
        </>
      )}
      <p class="cs-lead">{c.apply.cta}</p>
      <p class="cs-scarcity">{c.apply.scarcity}</p>
      <a class="button" href="/book">{c.apply.button} <Arrow /></a>
    </div>
  </section>
</Growth>

<style>
  .page-hero .intro + .intro { margin-top: 14px; }
  .cs-hero-row { display: flex; flex-wrap: wrap; align-items: center; gap: 24px 40px; margin: 32px 0 28px; }
  .cs-logo { width: 120px; height: 96px; object-fit: contain; }
  .cs-stats { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 12px; }
  .cs-stats li { background: var(--sage); border: 1px solid var(--line); border-radius: 999px; padding: 10px 18px; font-weight: 600; color: var(--ink); font-size: 16px; }
  .cs-body { align-items: start; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); }
  .cs-body > * { min-width: 0; }
  .cs-main h3, .cs-glance h3 { font-size: 20px; margin: 24px 0 8px; }
  .cs-x { list-style: none; padding: 0; }
  .cs-x li { padding: 8px 0 8px 26px; position: relative; font-size: 16px; }
  .cs-x li:before { content: '✗'; position: absolute; left: 0; color: var(--copper); }
  .cs-lead { font-size: 18px; font-weight: 500; color: var(--ink); max-width: 820px; margin: 20px 0; }
  .cs-glance { min-height: 0; background: #fff; border: 1px solid var(--line); }
  .cs-facts { display: grid; gap: 10px; margin: 0; }
  .cs-facts div { display: grid; grid-template-columns: 112px 1fr; gap: 10px; }
  .cs-facts dt { font-weight: 600; color: var(--ink); }
  .cs-facts dd { margin: 0; }
  .cs-goals { font-size: 18px; color: var(--ink); padding-left: 22px; }
  .cs-goals li { margin: 6px 0; }
  .cs-phases { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin-top: 12px; }
  .cs-phases-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .cs-phases h3 { font-size: 21px; margin-bottom: 8px; }
  .cs-sub { margin: 26px 0 12px; font-size: 22px; }
  .cs-metrics { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; list-style: none; padding: 0; }
  .cs-metrics li { background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 16px 18px; font-weight: 500; color: var(--ink); }
  .cs-quote { margin: 32px 0 0; padding: 28px 32px; background: var(--green); border-radius: 12px; }
  .cs-quote p { font-family: var(--display); font-size: clamp(20px, 2.2vw, 26px); line-height: 1.35; color: #fff; margin: 0 0 12px; }
  .cs-quote cite { font-style: normal; color: #d9e9bc; }
  .cs-apply { max-width: 860px; }
  .cs-not-h { font-size: 20px; margin: 26px 0 6px; }
  .cs-timeline { list-style: none; padding: 0; margin: 26px 0 8px; display: grid; grid-template-columns: repeat(var(--n, 4), minmax(0, 1fr)); position: relative; }
  .cs-timeline:before { content: ''; position: absolute; left: 0; right: 0; top: 9px; height: 2px; background: var(--line); }
  .cs-timeline li { position: relative; padding: 30px 14px 0 0; }
  .cs-timeline li:before { content: ''; position: absolute; top: 2px; left: 0; width: 16px; height: 16px; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 4px var(--paper, #fbfaf6); }
  .cs-timeline span { display: block; font-size: 13px; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  .cs-timeline strong { display: block; font-size: 18px; color: var(--ink); margin-top: 4px; }
  .cs-ba-wrap { margin: 0 0 8px; overflow-x: auto; background: #fff; border-radius: 10px; border: 1px solid var(--line); }
  .cs-ba { width: 100%; border-collapse: collapse; font-size: 16px; }
  .cs-ba th, .cs-ba td { padding: 14px 18px; border-bottom: 1px solid var(--line); text-align: left; }
  .cs-ba thead th { color: var(--green); font-size: 15px; }
  .cs-ba tbody th { font-weight: 500; color: var(--ink); }
  .cs-ba td:last-child { color: var(--green); font-weight: 600; }
  .cs-ba tr:last-child > * { border-bottom: 0; }
  .cs-cost { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .cs-cost article { background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 18px 20px; }
  .cs-cost strong { display: block; font-family: var(--display); font-size: 32px; letter-spacing: -.03em; color: var(--green); margin: 6px 0; }
  .cs-cost p:last-child { margin: 0; font-size: 14px; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .cs-scarcity { font-weight: 600; color: var(--copper); margin: 0 0 22px; }
  @media (max-width: 900px) {
    .cs-body, .cs-phases, .cs-metrics, .cs-cost { grid-template-columns: 1fr; }
    .cs-timeline { grid-template-columns: 1fr; gap: 14px; }
    .cs-timeline:before { left: 7px; right: auto; top: 0; bottom: 0; width: 2px; height: auto; }
    .cs-timeline li { padding: 0 0 0 30px; }
  }
</style>
