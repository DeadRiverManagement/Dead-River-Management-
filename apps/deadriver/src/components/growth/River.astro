---
// The DemandFlow current. src/scripts/river-scene.js renders the 3D river
// into .river-scene and pins each label to a point on the water.
---

<div
  class="river-visual"
  role="img"
  aria-label="DemandFlow: create demand, capture demand, convert demand"
>
  <div class="river-scene" data-river></div>
  <div class="river-top">
    <span class="mini-label">DemandFlow</span>
    <span class="small-dot"></span>
  </div>
  <div class="river-stages">
    <div class="river-label label-zero">
      <span>1</span>
      <strong>Target Demand</strong>
      <small>Recent buying signals, not guesses</small>
    </div>
    <div class="river-label label-one">
      <span>2</span>
      <strong>Create Demand</strong>
      <small>The right buyers, the right channels</small>
    </div>
    <div class="river-label label-two">
      <span>3</span>
      <strong>Capture Demand</strong>
      <small>Every inquiry caught, fast</small>
    </div>
    <div class="river-label label-three">
      <span>4</span>
      <strong>Convert Demand</strong>
      <small>Booked, paying customers</small>
    </div>
  </div>
  <div class="river-bottom">
    <span>Strategy and measurement connect every stage.</span>
    <span aria-hidden="true">↗</span>
  </div>
</div>
<script>
  import { mountRiver } from '../../scripts/river-scene.js';
  const host = document.querySelector('[data-river]');
  if (host) mountRiver(host);
</script>
