---
import Arrow from './Arrow.astro';
import { CTA_HREF, CTA_LABEL } from '../../data/advice-wave-b';
const { headline, body } = Astro.props;
---

{headline ? (
  <section class="section wrap closing">
    <div>
      <h2>{headline}</h2>
      <p>{body}</p>
      <slot />
    </div>
    <div class="closing-actions">
      <a class="button" href={CTA_HREF}>
        {CTA_LABEL} <Arrow />
      </a>
    </div>
  </section>
) : (
  <p class="button-row">
    <a class="button" href={CTA_HREF}>
      {CTA_LABEL} <Arrow />
    </a>
  </p>
)}
