---
const {
  kind = 'strategy',
  heading = 'Tell us about your business.',
  booking = false,
} = Astro.props;
---

<form class="form-card inquiry-form" data-kind={kind}>
  <h2>{heading}</h2>
  <p class="small form-lede">
    About two minutes. We reply by email within one business
    day.
  </p>
  <div class="form-grid">
    <label class="field">
      Your name
      <input name="name" autocomplete="name" maxlength="120" required />
    </label>
    <label class="field">
      Email
      <input
        name="email"
        type="email"
        autocomplete="email"
        maxlength="200"
        required
      />
    </label>
    <label class="field">
      Business name
      <input
        name="company"
        autocomplete="organization"
        maxlength="160"
        required
      />
    </label>
    <label class="field">
      Phone <span>Optional, if you would like a call back</span>
      <input name="phone" type="tel" autocomplete="tel" maxlength="40" />
    </label>
    <label class="field">
      Website <span>Optional</span>
      <input name="website" type="url" placeholder="https://" maxlength="500" />
    </label>
    <label class="field">
      Industry
      <select name="industry" required>
        <option value="">Choose one</option>
        <option value="home-services">Home Services</option>
        <option value="med-spas">Med Spas</option>
        <option value="dental">Dental</option>
        <option value="real-estate">Real Estate</option>
        <option value="ecommerce">Ecommerce</option>
        <option value="other">Other</option>
      </select>
    </label>
    <label class="field">
      {kind === 'demo'
        ? 'Who would use the platform?'
        : 'Which engagement are you interested in?'}
      <select name="interest" required>
        {kind === 'demo' ? (
          <>
            <option value="marketing-team">Marketing or growth team</option>
            <option value="sales-team">Sales or outbound team</option>
            <option value="agency">Agency, for client work</option>
            <option value="brand">Consumer brand or ecommerce</option>
            <option value="local">Local or multi-location business</option>
            <option value="other">Other</option>
          </>
        ) : (
          <>
            <option value="not-sure">Not sure yet, help me decide</option>
            <option value="growth-partner">Growth Partner</option>
            <option value="foundation">Foundation</option>
            <option value="scale">Scale</option>
          </>
        )}
      </select>
    </label>
    <label class="field full">
      What would you like to change?
      <textarea
        name="message"
        maxlength="2000"
        placeholder="Your goals, what is getting in the way, and what you have already tried."
        required
      ></textarea>
      <span>
        Please leave out customer, patient, or financial account details.
      </span>
    </label>
    {booking && (
      <label class="field full">
        Best time of day for a call
        <select name="preferredTime">
          <option value="flexible">Flexible, email me some options</option>
          <option value="morning">Morning</option>
          <option value="afternoon">Afternoon</option>
        </select>
        <span>We will email you to confirm a time.</span>
      </label>
    )}
  </div>
  <label class="honeypot" aria-hidden="true">
    Leave this empty
    <input name="fax" tabindex="-1" autocomplete="off" />
  </label>
  <label class="checkbox-field">
    <input type="checkbox" name="consent" required />
    <span>
      It is okay for Dead River to contact me about this request. I have read
      the <a href="/privacy">privacy notice</a>. This does not sign me up for
      marketing texts.
    </span>
  </label>
  <button class="button" type="submit">
    {booking
      ? 'Request a call'
      : kind === 'demo'
        ? 'Request a demo'
        : 'Send my request'}{' '}
    <span aria-hidden="true">→</span>
  </button>
  <p class="form-status" role="status" aria-live="polite"></p>
  <noscript>
    <p class="notice">
      This form needs JavaScript. You can also email
      brandon@deadrivermanagement.com or call (915) 228-3054.
    </p>
  </noscript>
</form>
<script>
  import '../../scripts/growth-inquiry.js';
</script>
