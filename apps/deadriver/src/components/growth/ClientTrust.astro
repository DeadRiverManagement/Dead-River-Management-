    .client-trust-grid li { min-height: 100px; }
    .client-trust-grid a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    border-radius: 8px;
  }
  .client-trust-grid a:focus-visible { outline: 2px solid var(--copper); outline-offset: 6px; }
  .client-trust-grid img { height: 92px; max-width: 136px; }
  }
