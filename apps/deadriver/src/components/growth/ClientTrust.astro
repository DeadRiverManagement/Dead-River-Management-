---
// Client artwork links to each case study, running as a React Bits LogoLoop
// marquee (src/components/react-bits). Wicked uses a transparent cutout.
import ClientLogoLoop from '../react-bits/ClientLogoLoop.jsx';
const logos = [
  { src: '/images/clients/total-auto-repair.webp', alt: 'Total Auto Repair', href: '/work/total-auto-repair', width: 240, height: 220 },
  { src: '/images/clients/gonzalez-and-sons-roofing.webp', alt: 'Gonzalez and Sons Roofing', href: '/work/gonzalez-and-sons-roofing', width: 240, height: 179 },
  { src: '/images/clients/the-pipe-whisperers.webp', alt: 'The Pipe Whisperers', href: '/work/the-pipe-whisperers', width: 235, height: 240 },
  { src: '/images/clients/parcel-management-group.webp', alt: 'Parcel Management Group', href: '/work/parcel-management-group', width: 209, height: 240 },
  { src: '/images/clients/wicked-logistics-transparent.webp', alt: 'Wicked Logistics', href: '/work/wicked-logistics', width: 240, height: 202, className: 'client-trust-wicked-logo' },
  { src: '/images/clients/only-fish.webp', alt: 'Only Fish', href: '/work/only-fish', width: 153, height: 93, className: 'client-trust-fish-logo' },
];
---
<section class="client-trust wrap" aria-labelledby="client-trust-title">
  <h2 id="client-trust-title" class="client-trust-heading">
    Trusted by businesses we’ve helped grow
  </h2>
  <ClientLogoLoop
    client:idle
    logos={logos}
    speed={46}
    gap={72}
    logoHeight={72}
    fadeOut
    pauseOnHover
    ariaLabel="Clients we have helped grow"
  />
</section>

<style>
  .client-trust-heading {
    margin: 0 0 24px;
    color: var(--muted);
    font-family: var(--body);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.6;
    letter-spacing: 0.12em;
    text-align: center;
    text-transform: uppercase;
  }
</style>
