<style>
  .client-trust {
    padding-block: 30px 38px;
    border-top: 1px solid var(--line);
  }
  .client-trust-heading {
    margin: 0 0 24px;
    color: var(--muted);
    font-family: var(--body);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.6;
    letter-spacing: 0.12em;
    text-align: center;
    text-transform: uppercase;
  }
  .client-trust-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    align-items: center;
    gap: 18px 26px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .client-trust-grid li {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 108px;
    padding: 4px;
  }
  .client-trust-grid a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    border-radius: 8px;
  }
  .client-trust-grid a:focus-visible { outline: 2px solid var(--copper); outline-offset: 6px; }
  .client-trust-grid img {
    display: block;
    width: 100%;
    max-width: 152px;
    height: 100px;
    object-fit: contain;
    mix-blend-mode: multiply;
  }
  /* The transparent Wicked cutout keeps the mark's teal and green colors. */
  .client-trust-grid .client-trust-wicked-logo {
    mix-blend-mode: normal;
  }
  /* Preserve the supplied Only Fish artwork's original blues. */
  .client-trust-grid .client-trust-fish-logo {
    mix-blend-mode: normal;
  }
  @media (max-width: 960px) {
