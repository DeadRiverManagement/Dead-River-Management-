---
import Base from '../layouts/Base.astro';
import FaqList from './FaqList.astro';
import Icons from './Icons.astro';
import { business, planBySlug, USAGE_NOTE, GUARANTEE_LINE, VOICE_DEMO_CTA, VOICE_DEMO_PHONE_E164 } from '../data/site';
import { faqPage } from '../lib/schema';

interface Props {
  slug: string;
  faqs: { q: string; a: string }[];
  how: { h: string; p: string }[];
}

const { slug, faqs, how } = Astro.props;
const plan = planBySlug(slug);
const url = `${business.url}/${plan.slug}`;

const schema = [
  { '@context': 'https://schema.org', '@type': 'WebPage', '@id': `${url}#webpage`, url, name: `${plan.name} | Dead River Management`, isPartOf: { '@id': `${business.url}/#website` } },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: plan.name,
    description: plan.blurb,
    provider: { '@id': `${business.url}/#organization` },
    areaServed: ['El Paso, TX', 'United States'],
    audience: { '@type': 'BusinessAudience', name: 'Home service businesses' },
    offers: {
      '@type': 'Offer',
      url,
      priceCurrency: 'USD',
      ...(plan.monthly != null ? { price: plan.monthly.toFixed(2) } : {}),
      description: plan.blurb,
    },
  },
  faqPage(faqs),
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${business.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Plans', item: `${business.url}/plans` },
      { '@type': 'ListItem', position: 3, name: plan.name, item: url },
    ],
  },
];

const hasCheckout = Boolean(plan.paymentLink) && !plan.holdCheckout && !plan.hidePrice;
const holdCheckout = Boolean(plan.holdCheckout);
---
<Base schema={schema} ctaLabel={plan.cta} ctaHref={hasCheckout ? '#buy' : `sms:${business.phoneE164}`}>
  <section class="plan-hero" id="top">
    <div class="wrap">
      <div class="hero-copy">
        <nav class="crumb reveal-up" data-d="0" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><a href="/plans">Plans</a><span>/</span><b>{plan.name}</b></nav>
        <p class="eyebrow reveal-up" data-d="60">{plan.kicker}</p>
        <h1>
          <span class="line"><span class="mark">{plan.headline}</span></span>
        </h1>
        <div class="plan-price reveal-up" data-d="480">
          <span class="amt">{plan.price}</span>
          <span class="per">{plan.priceNote}</span>
          {plan.term && <span class="terms">{plan.term}</span>}
        </div>
        <div class="hero-ctas reveal-up" data-d="560">
          {hasCheckout ? (
            <a class="btn btn-primary" href="#buy">{plan.cta} <Icons /></a>
          ) : (
            <a class="btn btn-primary" href={`sms:${business.phoneE164}`}>Text us to start <Icons /></a>
          )}
          <a class="btn btn-ghost" href={`sms:${business.phoneE164}`}>Text us</a>
        </div>
        {plan.slug === 'front-desk-complete' && (
          <p class="cta-note reveal-up" data-d="600">
            <a class="link" href={`tel:${VOICE_DEMO_PHONE_E164}`}>{VOICE_DEMO_CTA}</a>
          </p>
        )}
        {holdCheckout && (
          <p class="cta-note reveal-up" data-d="600">Online checkout is being updated. Text us to start.</p>
        )}
        <ul class="trust reveal-up" data-d="680">
          {plan.features.slice(0, 3).map((f) => <li>{f}</li>)}
        </ul>
      </div>
      <div class="buycard reveal-up" data-d="300">
        <div class="q">{plan.kicker}</div>
        <h2>{plan.name}</h2>
        <div class="price"><span class="amt">{plan.price}</span><span class="per">{plan.priceNote}</span></div>
        <ul class="inc">
          {plan.features.map((f) => <li>{f}</li>)}
        </ul>
        {hasCheckout ? (
          <a class="btn btn-primary" href="#buy">{plan.cta} <Icons /></a>
        ) : (
          <a class="btn btn-primary" href={`sms:${business.phoneE164}`}>Text us to start <Icons /></a>
        )}
        {holdCheckout && <p class="fine">Online checkout is being updated. Text us to start.</p>}
        <p class="fine">{plan.usageNote ?? USAGE_NOTE}</p>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="section-head io">
        <p class="eyebrow">What you get</p>
        <h2>Simple. <span class="mark">Clear.</span></h2>
      </div>
      <div class="feats">
        {plan.features.map((f, i) => (
          <div class="feat io">
            <h3>{f}</h3>
            <p>{plan.benefits[i] ?? plan.blurb}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="section-head io">
        <p class="eyebrow">How it works</p>
        <h2>Four steps. <span class="mark">Then you work.</span></h2>
      </div>
      <div class="steps four io" id="steps">
        {how.map((s) => (
          <div class="step"><h3>{s.h}</h3><p>{s.p}</p></div>
        ))}
      </div>
    </div>
  </section>

  <slot name="voice-demo" />

  {hasCheckout && (
    <section class="section" id="buy" style="padding-top:0">
      <div class="wrap buy">
        <div class="buycard">
          <div class="q">Start now</div>
          <h2>{plan.name}</h2>
          <p>{plan.blurb}</p>
          <ul class="inc">
            {plan.features.map((f) => <li>{f}</li>)}
          </ul>
          <p class="fine">{plan.usageNote ?? USAGE_NOTE}</p>
          {plan.slug === 'website' && <p class="fine"><a class="link" href="/terms#plans-and-pay">Read the Website pricing and payment terms</a></p>}
        </div>
        <div class="checkout-block">
          <div class="checkout" id="checkout">
            <iframe src={plan.paymentLink!} title={`Secure checkout for ${plan.name}`} loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
          </div>
          <p class="checkout-fallback"><a href={plan.paymentLink!} target="_blank" rel="noopener">Open secure checkout</a></p>
        </div>
      </div>
    </section>
  )}

  <section class="section" style="padding-top:0" id="faq">
    <div class="wrap">
      <div class="section-head io">
        <p class="eyebrow">Questions</p>
        <h2>Straight answers.</h2>
      </div>
      <FaqList items={faqs} />
    </div>
  </section>

  <section class="cta section">
    <div class="wrap io">
      <p class="eyebrow" style="margin-bottom:18px">Need the whole job?</p>
      <h2>Dead River Complete. <span class="mark">{GUARANTEE_LINE}</span></h2>
      <div class="hero-ctas">
        <a class="btn btn-primary" href="/dead-river-complete">See the full plan <Icons /></a>
        <a class="btn btn-ghost" href="/plans">See all plans</a>
      </div>
    </div>
  </section>
</Base>
