---
// Home service case studies linked from the homepage home services section.
// Company names are added once the clients confirm them.
import Growth from '../layouts/Growth.astro';
import Hero from '../components/growth/Hero.astro';
import Arrow from '../components/growth/Arrow.astro';
import { breadcrumbList, itemList } from '../lib/schema';

const cases = [
  {
    headline: 'From 2 roofs a month to 8. At $25K a job.',
    company: 'Gonzalez & Sons Roofing',
    before: '2 roofs a month, $50,000/month revenue',
    after: '8 roofs a month, $200,000/month revenue',
    close: '35% (8 contracts signed from 23 qualified estimates)',
    result: '4x the roofs, $150,000 more every month',
    did: 'Rebuilt their Google Ads account, created storm-damage landing pages, set up automated follow-up for no-shows, tracked every estimate from click to signed contract',
    href: '/work/gonzalez-and-sons-roofing',
  },
  {
    headline: 'From $60K a year to $250K. They had to expand to keep up.',
    company: 'The Pipe Whisperers (plumbing)',
    before: 'Roughly $60,000 a year in revenue.',
    after: 'Roughly $250,000 a year. So much work the business had to expand.',
    result: 'More than 4x the revenue. About $190,000 more a year.',
    did: 'Launched Facebook ads targeting homeowners with 15+ year old water heaters, built emergency plumbing landing pages, set up SMS follow-up for after-hours calls',
    href: '/work/the-pipe-whisperers',
  },
  {
    headline: 'From $20K months to $100K months.',
    company: 'Total Auto Repair',
    before: 'Roughly $20,000 a month.',
    after: 'Roughly $100,000 a month.',
    result: '5x the revenue. About $80,000 more every single month.',
    did: 'Created Facebook ads targeting car owners with check engine lights, built landing pages for brake jobs and transmission repairs, automated appointment reminders',
    href: '/work/total-auto-repair',
  },
  {
    headline: 'From 1-2 leads a week to 5-6 a day. One became a $1.2M contract.',
    company: 'Wicked Logistics (El Paso, TX)',
    before: '1-2 inbound leads a week.',
    after: '5-6 leads a day since October 2025.',
    result: 'One of those leads turned into a $1.2M/year shipping contract.',
    did: "Rebuilt their lead generation engine: new ads, a landing page built to capture shipping leads, and follow-up that gets every lead a response fast",
    href: '/work/wicked-logistics',
  },
  {
    headline: '49 leads in 30 days. $17.70 each.',
    company: 'Parcel Management Group (Ventura, CA)',
    before: "Leads coming in with no system behind them.",
    after: '49 Facebook leads in 30 days (August 11 to September 9, 2026).',
    result: "$17.70 per lead, and every lead followed up automatically.",
    did: "Launched two Facebook lead campaigns, built the lead capture behind them, and set up automatic follow-up so every lead got a next step",
    href: '/work/parcel-management-group',
  },
];
const schema = [
  breadcrumbList([
    { name: 'Home', path: '/' },
    { name: 'Home Service Case Studies', path: '/home-service-case-studies' },
  ]),
  itemList(cases.map((c) => ({ name: c.company, path: c.href }))),
];
---

<Growth ogImage="/images/og/work.jpg"
  title="Home Service Case Studies"
  description="Case studies from Dead River Management: Gonzalez & Sons Roofing, The Pipe Whisperers, Total Auto Repair, Wicked Logistics, and Parcel Management Group."
  schema={schema}
>
  <Hero scene="liquid"
    eyebrow="Home service case studies"
    title="Real results for home service and service businesses."
    intro="Here’s what the Dead River customer acquisition system has done for our clients: ads, landing pages, CRM, automated follow-up, booking, and revenue tracking, built and run for them."
  >
    <div class="button-row">
      <a class="button" href="/book?industry=home-services">Book Your Free Strategy Call <Arrow /></a>
    </div>
  </Hero>
  {cases.map((c, i) => (
    <section class={'section' + (i % 2 === 0 ? ' soft' : '')}>
      <div class="wrap split case-split">
        <div>
          <p class="eyebrow">{c.company}</p>
          <h2>{c.headline}</h2>
        </div>
        <div class="feature-panel">
          <ul class="check-list">
            <li><strong>Company:</strong> {c.company}</li>
            <li><strong>Before:</strong> {c.before}</li>
            <li><strong>After:</strong> {c.after}</li>
            {c.close && <li><strong>Close Rate:</strong> {c.close}</li>}
            <li><strong>Result:</strong> {c.result}</li>
            <li><strong>What we did:</strong> {c.did}</li>
          </ul>
          <a class="text-link" href={c.href}>Read the full case study <Arrow /></a>
        </div>
      </div>
    </section>
  ))}
  <section class="closing wrap">
    <div>
      <p class="eyebrow">Book a call</p>
      <h2>Ready to fill your calendar with qualified estimates?</h2>
      <p>Book a free strategy call and we’ll show you which tier fits and how we’ll get you 20 qualified estimate requests or 15 booked estimates in the next 90 days.</p>
    </div>
    <div class="closing-actions">
      <a class="button" href="/book?industry=home-services">Book Your Free Strategy Call <Arrow /></a>
      <a class="text-link" href="/work">See all client results <Arrow /></a>
    </div>
  </section>
</Growth>

<style>
  .case-split {
    align-items: start;
  }
  .case-split > * {
    min-width: 0;
  }
  .case-split .check-list li {
    font-size: 17px;
  }
  .case-split strong {
    color: var(--ink);
  }
  .case-split .text-link {
    margin-top: 14px;
  }
</style>
