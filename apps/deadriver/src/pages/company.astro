---
import Growth from '../layouts/Growth.astro';
import Hero from '../components/growth/Hero.astro';
import CTA from '../components/growth/CTA.astro';
import Arrow from '../components/growth/Arrow.astro';
import OfficeMap from '../components/growth/OfficeMap.astro';
import FaqList from '../components/FaqList.astro';
import { faqPage } from '../lib/schema';

const fuelLine = "Not Dead River Company (New England fuel), we don't sell fuel.";
const fuelFaqAnswer = "No. Not Dead River Company (New England fuel), we don't sell fuel. Dead River Management is based in El Paso, Texas, and works with accepted businesses nationwide.";
const companyFaq = [
  {
    q: 'Is Dead River Management the same as Dead River Company?',
    a: fuelFaqAnswer,
  },
  {
    q: 'What is the Demand Flow guarantee?',
    a: "It's simple. If we accept your business, we'll help you generate $50,000 in new revenue in 45 to 60 days. If we miss, you get your service fees back plus $500 for wasting your time. Ad spend paid to the ad platforms isn't refunded. The full terms are on the Guarantee terms page.",
  },
  {
    q: 'Does Dead River Management still offer a 30 leads in 60 days guarantee?',
    a: "No. The old 30 leads in 60 days offer and the work-for-free offer are gone. The live offer is Demand Flow: $50,000 in new revenue in 45 to 60 days, or your service fees back plus $500. Ad spend isn't refunded. It's for accepted businesses only. The full terms are on the Guarantee terms page.",
  },
];
---

<Growth
  title="El Paso HQ, Clients Nationwide | Dead River Management"
  description="Based in El Paso, working nationwide. Dead River Management helps accepted businesses add $50,000 in new revenue in 45-60 days with Demand Flow."
  schema={faqPage(companyFaq)}
>
  <Hero scene="liquid"
    eyebrow="Company"
    title="Good businesses deserve a clear path to more customers."
    intro={`We bring the strategy, the marketing, and the systems behind them into one plan. So you know what you're paying for and what it brings back. ${fuelLine}`}
  />
  <section class="section wrap split">
    <img
      class="founder-image"
      src="/images/brandon-aubey-880.webp"
      width="880"
      height="1100"
      alt="Brandon Aubey, founder of Dead River Management"
    />
    <div>
      <p class="eyebrow">Brandon Aubey · Founder</p>
      <h2>Close to the work. Focused on what brings in business.</h2>
      <p class="intro">
        I started Dead River in El Paso, and we work with businesses all over the country. We partner with growing businesses that have something worth growing and need a better way to do it.
      </p>
      <p>
        It starts with simple questions. Where do your customers come from? What happens when someone reaches out? What brings a customer back? Which numbers can we actually trust?
      </p>
      <p>
        We turn those answers into a plan with a clear scope, build the systems behind it, and use the numbers to decide what to do next.
      </p>
    </div>
  </section>
  <section class="section soft">
    <div class="wrap">
      <div class="steps values">
        {[
          [
            'Clarity before activity',
            'Know the goal, the problem, and what we agreed to do before anything starts.',
          ],
          [
            'One connected system',
            'Getting customers, booking them, and keeping them should work together, not live in separate tools.',
          ],
          [
            'Evidence over noise',
            "Real work and honest numbers. If we can't measure it, we'll tell you.",
          ],
          [
            'A partnership you can reach',
            'A real person you can call, regular reviews, and clear next steps, wherever you are.',
          ],
        ].map(([h, p]) => (
          <article>
            <h3>{h}</h3>
            <p>{p}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="section wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">Who you’ll work with</p>
        <h2>You'll know who's handling what from day one.</h2>
      </div>
    </div>
    <div class="feature-grid">
      <article class="feature-panel">
        <h3>Your strategist</h3>
        <p>
          Your first conversations are with a strategist who helps figure out if we're a fit, what the scope is, and what happens next.
        </p>
      </article>
      <article class="feature-panel">
        <h3>Brandon and the delivery team</h3>
        <p>
          Brandon leads the work and makes sure what we agreed to gets done. You get a named point of contact, a shared access checklist, and reviews on a schedule that fits your engagement.
        </p>
      </article>
    </div>
  </section>
  <OfficeMap />
  <section class="section wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">Questions</p>
        <h2>What people ask us.</h2>
      </div>
    </div>
    <FaqList items={companyFaq} />
  </section>
  <CTA />
</Growth>
