---
import Growth from '../layouts/Growth.astro';
import Hero from '../components/growth/Hero.astro';
import CTA from '../components/growth/CTA.astro';
import Arrow from '../components/growth/Arrow.astro';
import OfficeMap from '../components/growth/OfficeMap.astro';
import FaqList from '../components/FaqList.astro';
import { faqPage } from '../lib/schema';

const fuelLine = 'Not Dead River Company (New England fuel), we do not sell fuel.';
const fuelFaqAnswer = 'No. Not Dead River Company (New England fuel), we do not sell fuel. Dead River Management is based in El Paso, Texas, and works with accepted businesses nationwide.';
const companyFaq = [
  {
    q: 'Is Dead River Management the same as Dead River Company?',
    a: fuelFaqAnswer,
  },
  {
    q: 'What is the Demand Flow guarantee?',
    a: 'Demand Flow is Dead River Management’s public performance guarantee for accepted businesses: $50,000 in new revenue in 45 to 60 days. If we miss, service fees are refunded plus $500. Ad spend paid to the ad platforms is not refunded. Read the Guarantee terms page on this site.',
  },
  {
    q: 'Does Dead River Management still offer a 30 leads in 60 days guarantee?',
    a: 'No. The older 30 leads in 60 days / work-for-free promise is no longer a public offer. The live public guarantee is Demand Flow: $50,000 in new revenue in 45 to 60 days, or service fees refunded + $500 (ad spend not refunded), for accepted businesses only. Read the Guarantee terms page on this site.',
  },
];
---

<Growth
  title="El Paso HQ, Clients Nationwide | Dead River Management"
  description="Based in El Paso, working nationwide. Dead River Management helps accepted businesses add $50,000 in new revenue in 45-60 days with Demand Flow."
  schema={faqPage(companyFaq)}
>
  <Hero
    eyebrow="Company"
    title="Good businesses deserve a clearer path forward."
    intro={`Dead River Management brings strategy, marketing, and the systems behind them into one connected strategy, so you know what you are investing in and what it returns. ${fuelLine}`}
  />
  <section class="section wrap split">
    <img
      class="founder-image"
      src="/images/brandon-aubey-880.webp"
      width="880"
      height="1100"
      alt="Brandon Aubey, founder of Dead River Management"
    />
    <div>
      <p class="eyebrow">Brandon Aubey · Founder</p>
      <h2>Close to the work. Focused on what changes.</h2>
      <p class="intro">
        Founded in El Paso and built to work nationwide, Dead River partners
        with growing businesses that have something worth scaling and need a
        more connected way to do it.
      </p>
      <p>
        That starts with useful questions. Where does demand come from? What
        happens to an inquiry? What brings a customer back? Which numbers can we
        actually trust?
      </p>
      <p>
        We turn those answers into a scoped plan, build the supporting
        infrastructure, and use reporting to guide the next decision.
      </p>
    </div>
  </section>
  <section class="section soft">
    <div class="wrap">
      <div class="steps values">
        {[
          [
            'Clarity before activity',
            'Know the goal, the constraint, and the agreed scope before anything starts.',
          ],
          [
            'One connected system',
            'Acquisition, conversion, and retention should support each other, not live in separate tools.',
          ],
          [
            'Evidence over noise',
            'Documented work and honest measurement. If we cannot measure it, we say so.',
          ],
          [
            'A partnership you can reach',
            'A named point of contact, structured reviews, and clear next steps, wherever you are based.',
          ],
        ].map(([h, p]) => (
          <article>
            <h3>{h}</h3>
            <p>{p}</p>
          </article>
        ))}
      </div>
    </div>
  </section>
  <section class="section wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">Who you’ll work with</p>
        <h2>Clear ownership from the first conversation.</h2>
      </div>
    </div>
    <div class="feature-grid">
      <article class="feature-panel">
        <h3>Your strategist</h3>
        <p>
          Your first conversations are with a strategist who helps clarify fit,
          scope, the proposal, and next steps.
        </p>
      </article>
      <article class="feature-panel">
        <h3>Brandon and the delivery team</h3>
        <p>
          Brandon leads fulfillment and oversees the agreed implementation. You
          receive a named point of contact, a shared access checklist, and a
          review rhythm matched to your engagement.
        </p>
      </article>
    </div>
  </section>
  <OfficeMap />
  <section class="section wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">Questions</p>
        <h2>Straight answers.</h2>
      </div>
    </div>
    <FaqList items={companyFaq} />
  </section>
  <CTA />
</Growth>
