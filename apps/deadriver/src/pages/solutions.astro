---
import Growth from '../layouts/Growth.astro';
import Hero from '../components/growth/Hero.astro';
import CTA from '../components/growth/CTA.astro';
import Arrow from '../components/growth/Arrow.astro';
const areas = [
  [
    'demand',
    'Create demand',
    'Reach the right market through the channels most likely to move your business, with a strategy grounded in your margins, capacity, and competitive position.',
    'Paid media · Audience research · Audience intelligence',
  ],
  [
    'conversion',
    'Convert demand',
    'Give your website, landing pages, and booking flow one job: making the next step easy. Then give your team the systems to respond while interest is high.',
    'Conversion optimization · Lead capture · Booking · Pipeline',
  ],
  [
    'followup',
    'Improve follow-up',
    'Every inquiry gets a clear owner and a useful next step, from the first response through booking, estimates, and long-term nurture.',
    'Response workflows · Missed-call recovery · Estimate follow-up',
  ],
  [
    'retention',
    'Grow customer value',
    'Keep more value in the business with timely follow-up, reactivation, and retention programs that fit how your customers buy.',
    'Email and SMS programs · Database reactivation · Lifecycle planning',
  ],
  [
    'infrastructure',
    'Measure what matters',
    'Connect marketing activity to opportunities, customers, and revenue wherever tracking allows, and review the numbers with context.',
    'Tracking · Attribution · CRM and pipeline · Live dashboards · Strategy',
  ],
];
---

<Growth
  title="Demand Flow: $50k in 45-60 Days | Dead River Management"
  description="The public offer is Demand Flow: $50,000 in new revenue in 45-60 days, or service fees refunded plus $500. Ad spend is not refunded. Accepted businesses only."
>
  <Hero
    eyebrow="Solutions"
    title="Connect what drives your next stage."
    intro="Strategy, acquisition, conversion, and retention belong in the same conversation. We start with the constraint and build the system around it."
  >
    <div class="button-row">
      <a class="text-link" href="/book">
        Talk through the engagements <Arrow />
      </a>
    </div>
  </Hero>
  <section class="section wrap">
    <div class="section-head">
      <h2>How the system connects</h2>
    </div>
    <div class="feature-grid">
      {areas.map(([id, title, body, tags]) => (
        <article id={id} class="feature-panel">
          <h3>{title}</h3>
          <p>{body}</p>
          <p class="small">{tags}</p>
        </article>
      ))}
    </div>
  </section>
  <section class="section soft">
    <div class="wrap split">
      <div>
        <p class="eyebrow">The live public engagement</p>
        <h2>Demand Flow starts with the outcome.</h2>
      </div>
      <div class="stack">
        <p>
          <strong>Demand Flow</strong> is the live public engagement for
          accepted businesses: $50,000 in new revenue in 45-60 days. If we
          miss, service fees are refunded plus $500; ad spend is not refunded.
        </p>
        <p>
          We scope demand creation, conversion, follow-up, and measurement
          around your market, capacity, and the work needed to pursue that
          outcome.
        </p>
        <p>
          <a class="inline-link" href="/legal/guarantee">Read the guarantee terms</a>
          and <a class="inline-link" href="/book">book a conversation</a> to
          see whether your business qualifies.
        </p>
        <a class="text-link" href="/book">
          Book a conversation <Arrow />
        </a>
      </div>
    </div>
  </section>
  <section class="section wrap split">
    <div>
      <p class="eyebrow">Better signals, better starting points</p>
      <h2>Demand Intelligence, applied thoughtfully.</h2>
    </div>
    <div>
      <p>
        Audience intelligence can inform Demand Flow and acquisition work
        where it is useful.
      </p>
      <p>
        Full platform access is a standalone product for marketing, sales,
        agency, and brand teams nationwide, covering both business and consumer
        demand. Scope and fees are confirmed on a call; there is no public
        price listed here.
      </p>
      <a class="text-link" href="/demand-intelligence">
        Explore Demand Intelligence <Arrow />
      </a>
    </div>
  </section>
  <CTA />
</Growth>
