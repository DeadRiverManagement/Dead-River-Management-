---
import ClientTrust from '../components/growth/ClientTrust.astro';
import Growth from '../layouts/Growth.astro';
import Arrow from '../components/growth/Arrow.astro';
import River from '../components/growth/River.astro';
import FaqList from '../components/FaqList.astro';
import Reviews from '../components/growth/Reviews.astro';
import { faqPage } from '../lib/schema';
import { googleReviews, facebookReviews } from '../data/reviews';

// Demand Flow, the short version. The full nutshell lives on /demand-flow.
const stages = [
  ['Target', 'We find people showing recent buying signals for what you sell. That beats throwing spaghetti at a wall and seeing what sticks.'],
  ['Create', 'Landing pages built to convert, and ads that put your offer in front of the right people. The ad and the page work together.'],
  ['Capture', 'A form, a quote, a booking, a call or a purchase. Every inquiry lands in your customer management system, so you know who reached out and what happens next.'],
  ['Convert', 'Quick replies, follow-up and reminders take care of every inquiry. We track bookings and sales, then tune what’s working.'],
];

const demandFlowFaq = [
  {
    q: 'What is the Demand Flow guarantee?',
    a: "It's simple. If we accept your business, we'll help you generate $50,000 in new revenue in 45 to 60 days. If we miss, you get your service fees back plus $500 for wasting your time. Ad spend paid to the ad platforms is not refunded. The full terms are on the Guarantee terms page.",
  },
  {
    q: 'Does Dead River Management still offer a 30 leads in 60 days guarantee?',
    a: "No. The old 30 leads in 60 days offer and the work-for-free offer are gone. The live offer is Demand Flow: $50,000 in new revenue in 45 to 60 days, or your service fees back plus $500. Ad spend is not refunded. It's for accepted businesses only. The full terms are on the Guarantee terms page.",
  },
  {
    q: 'Which marketing agencies offer a written new-revenue guarantee?',
    a: 'We do. Dead River Management, based in El Paso and working nationwide, puts the Demand Flow guarantee in writing: $50,000 in new revenue in 45 to 60 days for accepted businesses, or your service fees back plus $500. Ad spend is not refunded. Before you trust any agency promise, get three things in writing: what happens if they miss, what counts as revenue, and who pays for the ads.',
  },
  {
    q: 'What does Dead River Management actually do?',
    a: "We're a marketing agency, but we're a little different. We use purchase intent data to find people already looking for the services you offer. Then we reach them with Google Ads, Facebook ads, Local Services Ads, SEO, local SEO, and AI search. We build the website and landing pages, answer and follow up on every lead, and track all of it to the booked job. One team runs the whole thing.",
  },
  {
    q: 'Which industries does Dead River Management work with?',
    a: 'Mostly home service businesses: roofing, plumbing, HVAC, electrical, landscaping, pest control, and auto repair. We also work with dental, med spa, logistics, and other local businesses that book appointments or quotes. A roofer we work with went from 2 to 8 roofs a month. A plumber went from $60,000 to $250,000 a year. An auto shop went from $20,000 to $100,000 a month.',
  },
  {
    q: 'Where is Dead River Management located, and who do you serve?',
    a: "Our office is at 416 N. Stanton St, Suite 120-M, El Paso, TX 79901. We work with businesses in El Paso, Las Cruces, and all over the country. You get a named strategist, reports you can see, and a monthly review. That's the same whether you're in El Paso or another state.",
  },
  {
    q: 'What makes Dead River Management different from other marketing agencies?',
    a: "Three things. We put a revenue guarantee in writing, with a clear rule for what happens if we miss. Almost no agency does that. We judge our work by booked jobs and revenue, not clicks or lead counts. And we run the whole system, from the ad to the phone to the follow-up to the report. So there's one team to call when something's off.",
  },
  {
    q: 'How fast does marketing start producing results?',
    a: 'Ads and the phone system go live in the first two weeks. Paid search brings calls almost right away. SEO and local SEO take three to six months to move. The Demand Flow guarantee is measured over 45 to 60 days from the day the whole system is live. Gonzalez & Sons Roofing went from 2 to 8 roofs a month in six months.',
  },
  {
    q: 'Do I need both SEO and paid ads?',
    a: "Usually yes, and in that order. Paid ads bring calls this week. SEO brings calls you don't pay per click for, but it takes months to build. Most service businesses start with ads and the phone system, then add SEO so each job costs less over time. If you can only do one, start with the one that books jobs fastest.",
  },
  {
    q: 'How much does a marketing agency cost per month?',
    a: "Most small-business agencies charge $1,000 to $5,000 a month, plus the ad spend you pay to Google or Meta. Cheaper plans usually mean one channel and no follow-up. Very few put a number or a guarantee in writing. Before we go over pricing, we make sure we're a fit for your business. Then the Demand Flow guarantee is in writing: $50,000 in new revenue in 45 to 60 days, or your service fees back plus $500.",
  },
  {
    q: 'How do I hire a marketing agency?',
    a: "Ask four things before you sign. Show me results for a business like mine, with real numbers. What counts as a result: a click, a lead, or a booked job? Who owns the ad accounts and the website if I leave? And what happens if you miss? If an agency can't answer all four in writing, don't give them your budget.",
  },
  {
    q: 'Is it worth hiring a marketing agency for a small business?',
    a: "It's worth it when the agency gets paid for results you can count. An agency costs anywhere from a few hundred to a few thousand dollars a month. The real question is whether it books more revenue than it costs. Ask for client numbers, a written rule for what happens if they miss, and who owns the ad accounts and website if you leave. If they can't answer, don't hire them.",
  },
];
---

<Growth
  title="$50,000 in 45-60 Days, Guaranteed"
  description="Purchase intent data finds people ready to buy now. We create, capture, and convert that demand. $50,000 in 45 to 60 days or money back + $500."
  schema={faqPage(demandFlowFaq)}
>
  <section class="hero wrap">
    <div class="hero-copy">
      <p class="eyebrow" data-rise>The Demand Flow guarantee · Nationwide</p>
      <h1 data-split>We'll help your business generate $50,000 in new revenue with our Demand Flow system in 45 to 60 days. <em>Or your money back, and we pay you $500 for wasting your time.</em></h1>
      <div class="hero-row">
        <p class="intro" data-rise>
          Most marketing is throwing spaghetti at the wall and seeing what sticks. We're a little different. We use purchase intent data to find people already looking for the services you offer. Then we put your offer in front of them, answer every lead, follow up, and get them booked.
        </p>
        <div>
          <div class="button-row" data-rise>
            <a class="button" href="/book">Book a strategy call <Arrow /></a>
            <a class="button secondary" href="#how">See how Demand Flow works <Arrow /></a>
          </div>
          <p class="hero-proof" data-rise>
            <span class="rv-stars" aria-hidden="true">★★★★★</span>
            <span><strong>{googleReviews.rating.toFixed(1)} on Google</strong> · {googleReviews.count} {googleReviews.count === 1 ? 'review' : 'reviews'}</span>
            <span><strong>{facebookReviews.count}</strong> Facebook recommendations</span>
            <span>Based in El Paso, Texas · Working nationwide</span>
          </p>
        </div>
      </div>
    </div>
    <River />
  </section>
  <ClientTrust />
  <section class="section" id="how">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Demand Flow</p>
          <h2>Target demand. Create demand. Capture demand. Convert demand.</h2>
          <p class="intro">Demand Flow is how we help your business reach people actively looking for your services or products, capture their interest and help turn them into paying customers.</p>
        </div>
        <a class="text-link" href="/demand-flow#how">How Demand Flow works, start to finish <Arrow /></a>
      </div>
    </div>
    <div class="flow-stage" data-flow>
      <div class="wrap flow-track">
        <svg class="flow-line" viewBox="0 0 1200 220" preserveAspectRatio="none" aria-hidden="true">
          <path class="flow-glow flow-draw" d="M-20 170C180 175 230 40 420 60C600 80 560 190 760 150C930 115 980 20 1220 50" fill="none" stroke-linecap="round" />
          <path class="flow-path flow-draw" d="M-20 170C180 175 230 40 420 60C600 80 560 190 760 150C930 115 980 20 1220 50" fill="none" stroke-linecap="round" />
        </svg>
        <div class="steps home-steps flow-steps">
          {stages.map(([title, body], i) => (
            <article data-flow-step>
              <span class="number">Stage {i + 1}</span>
              <h3>{title}</h3>
              <p>{body}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>
  <section class="section soft band-dark" id="why-now">
    <div class="wrap urgency">
      <div>
        <p class="eyebrow">Why now</p>
        <h2>The people ready to buy from you are searching this week. Not next quarter.</h2>
        <p class="intro">
          A buying signal is fresh for about 48 hours. After that, they've picked someone. Every week you wait is a week your best customers spend calling someone else. Book the call. We'll look at the live demand in your market together, and you'll know on that call if your business qualifies for the guarantee.
        </p>
      </div>
      <div class="urgency-actions">
        <a class="button" href="/book">Book a strategy call <Arrow /></a>
        <p class="small">Free. About 30 minutes. No pitch deck, just your market's numbers.</p>
      </div>
    </div>
  </section>
  <section class="section" id="proof">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Client stories</p>
          <h2>Results over theory</h2>
          <p class="intro">
            Hear it straight from the business owners we work with.
          </p>
        </div>
        <a class="text-link" href="/work">View all case studies <Arrow /></a>
      </div>
      <div class="home-testimonial">
        <video controls playsinline preload="none" width="512" height="910"
          poster="https://d2ol7oe51mr4n9.cloudfront.net/user_3JQHnLTq89zb3rmd2x4Z53G0lE3/bc486f19-6b03-42e7-996b-7226bd18326e.jpg"
          aria-label="Hear from Total Auto Repair">
          <source src="https://d2ol7oe51mr4n9.cloudfront.net/user_3JQHnLTq89zb3rmd2x4Z53G0lE3/52a05e7d-44fc-4cb0-9aab-4269f45edef3.mp4" type="video/mp4" />
          Your browser does not support embedded video.
          <a href="https://d2ol7oe51mr4n9.cloudfront.net/user_3JQHnLTq89zb3rmd2x4Z53G0lE3/52a05e7d-44fc-4cb0-9aab-4269f45edef3.mp4">Watch the Total Auto Repair testimonial.</a>
        </video>
      </div>
    </div>
  </section>

  <Reviews />

  <section class="section wrap" id="guarantee-faq">
    <div class="section-head">
      <div>
        <p class="eyebrow">FAQ</p>
        <h2>Straight answers about the guarantee, and about marketing.</h2>
      </div>
    </div>
    <FaqList items={demandFlowFaq} />
  </section>
</Growth>

<style>
  .section .text-link {
    margin-top: 28px;
  }
  .urgency {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 60px;
    align-items: center;
  }
  .urgency h2 {
    max-width: 760px;
  }
  .urgency-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }
  .home-testimonial { display: flex; justify-content: center; }
  .home-testimonial video { display: block; width: 100%; max-width: 360px; height: auto; aspect-ratio: 512 / 910; object-fit: contain; border: 1px solid var(--line); border-radius: 18px; background: #111111; }
  @media (max-width: 1100px) {
    .urgency {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
</style>
