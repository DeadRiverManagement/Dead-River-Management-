---
// Preview: the calendar step after the strategy session form.
import Growth from '../../layouts/Growth.astro';
import { DEMANDFLOW_CALENDAR_URL } from '../../lib/demandflow-handoff.js';
---

<Growth
  title="Last Step: Schedule Your Free Strategy Session (Preview)"
  description="Pick a time for your free 30-minute strategy session."
  robots="noindex,nofollow"
  campaign
  campaignHref="#calendar"
  campaignLabel="Pick a time"
  campaignShort="Pick a time"
>
  <section class="kk-thanks wrap">
    <p class="eyebrow">You qualify</p>
    <h1>Last step: schedule your free 30-minute strategy session now.</h1>
    <p class="intro">Pick a time below. The invite lands in your inbox. If it isn't there, check spam or promotions.</p>
    <div class="kk-calendar" id="calendar">
      <iframe
        src={DEMANDFLOW_CALENDAR_URL}
        allow="payment"
        style="width:100%;border:none;overflow:hidden;min-height:780px;"
        height="1100"
        scrolling="no"
        id="rfaj3m31onqPQEFYhwyE_kk_thanks"
        title="Pick a time for your strategy session"
        referrerpolicy="no-referrer"
      ></iframe>
      <script is:inline src="https://link.msgsndr.com/js/form_embed.js" type="text/javascript"></script>
    </div>
    <div class="kk-expect">
      <h2>What we'll go over on the call</h2>
      <ul class="check-list">
        <li>The live demand in your market, pulled on the call.</li>
        <li>Your customer value, capacity, and the path from lead to sale.</li>
        <li>Whether your business qualifies for the $50,000 Demand Flow guarantee.</li>
      </ul>
      <p>Can't find a time that works? Call or text <a href="tel:+19152283054">(915) 228-3054</a>.</p>
    </div>
  </section>
</Growth>

<style>
  .kk-thanks { padding: clamp(56px, 8vw, 100px) 0 80px; max-width: 900px; }
  .kk-thanks h1 { font-size: clamp(36px, 5vw, 64px); letter-spacing: -0.04em; margin: 10px 0 16px; }
  .kk-calendar { margin-top: 36px; border-radius: 20px; overflow: hidden; border: 1px solid rgba(255, 255, 255, 0.12); background: #fff; padding: 8px; }
  .kk-expect { margin-top: 48px; }
  .kk-expect h2 { font-size: 26px; margin-bottom: 16px; }
  .kk-expect p { color: var(--muted); margin-top: 20px; }
  .kk-expect a { color: var(--ink); }
</style>
