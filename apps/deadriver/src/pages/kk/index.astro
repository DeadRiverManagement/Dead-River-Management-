---
// Preview: King Kong's home page structure, section for section, in the Dead
// River look and with Dead River facts. Hidden from search and the sitemap.
// Copy is a first pass for Brandon to react to.
import Growth from '../../layouts/Growth.astro';
import Arrow from '../../components/growth/Arrow.astro';
import ClientTrust from '../../components/growth/ClientTrust.astro';
import Reviews from '../../components/growth/Reviews.astro';
import FaqList from '../../components/FaqList.astro';
import { work as workItems } from '../../data/growth-work';

const CTA = '/kk/strategy-session';

const letter = [
  'Dear business builder,',
  "If you're reading this, you're probably sick of it.",
  'Sick of shiny-object syndrome. Sick of not knowing where your next customer is coming from. Sick of being told you need to post on social media every day, run ads, do SEO, build a funnel, and somehow still run your business.',
  "You tried an agency. They sent a report full of clicks and impressions and you couldn't find the money in it.",
  'You tried doing it yourself. It worked for a week, then you got busy, and the phone went quiet again.',
  "Meanwhile the guy down the road with the worse product is booked out, because he's showing up in front of the right people and you're not.",
  "Here's the thing. Growing a business doesn't have to feel like throwing spaghetti at a wall and seeing what sticks.",
  "We're a marketing agency, but we're a little bit different. We use purchase intent data to find the people already looking for the services you offer. Then we put your offer in front of them, answer every lead, follow up, and get them booked.",
  "And if we don't deliver, you get your money back. Plus $500 for wasting your time.",
  "So pick your path below. Hire us to do it for you, or use our software and do it yourself. Either way, let's get you off the spaghetti.",
  'Brandon Aubey',
  'Dead River Management',
];

const stats = [
  ['$20K to $100K', 'a month, Total Auto Repair'],
  ['2 to 8 roofs', 'a month, Gonzalez & Sons Roofing'],
  ['$60K to $250K', 'a year, The Pipe Whisperers'],
  ['$1.2M contract', 'from one lead, Wicked Logistics'],
];

const faqs = [
  { q: 'What does a marketing agency actually do?', a: "A normal one runs your ads and sends you a report. We run the whole system. We find the people already looking for the services you offer, put your offer in front of them, build the page they land on, answer every lead, follow up, and track it all to the booked job." },
  { q: "How do I know I'll get a return?", a: "Because we put it in writing. If we accept your business, the offer is $50,000 in new revenue in 45 to 60 days. If we miss, you get your service fees back plus $500 for wasting your time. Ad spend isn't refunded. Your signed agreement controls." },
  { q: 'Do you work with big or small businesses?', a: "Mostly home service businesses: roofing, plumbing, HVAC, auto repair, and trades like them. Some are one truck. Some run crews across a state. What matters is that your average job is big enough and you can take on more work." },
  { q: 'Why should I pick you over another agency?', a: "Three reasons. We put a revenue guarantee in writing. We judge our work by booked jobs and revenue, not clicks. And one team runs the whole thing, from the ad to the phone to the follow-up, so there's one number to call when something's off." },
  { q: 'Do you really guarantee results?', a: "Yes, for accepted businesses. Before we take you on we look at your market, your offer, your capacity, and your ad budget. If we don't think we can hit the number, we tell you, and we don't offer the guarantee." },
  { q: "What's involved on my side?", a: 'Give us access to your accounts, fund the agreed ad budget, approve things when we ask, and answer the leads the system sends you. That last one matters more than anything else.' },
];
---

<Growth
  title="Like Steroids For Business (Preview)"
  description="Preview of the King Kong page structure in the Dead River look."
  ogImage="/images/og/home.jpg"
  robots="noindex,nofollow"
  campaign
  campaignHref={CTA}
  campaignLabel="Hit the damn button"
  campaignShort="Book a call"
>
  <div class="kk">
    <nav class="kk-paths wrap" aria-label="Choose your path">
      <a href="/kk/agency"><span>Agency</span><small>Hire us to do it for you</small></a>
      <a href="/demand-intelligence"><span>Software</span><small>Do it yourself with Demand Intelligence</small></a>
    </nav>

    <section class="kk-hero wrap">
      <p class="kk-rating" data-rise><span class="rv-stars" aria-hidden="true">★★★★★</span> <strong>Rated 5.0 on Google</strong> · Recommended on Facebook</p>
      <h1 data-split>Like steroids<sup>*</sup> for business</h1>
      <p class="kk-sub" data-rise>Growing a business is hard. We make it a whole lot easier, more predictable, less stressful, and more fun.</p>
      <form class="kk-capture" action={CTA} method="get" data-rise>
        <label class="sr-only" for="kk-email">Your email</label>
        <input id="kk-email" name="email" type="email" required placeholder="Enter your email here and we'll send you some 'magic'..." />
        <button class="button" type="submit">Do it <Arrow /></button>
      </form>
      <p class="kk-foot" data-rise><sup>*</sup>But it's 100% legal (pinky promise)</p>
      <div class="kk-video" data-rise>
        <video controls playsinline preload="metadata" poster="/images/og/demand-flow.jpg" src="/50k-demand-flow/assets/demand-flow-vsl-1080p.mp4"></video>
      </div>
    </section>

    <section class="section soft kk-letter">
      <div class="wrap">
        {letter.map((line, i) => <p class:list={{ 'kk-sig': i >= letter.length - 2 }}>{line}</p>)}
        <p class="kk-adventure">Now choose your own adventure below.</p>
      </div>
    </section>

    <section class="section wrap kk-offers">
      <article>
        <p class="eyebrow">Hire us to do it for you</p>
        <h2>Agency</h2>
        <p>Managed, done-for-you marketing for service businesses that can take on more work. Demand Flow, with the $50,000 guarantee in writing.</p>
        <a class="button" href="/kk/agency">Get started <Arrow /></a>
        <small><span class="rv-stars" aria-hidden="true">★★★★★</span> Rated 5.0 on Google</small>
      </article>
      <article>
        <p class="eyebrow">Learn how to do it yourself</p>
        <h2>Software</h2>
        <p>Demand Intelligence. The same purchase intent data we use, in your hands. Build the list, send it to your ads, call the people who are looking.</p>
        <a class="button secondary" href="/demand-intelligence">Get started <Arrow /></a>
        <small>Business and consumer data. Nationwide.</small>
      </article>
    </section>

    <section class="section wrap kk-promise">
      <div class="section-head">
        <div>
          <p class="eyebrow">The core promise</p>
          <h2>Target. Create. Capture. Convert.</h2>
          <p class="intro">Proven client-getting funnels and scientific customer acquisition. Not hopes and prayers. We find the people already looking, put your offer in front of them, catch every lead, and turn them into paid jobs.</p>
        </div>
        <a class="text-link" href="/demand-flow#how">How it works, start to finish <Arrow /></a>
      </div>
      <dl class="kk-stats">
        {stats.map(([n, l]) => <div><dd>{n}</dd><dt>{l}</dt></div>)}
      </dl>
    </section>

    <section class="section soft band-dark kk-cases">
      <div class="wrap">
        <div class="section-head">
          <div>
            <p class="eyebrow">Case studies</p>
            <h2>Become our next success story.</h2>
          </div>
          <a class="text-link" href="/work">All case studies <Arrow /></a>
        </div>
        <div class="kk-grid">
          {workItems.map((w) => (
            <a class="kk-tile" href={`/work/${w.slug}`}>
              <span class="number">{w.name}</span>
              <strong>{w.headline}</strong>
              <em>Read it <Arrow /></em>
            </a>
          ))}
        </div>
        <div class="button-row"><a class="button" href={CTA}>Hit the damn button <Arrow /></a></div>
      </div>
    </section>

    <ClientTrust />

    <section class="section wrap kk-platform">
      <div class="split">
        <div>
          <p class="eyebrow">Built for scale</p>
          <h2>The most ruthlessly effective system for growing a service business.</h2>
        </div>
        <div>
          <p>Most agencies are all bark and no bite. They reach a broad audience, send you a report full of clicks, and hope some of it turns into money.</p>
          <p>We don't hope. We start with purchase intent data, so your ads go in front of people who looked up your service in the last few days. Then the landing page, the quick text back, the booking link, the follow-up, and the tracking all run as one system. One team. One number to call.</p>
          <div class="button-row"><a class="button" href={CTA}>Hit the damn button <Arrow /></a></div>
        </div>
      </div>
    </section>

    <section class="section soft kk-guarantee">
      <div class="wrap">
        <p class="eyebrow">The guarantee</p>
        <h2>We guarantee $50,000 in new revenue in 45-60 days or your money back. Plus $500 for wasting your time.</h2>
        <div class="split">
          <ul class="check-list">
            <li>Applies to businesses we accept into Demand Flow after a strategy call.</li>
            <li>The clock starts when your system goes live. Your agreement sets the exact deadline inside the 45 to 60 day window.</li>
            <li>Revenue counts when it comes from new customers through the system we build. We track it in your CRM against closed jobs or invoices.</li>
            <li>If we miss, your service fees are refunded and we pay you $500. Ad spend goes to the ad platforms and isn't refunded.</li>
          </ul>
          <ul class="check-list">
            <li>You fund the agreed ad budget and keep the campaigns on.</li>
            <li>We write the ads and build the pages. You check them for accuracy.</li>
            <li>You answer the leads. Not answering ends the guarantee.</li>
            <li>Full terms are on the <a class="inline-link" href="/legal/guarantee">guarantee terms</a> page.</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section wrap kk-book">
      <div class="split">
        <div class="kk-book-cover" aria-hidden="true"><span>Free</span><strong>The Scale Playbook</strong><small>Get found. Win the job. Know the numbers.</small></div>
        <div>
          <p class="eyebrow">Free download</p>
          <h2>The playbook we use to grow service businesses.</h2>
          <p>How to get found, win the job, and know your numbers. The same steps we run for clients, written so you can do them yourself.</p>
          <div class="button-row"><a class="button secondary" href="/free-playbook">Get the playbook <Arrow /></a></div>
        </div>
      </div>
    </section>

    <Reviews />

    <section class="section wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">FAQ</p>
          <h2>Questions people ask before they hit the button.</h2>
        </div>
      </div>
      <FaqList items={faqs} />
    </section>

    <section class="section closing wrap">
      <p class="eyebrow">One more thing</p>
      <h2>Hit the damn button.</h2>
      <p class="intro">Your market. Your numbers. A clear plan. Free, 30 minutes, no obligation.</p>
      <div class="button-row"><a class="button" href={CTA}>Hit the damn button <Arrow /></a></div>
    </section>
  </div>
</Growth>

<style>
  .kk-paths {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 18px;
  }
  .kk-paths a {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 18px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    background: var(--cream);
    text-decoration: none;
    color: var(--ink);
    transition: border-color 0.3s ease, transform 0.3s ease;
  }
  .kk-paths a:hover { border-color: #f2b18555; transform: translateY(-2px); }
  .kk-paths span { font-family: var(--mono); font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--copper); }
  .kk-paths small { font-size: 14px; color: var(--muted); }

  .kk-hero { text-align: center; padding: clamp(56px, 8vw, 110px) 0 32px; }
  .kk-rating { font-size: 14px; color: var(--muted); }
  .kk-rating strong { color: var(--ink); }
  .kk-rating .rv-stars { color: var(--copper); margin-right: 6px; }
  .kk-hero h1 {
    margin: 22px auto 0;
    max-width: 14ch;
    font-size: clamp(54px, 10vw, 150px);
    line-height: 0.9;
    letter-spacing: -0.05em;
    text-transform: uppercase;
    text-shadow: 0 30px 80px rgba(0, 0, 0, 0.7);
  }
  .kk-hero sup { color: var(--ember); font-size: 0.5em; vertical-align: top; }
  .kk-sub { max-width: 640px; margin: 26px auto 0; font-size: clamp(18px, 2vw, 22px); color: #cfccc4; }
  .kk-capture {
    display: flex;
    gap: 0;
    max-width: 760px;
    margin: 30px auto 0;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 999px;
    background: var(--cream);
    padding: 6px;
  }
  .kk-capture input {
    flex: 1 1 auto;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    font-size: 16px;
    padding: 0 22px;
  }
  .kk-capture input:focus { outline: none; }
  .kk-capture .button { flex: none; }
  .kk-foot { margin-top: 14px; font-size: 13px; color: var(--muted); }
  .kk-video {
    max-width: 960px;
    margin: 44px auto 0;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 0 40px 120px -30px rgba(0, 0, 0, 0.9), 0 0 120px -20px rgba(227, 160, 112, 0.3);
  }
  .kk-video video { display: block; width: 100%; aspect-ratio: 16 / 9; background: #000; }

  .kk-letter .wrap { max-width: 720px; }
  .kk-letter p { font-size: 18px; line-height: 1.7; color: #cfccc4; margin: 0 0 18px; }
  .kk-letter p:first-child { font-family: var(--display); font-weight: 800; font-size: 26px; color: var(--ink); }
  .kk-letter .kk-sig { margin: 0; color: var(--ink); }
  .kk-letter .kk-sig + .kk-sig { color: var(--muted); margin-bottom: 28px; }
  .kk-adventure { font-weight: 600; color: var(--ember) !important; }

  .kk-offers { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .kk-offers article {
    padding: 36px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 20px;
    background: linear-gradient(180deg, #161618, #111112);
  }
  .kk-offers h2 { font-size: clamp(40px, 5vw, 64px); text-transform: uppercase; letter-spacing: -0.04em; margin: 8px 0 14px; }
  .kk-offers p { color: #cfccc4; }
  .kk-offers .button { margin-top: 18px; }
  .kk-offers small { display: block; margin-top: 16px; font-size: 13px; color: var(--muted); }
  .kk-offers .rv-stars { color: var(--copper); }

  .kk-stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; margin: 48px 0 0; border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 16px; overflow: hidden; background: rgba(255, 255, 255, 0.12); }
  .kk-stats > div { background: var(--paper); padding: 26px 24px; }
  .kk-stats dd { margin: 0; font-family: var(--display); font-weight: 800; font-size: clamp(28px, 3vw, 40px); letter-spacing: -0.04em; color: var(--ember); }
  .kk-stats dt { margin-top: 8px; font-size: 14px; color: var(--muted); }

  .kk-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 36px; }
  .kk-tile { display: flex; flex-direction: column; gap: 10px; padding: 26px; border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 18px; background: linear-gradient(180deg, #161618, #111112); text-decoration: none; color: var(--ink); transition: border-color 0.3s ease, transform 0.3s ease; }
  .kk-tile:hover { border-color: #f2b18555; transform: translateY(-2px); }
  .kk-tile strong { font-family: var(--display); font-size: 22px; letter-spacing: -0.02em; line-height: 1.15; }
  .kk-tile em { font-style: normal; color: var(--copper); font-weight: 600; margin-top: auto; }

  .kk-platform h2 { font-size: clamp(34px, 4.4vw, 56px); }
  .kk-platform p { color: #cfccc4; }

  .kk-guarantee h2 { max-width: 20ch; font-size: clamp(32px, 4.4vw, 58px); text-transform: uppercase; letter-spacing: -0.04em; margin: 10px 0 36px; }
  .kk-guarantee .split { gap: 32px; }

  .kk-book-cover { aspect-ratio: 3 / 4; max-width: 320px; display: flex; flex-direction: column; justify-content: flex-end; gap: 6px; padding: 28px; border-radius: 14px; border: 1px solid rgba(255, 255, 255, 0.14); background: linear-gradient(160deg, #1d1d20, #0a0a0b 70%); box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.9); }
  .kk-book-cover span { font-family: var(--mono); font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--copper); }
  .kk-book-cover strong { font-family: var(--display); font-size: 34px; line-height: 1; letter-spacing: -0.03em; }
  .kk-book-cover small { color: var(--muted); }

  @media (max-width: 900px) {
    .kk-paths, .kk-offers, .kk-grid { grid-template-columns: 1fr; }
    .kk-stats { grid-template-columns: 1fr 1fr; }
    .kk-capture { flex-direction: column; border-radius: 20px; }
    .kk-capture input { padding: 14px 16px; }
    .kk-capture .button { width: 100%; }
  }
</style>
