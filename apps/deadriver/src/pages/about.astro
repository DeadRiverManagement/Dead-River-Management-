---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqList from '../components/FaqList.astro';
import { business, homeAboutDisambiguator, TEAM_SUPPORT_LINE, GUARANTEE_LINE, deadRiverCompanyFaq, fuelSellFaq, fuelSearchFaq, guaranteeFaq } from '../data/site';
import { faqPage } from '../lib/schema';

const aboutFaq = [deadRiverCompanyFaq, fuelSellFaq, fuelSearchFaq, guaranteeFaq];
const schema = [
  { '@context': 'https://schema.org', '@type': 'AboutPage', '@id': `${business.url}/about#webpage`, url: `${business.url}/about`, name: 'About Dead River Management | El Paso', about: { '@id': `${business.url}/#organization` } },
  { '@context': 'https://schema.org', '@type': 'Person', name: business.founder, jobTitle: business.founderTitle, worksFor: { '@id': `${business.url}/#organization` }, description: business.founderBio, image: `${business.url}/images/brandon-aubey.jpg` },
  faqPage(aboutFaq),
  { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: `${business.url}/` }, { '@type': 'ListItem', position: 2, name: 'About', item: `${business.url}/about` }] },
];
---
<Base schema={schema}>
  <section class="ihero" id="top">
    <div class="wrap">
      <nav class="crumb reveal-up" data-d="0" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><b>About</b></nav>
      <p class="eyebrow reveal-up" data-d="60" style="display:flex;align-items:center;gap:12px"><span style="width:28px;height:1px;background:var(--copper);display:inline-block"></span>About Dead River Management</p>
      <h1>
        <span class="line"><span>We get you leads.</span></span>
        <span class="line"><span class="mark">El Paso home services.</span></span>
      </h1>
      <p class="lede reveal-up" data-d="420">{homeAboutDisambiguator}</p>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="founder">
        <div class="founder-img">
          <picture>
          <source type="image/avif" srcset="/images/brandon-aubey-440.avif 440w, /images/brandon-aubey-880.avif 880w" sizes="(max-width:900px) 100vw, 440px" />
          <source type="image/webp" srcset="/images/brandon-aubey-440.webp 440w, /images/brandon-aubey-880.webp 880w" sizes="(max-width:900px) 100vw, 440px" />
          <img src="/images/brandon-aubey.jpg" srcset="/images/brandon-aubey-440.jpg 440w, /images/brandon-aubey-880.jpg 880w" sizes="(max-width:900px) 100vw, 440px" width="880" height="1100" alt="Brandon Aubey, founder of Dead River Management" title="Brandon Aubey, founder of Dead River Management" loading="eager" fetchpriority="high" decoding="async" onerror="this.closest('.founder-img').style.display='none'" />
        </picture>
          <div class="cap"><b>{business.founder}</b><span>{business.founderTitle}, El Paso</span></div>
        </div>
        <div class="io" style="--d:120ms">
          <p class="eyebrow" style="margin-bottom:14px">Why we do it this way</p>
          <h2 style="margin-bottom:18px">Clicks don’t pay the bills. <span class="mark">Booked jobs do.</span></h2>
          <div class="prose">
            <p>Brandon started Dead River after ten years helping local businesses get more jobs, and watching too many of them pay for clicks while the phone went to voice mail.</p>
            <p>So we built a small team around the part that makes money: the call gets answered, the job gets booked, and you can see it. See our plans and prices. There are three of us. The person who sets you up is the person who picks up when you call.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="section-head io">
        <p class="eyebrow">What we believe</p>
        <h2>Three rules <span class="mark">we don’t bend.</span></h2>
      </div>
      <div class="why">
        <div class="io hot"><h3>Booked jobs</h3><p>We track calls answered and jobs booked. Not likes.</p></div>
        <div class="io" style="--d:80ms"><h3>Speed</h3><p>Most people will not leave a voice mail. They call the next name. We text back in seconds.</p></div>
        <div class="io" style="--d:160ms"><h3>See our plans and prices.</h3><p>Every plan has a number, except the full plan. That one shows the price after a short form and a short video. {GUARANTEE_LINE}</p></div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="panel">
          <p class="eyebrow" style="margin-bottom:14px">How we work</p>
          <p class="lede" style="margin:0">We are three people in El Paso. {TEAM_SUPPORT_LINE} Not Dead River Company (fuel).</p>
        </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="section-head io" style="margin-bottom:18px">
        <p class="eyebrow">Who we work with</p>
        <h2 style="font-size:clamp(24px,2.6vw,34px)">Home service businesses in El Paso and the borderland.</h2>
        <p class="lede">Roofers. Plumbers. HVAC. Then anyone whose next job depends on a phone call.</p>
      </div>
      <div class="rel io">
        <a href="/plumber-marketing-el-paso">Plumbers</a>
        <a href="/hvac-marketing-el-paso">HVAC</a>
        <a href="/roofing-marketing-el-paso">Roofers</a>
        <a href="/electrician-marketing-el-paso">Electricians</a>
        <a href="/">Every trade</a>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="section-head io">
        <p class="eyebrow">Questions</p>
        <h2>Straight answers.</h2>
      </div>
      <FaqList items={aboutFaq} />
    </div>
  </section>

  <CtaBand heading="Ready to get more jobs?" mark="Call us." text="You’ll get one of the three of us, not a call center." primaryLabel="See plans and prices" primaryHref="/plans" />
</Base>
