---
import PlanPage from '../components/PlanPage.astro';
---
<PlanPage
  slug="website"
  how={[
    { h: 'Add your card', p: 'Use secure checkout before we build. You pay $0 today. Check the billing details at checkout.' },
    { h: 'Tell us about your business', p: 'What you do. Where you work. The jobs you want. We build your site around that.' },
    { h: 'Review your site', p: 'We review the site with you and make fixes during the build and review period.' },
    { h: 'We host it and keep it up', p: 'After the build and review period, you pay $97 a month with a 12-month commitment.' },
  ]}
  faqs={[
    { q: 'Is the site really $0 to build?', a: 'Yes. The design fee is $0. Add your card before we build. You pay $0 today, then $97 a month after the build and review period. A 12-month commitment applies.' },
    { q: 'Is there a setup fee?', a: 'No. The website has no setup fee.' },
    { q: 'Can you redo my old site?', a: 'Yes. New site or a better one. Same price.' },
    { q: 'Does this include ads?', a: 'No. Ads are in Paid Growth.' },
    { q: 'Does this answer the phone?', a: 'No. Add Front Desk Complete if you want AI to answer calls.' },
    { q: 'How long do I sign up for?', a: 'The Website plan has a 12-month commitment at $97 a month. Monthly billing starts after the build and review period.' },
    { q: 'Does the 30 leads in 60 days promise apply?', a: 'No. Only Dead River Complete has this. 30 leads in 60 days or we work for free until we get them.' },
    { q: 'How do I start?', a: 'Add your card in secure checkout before we start work. You pay $0 today. After the build and review period, you pay $97 a month with a 12-month commitment. We use this time to build your site, review it with you, and make fixes. Check the billing details at checkout.' },
  ]}
/>
