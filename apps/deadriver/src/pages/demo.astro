---
import Growth from '../layouts/Growth.astro';
import Hero from '../components/growth/Hero.astro';
import InquiryForm from '../components/growth/InquiryForm.astro';
import { demandIntelligence as di } from '../data/growth';
---

<Growth
  title="Book a Demand Intelligence demo"
  description="See Demand Intelligence on your market. Define the market, read purchase-intent signals, and build an audience your team can act on."
>
  <Hero
    eyebrow="Dead River Demand Intelligence"
    title="See it with your own market."
    intro="A guided walkthrough where we define the market you sell into, business or consumer, surface the people and businesses showing relevant buying signals, build a first audience, and show how your team would act on it."
  />
  <section class="section wrap tool-layout">
    <InquiryForm kind="demo" heading="Book a Demo." />
    <aside class="result-card">
      <p class="eyebrow">Your demo agenda</p>
      <h2>From a prospecting question to a working audience.</h2>
      <ul class="check-list">
        <li>Your market: B2B accounts, consumer audiences, or both.</li>
        <li>
          The purchase-intent signals and filters relevant to your category.
        </li>
        <li>Building and prioritizing a first audience.</li>
        <li>How your sales or marketing team puts it to work.</li>
      </ul>
      <p>
        Scope and fees are confirmed on a demo based on your market and use
        case. No public price is listed here.
      </p>
      <a class="text-link" href="/demand-intelligence#platform">
        Back to the platform →
      </a>
    </aside>
  </section>
</Growth>
