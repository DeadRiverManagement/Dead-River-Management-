---
import Growth from '../layouts/Growth.astro';
import Hero from '../components/growth/Hero.astro';
import Arrow from '../components/growth/Arrow.astro';
import { faqPage } from '../lib/schema';

const faqs = [
  {
    q: 'What is Demand Flow?',
    a: "Demand Flow is Dead River Management's live public offer for accepted businesses: $50,000 in new revenue in 45-60 days after the system goes live. If we miss, service fees are refunded plus $500. Ad spend is not refunded.",
  },
  {
    q: 'Is ad spend refunded if you miss?',
    a: 'No. Ad spend is paid to the advertising platforms and is not refunded. The miss clause covers service fees plus $500 only. Your signed agreement controls.',
  },
  {
    q: 'Is Demand Flow open to every business?',
    a: 'No. It is for accepted businesses with a signed agreement. If we do not think we can hit the number, we say so and do not offer the guarantee.',
  },
  {
    q: 'Is the old 30 leads in 60 days guarantee still sold?',
    a: 'No. Lead-count and work-for-free style offers are not live public offers. Demand Flow is current. Terms updated September 29, 2026.',
  },
  {
    q: 'How is Demand Intelligence different?',
    a: 'Demand Intelligence is a separate product for purchase intent data and audiences. It is not the Demand Flow revenue guarantee. Scope is confirmed on a demo. See the Demand Intelligence page.',
  },
  {
    q: 'How can you make this offer?',
    a: 'We first assess demand in your market, your offer, your capacity and your ad budget. Demand Intelligence identifies active buyers. Demand Flow connects targeted campaigns, fast replies, booking and follow-up to sales. If we do not think we can reach the goal, we do not offer the guarantee.',
  },
  {
    q: 'What revenue counts?',
    a: 'Revenue from new customers acquired through the Demand Flow system we build for you. Leads and outcomes are tracked in your CRM and checked against closed jobs or invoices. Existing customer revenue and work won outside the system do not count.',
  },
  {
    q: 'What does my team need to do?',
    a: 'Provide account access, approvals, the agreed ad budget and revenue reporting information, and answer the leads the system delivers. Delays pause the clock. Turning off campaigns, cutting the agreed budget or not answering leads ends the guarantee. Your signed agreement controls.',
  },
  {
    q: 'What does it cost and when does it start?',
    a: 'We review the scope, investment and ad budget on your strategy call. The clock starts when your Demand Flow system goes live. Your agreement sets the exact deadline within the 45-to-60-day window.',
  },
  {
    q: 'Where do I start?',
    a: 'Book a strategy call, or call (915) 228-3054. Read the full guarantee terms.',
  },
];
const url = 'https://www.deadrivermanagement.com/demand-flow';
const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${url}#service`,
  name: 'Demand Flow',
  serviceType: 'Demand generation and revenue system',
  url,
  description: 'Demand Flow is the system that creates, captures, and converts demand. Accepted businesses get $50,000 in new revenue in 45-60 days, or service fees refunded plus $500. Ad spend is not refunded.',
  provider: { '@id': 'https://www.deadrivermanagement.com/#organization' },
  areaServed: { '@type': 'Country', name: 'United States' },
  audience: { '@type': 'BusinessAudience', name: 'Accepted businesses' },
  offers: {
    '@type': 'Offer',
    name: 'Demand Flow guarantee',
    url: 'https://www.deadrivermanagement.com/legal/guarantee',
    description: '$50,000 in new revenue in 45-60 days, or service fees refunded plus $500. Ad spend is not refunded. Accepted businesses only.',
  },
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.deadrivermanagement.com/' },
    { '@type': 'ListItem', position: 2, name: 'Demand Flow', item: url },
  ],
};
---

<Growth
  title="Demand Flow Guarantee | Dead River Management"
  description="Demand Flow finds buyers ready now and turns them into revenue: $50,000 in new revenue in 45-60 days, or service fees refunded plus $500."
  schema={[serviceLd, faqPage(faqs), breadcrumbLd]}
>
  <Hero
    scene="liquid"
    eyebrow="Demand Flow · The guarantee"
    title="Demand Flow: $50,000 in new revenue in 45-60 days."
    intro="Dead River Management builds the system that creates, captures, and converts demand. For accepted businesses, the public offer is Demand Flow: hit $50,000 in new revenue in 45-60 days, or service fees are refunded plus $500. Ad spend is not refunded."
  >
    <div class="button-row" data-rise>
      <a class="button" href="/book">Book a strategy call <Arrow /></a>
      <a class="text-link" href="tel:+19152283054">Call (915) 228-3054 <Arrow /></a>
    </div>
  </Hero>

  <section class="section wrap" id="fit">
    <div class="section-head">
      <div>
        <p class="eyebrow">This is for you if</p>
        <h2>You need customers. Not just more clicks.</h2>
        <p class="intro">If these sound familiar, Demand Flow connects the missing steps.</p>
      </div>
    </div>
    <div class="steps home-steps df-pains">
      {[
        ['Reaching the wrong people', 'Your ads reach a broad audience, but too few people are ready to buy.'],
        ['Paying for clicks', 'People visit your site and leave before taking the next step.'],
        ['Unpredictable sales', 'You can take on more customers, but new business is inconsistent.'],
        ['Leads go quiet', 'Someone asks a question, then disappears before making a decision.'],
        ['Follow-up gets missed', 'Slow replies and missed follow-up let interested buyers slip away.'],
        ['No clear picture', 'You can see clicks and leads, but cannot tell which ones became revenue.'],
      ].map(([title, body]) => (
        <article>
          <h3>{title}</h3>
          <p>{body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section soft" id="intelligence">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Demand Intelligence</p>
        <h2>Start with people already looking to buy.</h2>
        <p class="intro">People search, read and compare before they buy. Demand Intelligence uses that activity, called purchase intent data, to identify people looking for what you sell.</p>
        <a class="text-link" href="/demand-intelligence">Explore Demand Intelligence <Arrow /></a>
      </div>
      <ul class="check-list df-checks">
        <li><strong>Find the demand.</strong> Identify people actively researching your product or service.</li>
        <li><strong>Keep it fresh.</strong> Use purchase signals from the last 24 to 48 hours.</li>
        <li><strong>Reach those buyers.</strong> Focus your ads and email on an audience already showing interest.</li>
        <li><strong>Connect the next steps.</strong> Demand Flow turns that audience into inquiries, bookings and paying customers.</li>
      </ul>
    </div>
  </section>

  <section class="section df-mechanism" id="how">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">How Demand Flow works</p>
          <h2>Four stages. One connected system.</h2>
          <p class="intro">Demand Intelligence tells us who is shopping. Demand Flow handles what happens next.</p>
        </div>
      </div>
    </div>
    <div class="flow-stage" data-flow>
      <div class="wrap flow-track">
        <svg class="flow-line" viewBox="0 0 1200 220" preserveAspectRatio="none" aria-hidden="true">
          <path class="flow-glow flow-draw" d="M-20 170C180 175 230 40 420 60C600 80 560 190 760 150C930 115 980 20 1220 50" fill="none" stroke-linecap="round" />
          <path class="flow-path flow-draw" d="M-20 170C180 175 230 40 420 60C600 80 560 190 760 150C930 115 980 20 1220 50" fill="none" stroke-linecap="round" />
        </svg>
        <div class="steps home-steps flow-steps">
          {[
            ['Target', 'Purchase intent data finds the people researching what you sell right now, matched to real business and consumer records.', 'Research activity → Buyer signals'],
            ['Create demand', 'Put your offer in front of active buyers through Facebook, Instagram, Google and email.', 'Buyer signals → Your offer'],
            ['Capture demand', 'A focused landing page, quick text-back and booking link turn interest into an inquiry your team can act on.', 'Inquiry → Reply → Booking'],
            ['Convert demand', 'Reminders, follow-up and weekly improvements help turn those inquiries into booked work and paid invoices.', 'Follow-up → Sale → Revenue'],
          ].map(([title, body, chain], i) => (
            <article data-flow-step>
              <span class="number">Stage {i + 1}</span>
              <h3>{title}</h3>
              <p>{body}</p>
              <small class="df-chain">{chain}</small>
            </article>
          ))}
        </div>
      </div>
    </div>
    <div class="wrap">
      <p class="df-track">We track leads and sales in your CRM and check them against closed jobs or invoices. You can see where the revenue comes from.</p>
    </div>
  </section>

  <section class="section soft band-dark" id="included">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Our offering</p>
        <h2>What you will get.</h2>
        <p class="intro">Everything connects the right audience to new revenue.</p>
        <div class="button-row">
          <a class="button" href="/book">Book a strategy call <Arrow /></a>
        </div>
      </div>
      <ul class="check-list df-checks">
        <li>Demand Intelligence to identify people actively shopping for what you sell.</li>
        <li>Targeted campaigns across Facebook, Instagram, Google and email.</li>
        <li>Landing pages and booking links that give buyers a clear next step.</li>
        <li>Fast replies, reminders and follow-up so interested prospects are not forgotten.</li>
        <li>CRM tracking from the first inquiry through closed jobs and paid invoices.</li>
        <li>Weekly campaign improvements and a written revenue goal for accepted businesses.</li>
      </ul>
    </div>
  </section>

  <section class="section wrap" id="guarantee">
    <div class="section-head">
      <div>
        <p class="eyebrow">The guarantee, in plain terms</p>
        <h2>What you get</h2>
      </div>
    </div>
    <div class="feature-grid">
      <article class="feature-panel">
        <h3>Booked new revenue</h3>
        <p>
          Booked new revenue from the Demand Flow system: ads, landing pages,
          follow-up, and booking.
        </p>
        <p>
          <a class="inline-link" href="/solutions">See how the system connects</a>.
        </p>
      </article>
      <article class="feature-panel">
        <h3>What happens if we miss</h3>
        <p>
          Service fees are refunded plus $500. Ad spend is not refunded. Your
          signed agreement controls.
        </p>
        <p>
          <a class="inline-link" href="/legal/guarantee">Read the guarantee terms</a>.
        </p>
      </article>
      <article class="feature-panel">
        <h3>Accepted businesses only</h3>
        <p>We decline when we do not believe we can hit the number.</p>
      </article>
      <article class="feature-panel">
        <h3>Not the old lead-count offers</h3>
        <p>30-in-60 and work-for-free offers are not live public offers.</p>
      </article>
    </div>
  </section>

  <section class="section soft" id="results">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Proven results</p>
          <h2>Results from businesses we’ve worked with.</h2>
          <p class="intro">Real businesses, different markets. Each case study shows its own results and timeframe; your outcome will depend on your business.</p>
        </div>
        <a class="text-link" href="/work">View all case studies <Arrow /></a>
      </div>
      <div class="steps home-steps df-results">
        {[
          ['Gonzalez & Sons Roofing', 'From 2 to 8 roofs a month in 6 months', ['2 to 8 roofs per month', '$50K to $200K monthly revenue', '6-month case study'], '/work/gonzalez-and-sons-roofing'],
          ['The Pipe Whisperers', 'From $60K to $250K in annual revenue', ['About $60K annual revenue before', 'About $250K annual revenue after', '24-month case study'], '/work/the-pipe-whisperers'],
          ['Wicked Logistics', 'From 1 to 2 weekly inquiries to 5 to 6 daily', ['1 to 2 inquiries per week before', '5 to 6 inquiries per day within 3 months', 'One contract valued at $1.2M per year'], '/work/wicked-logistics'],
        ].map(([name, headline, facts, href]) => (
          <article>
            <span class="number">{name}</span>
            <h3>{headline}</h3>
            <ul class="check-list">{facts.map((f) => <li>{f}</li>)}</ul>
            <a class="text-link" href={href}>Read the case study <Arrow /></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section soft">
    <div class="wrap split">
      <div>
        <p class="eyebrow">A different product</p>
        <h2>Demand Intelligence is separate.</h2>
      </div>
      <div>
        <p>
          Demand Intelligence is purchase intent data and audiences. It is not
          the Demand Flow revenue guarantee. Scope is confirmed on a demo. No
          public price is listed here.
        </p>
        <a class="text-link" href="/demand-intelligence">
          Explore Demand Intelligence <Arrow />
        </a>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">FAQ</p>
        <h2>Demand Flow questions</h2>
      </div>
    </div>
    <div class="faq">
      {faqs.map((item) => (
        <details>
          <summary>{item.q}</summary>
          {item.q === 'Where do I start?' ? (
            <p>Book a <a class="inline-link" href="/book">strategy call</a>, or call (915) 228-3054. Read the full <a class="inline-link" href="/legal/guarantee">guarantee terms</a>.</p>
          ) : (
            <p>{item.a}</p>
          )}
        </details>
      ))}
    </div>
  </section>

  <section class="section soft band-dark" id="book">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Next step</p>
        <h2>See if your business qualifies.</h2>
        <p class="intro">Your market. Your numbers. A clear plan. Here is what we’ll review together.</p>
        <ul class="check-list df-checks">
          <li>The live demand for your product or service in your market.</li>
          <li>Your customer value, capacity and path from inquiry to sale.</li>
          <li>Whether your business qualifies for the $50,000 Demand Flow guarantee.</li>
        </ul>
      </div>
      <div class="stack">
        <p>
          Dead River Management is headquartered in El Paso, Texas, and works
          with accepted businesses nationwide. Call (915) 228-3054 or book a
          strategy call.
        </p>
        <div class="button-row">
          <a class="button" href="/book">Book a strategy call <Arrow /></a>
          <a class="text-link" href="tel:+19152283054">Call (915) 228-3054 <Arrow /></a>
        </div>
        <p>
          <a class="inline-link" href="/work">See the work</a>
          {' · '}
          <a class="inline-link" href="/company">About the company</a>
        </p>
      </div>
    </div>
  </section>
</Growth>

<style>
  .df-pains,
  .df-results {
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  .df-results .number {
    color: var(--muted);
  }
  .df-results .check-list li {
    font-size: 14px;
    padding-block: 6px;
  }
  .df-results .text-link {
    margin-top: 18px;
  }
  .df-checks li {
    font-size: 16px;
    padding-block: 10px;
  }
  .df-checks strong {
    color: var(--ink);
  }
  .df-chain {
    display: block;
    margin-top: 18px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--copper);
  }
  .df-track {
    max-width: 720px;
    margin-top: 48px;
    font-size: 17px;
  }
  @media (max-width: 1100px) {
    .df-pains,
    .df-results {
      grid-template-columns: 1fr;
    }
  }
</style>

