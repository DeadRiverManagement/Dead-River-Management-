---
import HeroScene from '../../components/growth/HeroScene.astro';
// Service pages (/services/facebook-ads and so on), in the same structure as
// the industry pages: hero, problem, offer, what we build, results, fit, FAQ,
// final call. The offer section routes every visitor to an industry page,
// which is where the guaranteed offers and prices live.
import Growth from '../../layouts/Growth.astro';
import Arrow from '../../components/growth/Arrow.astro';
import ServiceLinks from '../../components/growth/ServiceLinks.astro';
import BuildSheet from '../../components/growth/BuildSheet.astro';
import { faqPage } from '../../lib/schema';
import { linkify } from '../../lib/linkify';
import { servicePages, demandFlowOffer, elPasoAreas, areaHrefs } from '../../data/service-pages';
import { industryPages } from '../../data/industry-pages';
import type { ServicePageData } from '../../data/service-pages';

export function getStaticPaths() {
  return servicePages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props as { page: ServicePageData };
const here = `/services/${page.slug}`;
const bookHref = '/book';
const cta = 'Book a Strategy Call';
const others = servicePages.filter((s) => s.slug !== page.slug);
// Guides and tools only; service pages already appear in the channel index below.
const guides = page.related.filter((r) => !r.href.startsWith('/services/'));
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: page.name,
  serviceType: page.name,
  description: page.description,
  provider: { '@id': 'https://www.deadrivermanagement.com/#organization' },
  areaServed: [
    { '@type': 'City', name: 'El Paso', containedInPlace: { '@type': 'State', name: 'Texas' } },
    { '@type': 'Country', name: 'United States' },
  ],
  url: `https://www.deadrivermanagement.com/services/${page.slug}`,
};
---

<Growth ogImage={`/images/og/services/${page.slug}.jpg`}
  title={page.title}
  description={page.description}
  schema={[serviceSchema, faqPage(page.faqs)]}
>
  <section class="has-scene page-hero wrap ms-hero">
  <HeroScene />
    <p class="eyebrow">{page.eyebrow}</p>
    <h1>{page.headline}</h1>
    <p class="ms-sub">{page.sub}</p>
    <p class="intro" set:html={linkify(page.intro, here)} />
    <div class="button-row">
      <a class="button" href={bookHref} data-cta="hero">{cta} <Arrow /></a>
      <a class="button secondary" href="#offer" data-cta="hero-offer">See the offers</a>
    </div>
    <BuildSheet title={page.name} rows={page.built.map(([t]) => t)} caption="Book a strategy call" />
  </section>

  <section class="section soft">
    <div class="wrap">
      <p class="eyebrow">The problem</p>
      <h2>{page.problemHeading}</h2>
      <div class="ms-grid">
        {page.problems.map(([title, body]) => (
          <article class="feature-panel">
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section wrap" id="offer">
    <div class="ms-offer">
      <p class="eyebrow">The offer</p>
      <h2>One guarantee, whatever you sell.</h2>
      <p>{page.offerLead}</p>
    </div>
    <div class="sv-offers">
      <a class="feature-panel sv-offer" href={demandFlowOffer.href} data-cta="offer-demand-flow">
        <p class="mini-label">{demandFlowOffer.name}</p>
        <h3>{demandFlowOffer.offer}</h3>
        <p>{demandFlowOffer.from}</p>
        <span class="text-link">See if you qualify <Arrow /></span>
      </a>
    </div>
    <p class="small ms-note">
      Want {page.name} on its own? <a class="inline-link" href={bookHref}>Book a call</a> and we'll quote it separately.
    </p>
  </section>

  <section class="section soft">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">What we build</p>
          <h2>{page.builtHeading}</h2>
        </div>
      </div>
      <div class="ms-grid">
        {page.built.map(([title, body]) => (
          <article class="feature-panel">
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {page.longform && (
  <section class="section wrap sv-longform">
    {page.longform.map((b) => (
      <div class="sv-block">
        <h2>{b.heading}</h2>
        {b.paragraphs.map((p) => <p set:html={linkify(p, here)} />)}
      </div>
    ))}
    {page.compare && (
      <div class="sv-block">
        <h2>{page.compare.heading}</h2>
        <div class="table-scroll">
          <table class="comparison-table sv-compare">
            <thead><tr>{page.compare.columns.map((c) => <th scope="col">{c}</th>)}</tr></thead>
            <tbody>
              {page.compare.rows.map(([k, a, b]) => (
                <tr><th scope="row">{k}</th><td>{a}</td><td>{b}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}
  </section>
  )}

  {page.proof.length > 0 && (
  <section class="section wrap">
    <p class="eyebrow">Results</p>
    <h2>{page.proofHeading}</h2>
    <div class="ms-plans">
      {page.proof.map((p) => (
        <article class="feature-panel">
          <p class="mini-label">{p.label}</p>
          <p class="sv-proof">{p.text}</p>
          <a class="text-link" href={p.href}>{p.linkText} <Arrow /></a>
        </article>
      ))}
    </div>
  </section>
  )}

  <section class="section soft">
    <div class="wrap">
      <p class="eyebrow">Who it's for</p>
      <h2>Built for service businesses, in El Paso and nationwide</h2>
      <div class="split ms-two">
        <article class="feature-panel">
          <h3>A good fit</h3>
          <ul class="check-list">
            {page.fit.map((f) => <li>{f}</li>)}
          </ul>
          <p class="small sv-industries">By trade:{industryPages.map((p, i) => (
            <>{i > 0 && ','}<a class="inline-link" href={'/industries/' + p.slug}>{p.name}</a></>
          ))}</p>
        </article>
        <article class="feature-panel">
          <h3>In El Paso</h3>
          <p>{page.elPaso}</p>
          <ul class="sv-areas" aria-label="Areas we serve">
            {elPasoAreas.map((a) => <li>{areaHrefs[a] ? <a href={areaHrefs[a]}>{a}</a> : a}</li>)}
          </ul>
          <a class="text-link" href="/locations/el-paso">Marketing in El Paso <Arrow /></a>
        </article>
      </div>
      <ServiceLinks
        label="Keep reading"
        heading="The other channels we run."
        links={others.map((s) => ({ label: s.name, href: '/services/' + s.slug, blurb: s.blurb }))}
      >
        {guides.length > 0 && (
          <p class="also">Also read:{guides.map((r, i) => (
            <>{i > 0 && ','}<a class="inline-link" href={r.href}>{r.label}</a></>
          ))}</p>
        )}
      </ServiceLinks>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head"><div><p class="eyebrow">FAQ</p><h2>Common questions.</h2></div></div>
    <div class="faq">
      {page.faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p set:html={linkify(f.a, here)} />
        </details>
      ))}
    </div>
  </section>

  <section class="section wrap ms-close">
    <div class="ms-offer">
      <p class="eyebrow">Next step</p>
      <h2>Ready to see what {page.name} can book for you?</h2>
      <p>
        Book a short strategy call. We'll look at your market and what you run
        today, then tell you which offer fits. If we aren't a fit, we'll say so.
      </p>
      <div class="button-row">
        <a class="button ms-invert" href={bookHref} data-cta="final">{cta} <Arrow /></a>
      </div>
    </div>
  </section>
</Growth>

<script>
  import { track } from '../../scripts/growth-shell.js';
  document.querySelectorAll<HTMLAnchorElement>('a[data-cta]').forEach((a) =>
    a.addEventListener('click', () =>
      track('service_cta_click', { cta: a.dataset.cta, path: location.pathname }),
    ),
  );
</script>

<style>
  .ms-hero h1 { max-width: 1000px; }
  .ms-sub { font-family: var(--display); font-size: clamp(20px, 2.2vw, 26px); line-height: 1.35; color: var(--ink); max-width: 820px; margin: 18px 0 12px; }
  .ms-two { align-items: start; margin-top: 12px; }
  .ms-two > * { min-width: 0; }
  .ms-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-top: 12px; }
  .ms-grid > * { min-width: 0; }
  .ms-grid h3, .ms-two h3, .ms-plans h3, .sv-offer h3 { font-size: 21px; margin-bottom: 8px; }
  .ms-plans { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin-top: 12px; }
  .ms-plans > * { min-width: 0; display: flex; flex-direction: column; align-items: flex-start; }
  .ms-plans .text-link { margin-top: auto; }
  .ms-note { margin-top: 14px; }
  .sv-industries { margin-top: 14px; }
  .sv-industries a { margin-left: 6px; }
  .sv-offers { display: grid; grid-template-columns: minmax(0, 560px); gap: 16px; margin-top: 24px; }
  .sv-offer { min-width: 0; display: flex; flex-direction: column; padding: 24px; }
  .sv-offer p:not(.mini-label) { color: var(--muted); font-size: 15px; margin-bottom: 14px; }
  .sv-offer .text-link { margin-top: auto; font-size: 14px; }
  .sv-proof { font-size: 17px; color: var(--ink); margin-bottom: 16px; }
  .service-links { margin-top: 28px; }
  .sv-areas { list-style: none; padding: 0; margin: 14px 0 16px; display: flex; flex-wrap: wrap; gap: 6px; }
  .sv-areas a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  .sv-areas li { font-size: 13px; padding: 4px 10px; border: 1px solid var(--line); border-radius: 999px; color: var(--ink); background: var(--paper); }
  .ms-close { padding-bottom: 72px; }
  .sv-longform { max-width: 860px; }
  .sv-block + .sv-block { margin-top: 40px; }
  .sv-block h2 { font-size: clamp(24px, 2.6vw, 32px); margin-bottom: 14px; }
  .sv-block p { color: var(--muted); font-size: 17px; line-height: 1.6; margin-bottom: 14px; }
  .sv-compare { min-width: 640px; }
  .sv-compare th, .sv-compare td { padding: 14px 16px; }
  .sv-compare tr > :nth-child(3) { background: #e8eedf; }
  @media (max-width: 1100px) {
  }
  @media (max-width: 1000px) {
    .ms-grid, .ms-plans { grid-template-columns: 1fr; }
  }
  @media (max-width: 700px) {
    .sv-offers { grid-template-columns: 1fr; }
  }
  @media (max-width: 620px) {
    .ms-offer { padding: 28px 20px; }
  }
</style>
