---
import PlanPage from '../components/PlanPage.astro';
import VoiceDemoCta from '../components/VoiceDemoCta.astro';
import { voiceDemoFaq } from '../data/site';
---
<PlanPage
  slug="front-desk-complete"
  how={[
    { h: 'The phone rings', p: 'Day or night. You may be on a roof.' },
    { h: 'AI picks up', p: 'It answers with your business name.' },
    { h: 'We book or transfer', p: 'If they need you now, we send the call.' },
    { h: 'You do the work', p: 'The job is on the book.' },
  ]}
  faqs={[
    { q: 'What is Front Desk Complete?', a: 'We answer the phone day and night. We book or transfer the call.' },
    { q: 'Is this a person or a bot?', a: 'AI answers your calls. It books a time or sends the call to your team. This is not a live receptionist service.' },
    voiceDemoFaq,
    { q: 'Does this include texts and chat?', a: 'Yes. Texts and chat are covered too.' },
    { q: 'Is there a setup fee?', a: 'No. Pay your first month to start.' },
    { q: 'How long do I sign up for?', a: 'No. Front Desk Complete is month to month.' },
    { q: 'Does the 30 leads in 60 days promise apply?', a: 'No. Only Dead River Complete has this. 30 leads in 60 days or we work for free until we get them.' },
    { q: 'What about call cost?', a: 'Calls and AI use are billed at what they cost us. We do not add extra.' },
  ]}
>
  <VoiceDemoCta slot="voice-demo" />
</PlanPage>
