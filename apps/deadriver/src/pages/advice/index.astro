---
import Growth from '../../layouts/Growth.astro';
import Hero from '../../components/growth/Hero.astro';
import Arrow from '../../components/growth/Arrow.astro';
import AdviceCta from '../../components/growth/AdviceCta.astro';
import { adviceCards, hub, hubSchema } from '../../data/advice-wave-b';
---

<Growth
  title={hub.title}
  description={hub.description}
  schema={hubSchema()}
  robots="index, follow"
>
  <Hero eyebrow={hub.eyebrow} title={hub.h1} intro={hub.intro} />
  <section class="section wrap">
    <div class="resource-grid">
      {adviceCards.map((post) => (
        <a class="resource-card" href={post.path}>
          <span class="mini-label">Advice</span>
          <h3>{post.cardTitle}</h3>
          <p>{post.dek}</p>
          <span class="card-bottom">
            Read the article <Arrow />
          </span>
        </a>
      ))}
    </div>
  </section>
  <AdviceCta headline={hub.ctaHeadline} body={hub.ctaBody}>
    <p class="prose">
      <a href="/resources">Resources</a>·<a href="/solutions">Solutions</a>
    </p>
  </AdviceCta>
</Growth>
