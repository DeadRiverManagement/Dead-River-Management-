---
import PlanPage from '../components/PlanPage.astro';
---
<PlanPage
  slug="essentials"
  how={[
    { h: 'A call comes in', p: 'You are on a job. You miss it.' },
    { h: 'We text back', p: 'The person gets a text from your business in seconds.' },
    { h: 'You keep the thread', p: 'You can jump in any time.' },
    { h: 'The job stays yours', p: 'They do not call the next name.' },
  ]}
  faqs={[
    { q: 'What is Essentials?', a: 'Never miss a job because you missed a call. We text back. No chat. No voice AI.' },
    { q: 'Does this answer the phone out loud?', a: 'No. Essentials texts back. Front Desk Complete answers the phone day and night.' },
    { q: 'Does this book the job?', a: 'No. Front Desk AI books jobs from texts and chat. Complete can book or transfer a live call.' },
    { q: 'Is there a setup fee?', a: 'No. Pay your first month to start.' },
    { q: 'How long do I sign up for?', a: 'No. Essentials is month to month.' },
    { q: 'Does the 30 leads in 60 days promise apply?', a: 'No. Only Dead River Complete has this. 30 leads in 60 days or we work for free until we get them.' },
    { q: 'What about text cost?', a: 'Texts are billed at what they cost us. We do not add extra.' },
  ]}
/>
