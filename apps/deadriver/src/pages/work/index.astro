---
import Growth from '../../layouts/Growth.astro';
import Arrow from '../../components/growth/Arrow.astro';
import { work } from '../../data/growth-work';

// Biggest wins first; Total Auto Repair is featured above the list.
const order = [
  'the-pipe-whisperers',
  'gonzalez-and-sons-roofing',
  'wicked-logistics',
  'parcel-management-group',
  'only-fish',
];
const extra: Record<string, { filter: string; quote?: string; owner?: string }> = {
  'the-pipe-whisperers': {
    filter: 'Plumbing',
    owner: 'Arron',
    quote:
      'We went from barely surviving to turning down work. That’s the difference Dead River made.',
  },
  'gonzalez-and-sons-roofing': {
    filter: 'Roofing',
    owner: 'Gonzalez',
    quote: 'We used to pray for leads. Now we have more than we can handle.',
  },
  'wicked-logistics': {
    filter: 'Freight/Logistics',
    owner: 'JR',
    quote: 'Dead River turned our website into a lead generation machine.',
  },
  'parcel-management-group': { filter: 'Freight/Logistics' },
  'only-fish': { filter: 'Branding' },
};
const more = order.map((slug) => work.find((w) => w.slug === slug)!);
const featured = work.find((w) => w.slug === 'total-auto-repair')!;
const filters = [
  'Auto Repair',
  'Roofing',
  'Plumbing',
  'Freight/Logistics',
  'Branding',
];
---

<Growth
  title="Client Results: $20K to $100K Months"
  description="Real client results: Total Auto Repair went from $20K to $100K a month, The Pipe Whisperers from $60K to $250K a year, and Wicked Logistics to 5-6 leads a day."
>
  <section class="page-hero wrap">
    <p class="eyebrow">Client Results &amp; Case Studies</p>
    <h1>
      From $20K to $100K months. From 2 roofs to 8. From $60K to $250K years.
    </h1>
    <p class="intro">
      We've helped auto repair shops, roofing companies, plumbing businesses,
      and freight consultants 3-5x their revenue using local SEO, Google Ads,
      and conversion optimization. Here's what's possible when you stop
      guessing and start executing.
    </p>
  </section>

  <section class="section soft">
    <div class="wrap">
      <p class="eyebrow">Featured case study</p>
      <div class="split rs-featured">
        <div>
          {featured.logo && (
            <img
              class="work-logo"
              src={featured.logo.src}
              width={featured.logo.width}
              height={featured.logo.height}
              alt="Total Auto Repair logo"
              loading="lazy"
              decoding="async"
            />
          )}
          <h2>Total Auto Repair</h2>
          <p class="mini-label">Auto Repair Marketing · Business Growth</p>
          <p class="rs-big">
            From $20,000/month to $100,000/month in 18 months.
          </p>
          <p>
            When Total Auto Repair came to us, they were doing roughly
            $20K/month in revenue and struggling to get consistent customer
            flow. We rebuilt their website for mobile conversions, launched
            Google Ads targeting "auto repair near me," and optimized their
            Google Business Profile for local SEO.
          </p>
          <p>
            18 months later, they're consistently hitting $100K/month and have
            expanded to a second location.
          </p>
          <blockquote class="rs-quote">
            <p>
              "Dead River Management didn't just get us more customers. They
              helped us build a real business."
            </p>
            <cite>Travis Miller, Owner, Total Auto Repair</cite>
          </blockquote>
        </div>
        <div class="rs-video">
        <video controls playsinline preload="none" width="512" height="910"
          poster="https://d2ol7oe51mr4n9.cloudfront.net/user_3JQHnLTq89zb3rmd2x4Z53G0lE3/bc486f19-6b03-42e7-996b-7226bd18326e.jpg"
          aria-label="Hear from Total Auto Repair">
          <source src="https://d2ol7oe51mr4n9.cloudfront.net/user_3JQHnLTq89zb3rmd2x4Z53G0lE3/52a05e7d-44fc-4cb0-9aab-4269f45edef3.mp4" type="video/mp4" />
          Your browser does not support embedded video.
          <a href="https://d2ol7oe51mr4n9.cloudfront.net/user_3JQHnLTq89zb3rmd2x4Z53G0lE3/52a05e7d-44fc-4cb0-9aab-4269f45edef3.mp4">Watch the Total Auto Repair testimonial.</a>
        </video>
          <a class="text-link" href="/work/total-auto-repair">Read the full case study <Arrow /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <h2>More client results</h2>
    </div>
    <div class="filter-row" role="group" aria-label="Filter by industry">
      <span class="rs-filter-label">Filter by industry:</span>
      <button type="button" data-filter="All" aria-pressed="true">All Industries</button>
      {filters.map((f) => (
        <button type="button" data-filter={f} aria-pressed="false">{f}</button>
      ))}
    </div>
    <p class="rs-empty" hidden>
      Total Auto Repair is featured above.{' '}
      <a class="text-link" href="/work/total-auto-repair">Read the full case study <Arrow /></a>
    </p>
    <div class="resource-grid">
      {more.map((w) => (
        <a class="resource-card" href={'/work/' + w.slug} data-category={extra[w.slug].filter}>
          {w.logo && <img class="work-logo" src={w.logo.src} width={w.logo.width} height={w.logo.height} alt="" loading="lazy" decoding="async" />}
          <span class="mini-label">{w.category}</span>
          <h3>{w.name}</h3>
          <p>{w.headline}</p>
          {extra[w.slug].quote && (
            <p class="rs-card-quote">
              "{extra[w.slug].quote}" <span>{extra[w.slug].owner ? extra[w.slug].owner + ', ' : ''}Owner, {w.name}</span>
            </p>
          )}
          <span class="card-bottom">
            {w.quantified ? 'See the numbers' : 'Read about the project'}{' '}
            <Arrow />
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="closing wrap">
    <div>
      <p class="eyebrow">Your turn</p>
      <h2>
        You just saw what we did for Total Auto Repair ($20K to $100K/month),
        The Pipe Whisperers ($60K to $250K/year), and Gonzalez &amp; Sons
        Roofing (2 to 8 roofs/month). Want the same results?
      </h2>
      <p>
        Book your free strategy call this week. We'll show you exactly how we'd
        replicate these results for your business, and give you a custom 90-day
        growth plan you can execute yourself or have us do for you.
      </p>
      <p class="rs-scarcity">
        We only take on 5 new clients per month, and we're down to 2 spots left
        this month.
      </p>
    </div>
    <div class="closing-actions">
      <a class="button" href="/book">Claim Your Free Strategy Call Before Spots Fill <Arrow /></a>
    </div>
  </section>
</Growth>

<script>
  // Total Auto Repair is featured above the list, so the Auto Repair filter
  // points back to it instead of showing an empty grid.
  document.querySelectorAll('[data-filter]').forEach((b) =>
    b.addEventListener('click', () => {
      const note = document.querySelector('.rs-empty') as HTMLElement | null;
      if (note) note.hidden = (b as HTMLElement).dataset.filter !== 'Auto Repair';
    }),
  );
</script>

<style>
  .work-logo { display: block; width: 120px; height: 88px; object-fit: contain; margin-bottom: 24px; }
  .rs-featured { grid-template-columns: minmax(0, 1fr) 340px; align-items: center; gap: clamp(32px, 5vw, 72px); max-width: 1120px; margin: 12px auto 0; }
  .rs-video { width: 100%; max-width: 340px; justify-self: center; }
  .rs-video video { display: block; width: 100%; height: auto; aspect-ratio: 512 / 910; object-fit: contain; border-radius: 18px; border: 1px solid var(--line); background: #101713; }
  .rs-video .text-link { margin-top: 20px; }
  @media (max-width: 900px) { .rs-featured { grid-template-columns: minmax(0, 1fr); gap: 32px; } }
  .rs-featured > * { min-width: 0; }
  .rs-featured .mini-label { margin-top: 6px; }
  .rs-big {
    font-family: var(--display);
    font-size: clamp(24px, 2.6vw, 32px);
    line-height: 1.2;
    color: var(--green);
    margin: 18px 0;
  }
  .rs-quote {
    margin: 24px 0 0;
    padding: 0 0 0 20px;
    border-left: 3px solid var(--green);
  }
  .rs-quote p {
    font-family: var(--display);
    font-size: 21px;
    line-height: 1.35;
    color: var(--ink);
    margin: 0 0 8px;
  }
  .rs-quote cite { font-style: normal; color: var(--muted); font-size: 15px; }
  .rs-filter-label { align-self: center; font-size: 15px; color: var(--muted); margin-right: 4px; }
  .rs-empty { margin: 0 0 24px; }
  .rs-card-quote { font-style: italic; color: var(--ink) !important; }
  .rs-card-quote span { display: block; font-style: normal; font-size: 14px; color: var(--muted); margin-top: 4px; }
  .closing h2 { font-size: clamp(26px, 3vw, 38px); }
  .rs-scarcity { margin-top: 14px; font-weight: 600; color: var(--copper) !important; }
  .resource-card[hidden] { display: none; }
</style>
