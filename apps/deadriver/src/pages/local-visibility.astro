---
import PlanPage from '../components/PlanPage.astro';
---
<PlanPage
  slug="local-visibility"
  how={[
    { h: 'We look at your listing', p: 'We see what Google shows for your business.' },
    { h: 'We fix it', p: 'Hours, photos, services, and where you work.' },
    { h: 'We keep it alive', p: 'A post each month. Review asks after jobs.' },
    { h: 'People near you find you', p: 'When they search, you show up.' },
  ]}
  faqs={[
    { q: 'What is Local Visibility?', a: 'Show up when people near you search.' },
    { q: 'Do you run ads in this plan?', a: 'No. Ads are in Paid Growth. We say the result first: a steady flow of new job leads.' },
    { q: 'Is there a setup fee?', a: 'No. Local Visibility has no setup fee.' },
    { q: 'How long do I sign up for?', a: 'No. Local Visibility is month to month.' },
    { q: 'Does the 30 leads in 60 days promise apply?', a: 'No. Only Dead River Complete has this. 30 leads in 60 days or we work for free until we get them.' },
    { q: 'How do I start?', a: 'Start on this page. Or call or text and you get one of us.' },
  ]}
/>
