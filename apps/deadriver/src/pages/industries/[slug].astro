---
import HeroScene from '../../components/growth/HeroScene.astro';
// Industry pages: one trade, one page. Same bones as the service pages so a
// buyer who lands here from "roofing marketing" sees the problem, the system,
// the proof for their trade, and the one offer.
import Growth from '../../layouts/Growth.astro';
import Arrow from '../../components/growth/Arrow.astro';
import ServiceLinks from '../../components/growth/ServiceLinks.astro';
import BuildSheet from '../../components/growth/BuildSheet.astro';
import { faqPage } from '../../lib/schema';
import { linkify } from '../../lib/linkify';
import { industryPages } from '../../data/industry-pages';
import { demandFlowOffer, elPasoAreas, areaHrefs, servicePages } from '../../data/service-pages';
import type { IndustryPage } from '../../data/industry-pages';

export function getStaticPaths() {
  return industryPages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}
const { page } = Astro.props as { page: IndustryPage };
const SITE = 'https://www.deadrivermanagement.com';
const others = industryPages.filter((p) => p.slug !== page.slug);
const here = `/industries/${page.slug}`;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: `Marketing for ${page.trade}`,
    serviceType: 'Marketing services',
    description: page.description,
    provider: { '@id': `${SITE}/#organization` },
    audience: { '@type': 'BusinessAudience', name: `${page.name} businesses` },
    areaServed: [
      { '@type': 'City', name: 'El Paso', containedInPlace: { '@type': 'State', name: 'Texas' } },
      { '@type': 'Country', name: 'United States' },
    ],
    url: `${SITE}/industries/${page.slug}`,
  },
  faqPage(page.faqs),
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: 'Industries', item: `${SITE}/industries` },
      { '@type': 'ListItem', position: 3, name: page.name, item: `${SITE}/industries/${page.slug}` },
    ],
  },
];
---

<Growth ogImage={`/images/og/industries/${page.slug}.jpg`} title={page.title} description={page.description} schema={schema}>
  <section class="has-scene page-hero wrap in-hero">
  <HeroScene />
    <p class="eyebrow">{page.name} marketing · Nationwide and El Paso</p>
    <h1>{page.headline}</h1>
    <p class="intro" set:html={linkify(page.intro, here)} />
    <div class="button-row">
      <a class="button" href="/book" data-cta="hero">Book a Strategy Call <Arrow /></a>
      <a class="button secondary" href="#proof" data-cta="hero-proof">See the {page.name.toLowerCase()} result</a>
    </div>
    <BuildSheet title={`${page.name} system`} rows={page.built.map(([t]) => t)} caption="Book a strategy call" />
  </section>

  <section class="section soft">
    <div class="wrap">
      <p class="eyebrow">The problem</p>
      <h2>The call you miss is the job you lose.</h2>
      <p class="in-scene">{page.scene}</p>
      <div class="ms-grid">
        {page.problems.map(([title, body]) => (
          <article class="feature-panel">
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        ))}
      </div>
      <blockquote class="in-quote">{page.quote}</blockquote>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">What we build</p>
        <h2>The whole system for a {page.biz}.</h2>
      </div>
    </div>
    <div class="ms-grid">
      {page.built.map(([title, body]) => (
        <article class="feature-panel">
          <h3>{title}</h3>
          <p set:html={linkify(body, here)} />
        </article>
      ))}
    </div>
  </section>

  <section class="section soft" id="proof">
    <div class="wrap split in-proof">
      <div>
        <p class="eyebrow">Results</p>
        <h2>A {page.biz} that did this.</h2>
        <p class="mini-label">{page.proof.label}</p>
        <p class="sv-proof">{page.proof.text}</p>
        {page.proof.note && <p class="small">{page.proof.note}</p>}
        <a class="text-link" href={page.proof.href}>{page.proof.linkText} <Arrow /></a>
      </div>
      <div class="ms-offer">
        <p class="eyebrow">The offer</p>
        <h2>{demandFlowOffer.offer}</h2>
        <p>{demandFlowOffer.from}</p>
        <a class="button ms-invert" href={demandFlowOffer.href} data-cta="offer">See if you qualify <Arrow /></a>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="split ms-two">
      <article class="feature-panel">
        <h3>Free tools for {page.trade}</h3>
        <ul class="in-list">
          {page.tools.map((t) => <li><a class="inline-link" href={t.href}>{t.label}</a></li>)}
        </ul>
        <h3>Guides worth reading</h3>
        <ul class="in-list">
          {page.guides.map((g) => <li><a class="inline-link" href={g.href}>{g.label}</a></li>)}
        </ul>
      </article>
      <article class="feature-panel">
        <h3>In El Paso</h3>
        <p>We're based in El Paso and work with {page.trade} across the borderland, and across the country.</p>
        <ul class="sv-areas" aria-label="Areas we serve">
          {elPasoAreas.map((a) => <li>{areaHrefs[a] ? <a href={areaHrefs[a]}>{a}</a> : a}</li>)}
        </ul>
        <a class="text-link" href="/locations/el-paso">Marketing in El Paso <Arrow /></a>
      </article>
    </div>
    <ServiceLinks
      label={`What we run for ${page.trade}`}
      heading="Every channel, built for your trade."
      links={servicePages.map((s) => ({ label: s.name, href: '/services/' + s.slug, blurb: s.blurb }))}
    />
    <ServiceLinks
      label="Other trades"
      heading="The same system, built for your trade."
      links={others.map((p) => ({ label: p.name, href: '/industries/' + p.slug, blurb: p.headline }))}
    />
  </section>

  <section class="section soft">
    <div class="wrap">
      <div class="section-head"><div><p class="eyebrow">FAQ</p><h2>Questions {page.trade} ask us.</h2></div></div>
      <div class="faq">
        {page.faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p set:html={linkify(f.a, here)} />
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section wrap ms-close">
    <div class="ms-offer">
      <p class="eyebrow">Next step</p>
      <h2>Ready to see what this books for your {page.biz}?</h2>
      <p>Book a short strategy call. We'll look at your market and what you run today, then tell you if you qualify. If we aren't a fit, we'll say so.</p>
      <div class="button-row">
        <a class="button ms-invert" href="/book" data-cta="final">Book a Strategy Call <Arrow /></a>
      </div>
    </div>
  </section>
</Growth>

<script>
  import { track } from '../../scripts/growth-shell.js';
  document.querySelectorAll<HTMLAnchorElement>('a[data-cta]').forEach((a) =>
    a.addEventListener('click', () =>
      track('industry_cta_click', { cta: a.dataset.cta, path: location.pathname }),
    ),
  );
</script>

<style>
  .in-hero h1 { max-width: 1000px; }
  .in-scene { font-family: var(--display); font-size: clamp(19px, 2.1vw, 24px); line-height: 1.4; max-width: 820px; margin: 10px 0 24px; }
  .in-quote { margin: 28px 0 0; padding: 18px 22px; border-left: 3px solid var(--copper, #b5673a); color: var(--muted); font-size: 17px; max-width: 760px; }
  .ms-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-top: 12px; }
  .ms-grid > * { min-width: 0; }
  .ms-grid h3, .ms-two h3 { font-size: 21px; margin-bottom: 8px; }
  .ms-two { align-items: start; }
  .ms-two h3 + .in-list { margin-bottom: 18px; }
  .in-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .in-proof { align-items: start; }
  .sv-proof { font-size: 18px; color: var(--ink); margin: 8px 0 12px; }
  .sv-areas { list-style: none; padding: 0; margin: 14px 0 16px; display: flex; flex-wrap: wrap; gap: 6px; }
  .sv-areas a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
  .sv-areas li { font-size: 13px; padding: 4px 10px; border: 1px solid var(--line); border-radius: 999px; color: var(--ink); background: var(--paper); }
  .service-links { margin-top: 36px; }
  .ms-close { padding-bottom: 72px; }
  @media (max-width: 1000px) { .ms-grid { grid-template-columns: 1fr; } }
</style>
