---
import Growth from '../../layouts/Growth.astro';
import Hero from '../../components/growth/Hero.astro';
import CTA from '../../components/growth/CTA.astro';
import ServiceLinks from '../../components/growth/ServiceLinks.astro';
import { industryPages } from '../../data/industry-pages';

const SITE = 'https://www.deadrivermanagement.com';
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: 'Industries', item: `${SITE}/industries` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: industryPages.map((page, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: page.name,
      url: `${SITE}/industries/${page.slug}`,
    })),
  },
];
---

<Growth ogImage="/images/og/industries.jpg"
  title="Marketing by Industry"
  description="Marketing built for roofers, plumbers, HVAC companies, and auto repair shops. One offer, tuned to how each trade gets the call. Nationwide and in El Paso."
  schema={schema}
>
  <Hero scene="liquid"
    eyebrow="Industries · Nationwide and El Paso"
    title="Built for how your trade gets the call."
    intro="Every trade loses jobs in a different place: the storm week, the 9 PM call, the July rush, the quote that walks out. Pick yours."
  />
  <section class="section wrap">
    <ServiceLinks
      label="Pick your trade"
      heading="One system, four trades."
      links={industryPages.map((p) => ({ label: p.name, href: '/industries/' + p.slug, blurb: p.headline }))}
    />
  </section>
  <CTA />
</Growth>
