---
import PlanPage from '../components/PlanPage.astro';
---
<PlanPage
  slug="front-desk-ai"
  how={[
    { h: 'A text or chat comes in', p: 'Someone wants a job done.' },
    { h: 'We answer', p: 'We talk like your business.' },
    { h: 'We book the job', p: 'A time lands on your calendar.' },
    { h: 'You do the work', p: 'You show up. We keep the next one from slipping.' },
  ]}
  faqs={[
    { q: 'What is Front Desk AI?', a: 'We answer texts and chat and book the job while you work.' },
    { q: 'Does this pick up the phone?', a: 'No. Front Desk Complete answers the phone day and night.' },
    { q: 'Is there a setup fee?', a: 'No. Pay your first month to start.' },
    { q: 'How long do I sign up for?', a: 'No. Front Desk AI is month to month.' },
    { q: 'Does the 30 leads in 60 days promise apply?', a: 'No. Only Dead River Complete has this. 30 leads in 60 days or we work for free until we get them.' },
    { q: 'What about text and AI cost?', a: 'Texts, calls, and AI use are billed at what they cost us. We do not add extra.' },
  ]}
/>
