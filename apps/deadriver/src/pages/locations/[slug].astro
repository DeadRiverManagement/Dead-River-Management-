---
import Growth from '../../layouts/Growth.astro';
import Hero from '../../components/growth/Hero.astro';
import CTA from '../../components/growth/CTA.astro';
import ServiceLinks from '../../components/growth/ServiceLinks.astro';
import Arrow from '../../components/growth/Arrow.astro';
import { locations } from '../../data/growth-locations';
import { elPasoLocationFaq } from '../../data/nationwide-faq';
import { faqPage } from '../../lib/schema';
export function getStaticPaths() {
  return locations.map((location) => ({
    params: { slug: location.slug },
    props: { location },
  }));
}
const { location: l } = Astro.props;
const pageFaq = l.slug === 'el-paso' ? elPasoLocationFaq : [];
const pageTitle =
  l.slug === 'el-paso'
    ? 'El Paso Home Services Marketing'
    : 'Growth partner for ' + l.name + ' businesses';
---

<Growth
  title={pageTitle}
  description={
    l.intro +
    ' Ads, follow-up, and reporting built around where your customers are.'
  }
  schema={pageFaq.length ? faqPage(pageFaq) : undefined}
>
  <Hero
    eyebrow={l.name + ', ' + l.region}
    title="A clearer path to growth, close to home."
    intro={l.intro}
  />
  <section class="section wrap split">
    <div>
      <p class="eyebrow">Local first</p>
      <h2>Where you work shapes how you grow.</h2>
      <p class="intro">{l.context}</p>
    </div>
    <div>
      <h3>Start with the practical stuff.</h3>
      <ul class="check-list">
        {l.priorities.map((p) => (
          <li>{p}</li>
        ))}
      </ul>
    </div>
  </section>
  <section class="section soft">
    <div class="wrap split">
      <div>
        <p class="eyebrow">El Paso and the borderland</p>
        <h2>Be specific about the customers you can serve.</h2>
      </div>
      <div>
        <p>
          We can plan around {l.areas.join(', ')}, and around Sunland Park and
          Las Cruces in New Mexico if you serve them.
        </p>
        <p>
          Before ads run, we confirm the areas you cover, how far your team will
          travel, and how much work you can take on. Every business is
          different, and we do not assume.
        </p>
      </div>
    </div>
  </section>
  <section class="section wrap split">
    <div>
      <h2>Local team. Real numbers.</h2>
    </div>
    <div>
      <p>{l.proof}</p>
      <div class="stack">
        <a class="text-link" href="/work">
          See our results <Arrow />
        </a>
        <a class="text-link" href="/book">
          Book a strategy call <Arrow />
        </a>
      </div>
    </div>
  </section>
  {pageFaq.length > 0 && (
    <section class="section wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Before you start</p>
          <h2>A few clear answers.</h2>
        </div>
      </div>
      <div class="faq">
        {pageFaq.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </section>
  )}
  <section class="wrap">
    <ServiceLinks label="Our services" />
  </section>
  <CTA />
</Growth>
