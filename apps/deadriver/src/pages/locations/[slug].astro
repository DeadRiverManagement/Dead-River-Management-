---
import Growth from '../../layouts/Growth.astro';
import Hero from '../../components/growth/Hero.astro';
import CTA from '../../components/growth/CTA.astro';
import ServiceLinks from '../../components/growth/ServiceLinks.astro';
import Arrow from '../../components/growth/Arrow.astro';
import { locations } from '../../data/growth-locations';
import { industryPages } from '../../data/industry-pages';
import OfficeMap from '../../components/growth/OfficeMap.astro';
import AnswerBlock from '../../components/growth/AnswerBlock.astro';
import { elPasoLocationFaq } from '../../data/nationwide-faq';
import { faqPage } from '../../lib/schema';
import { linkify } from '../../lib/linkify';
export function getStaticPaths() {
  return locations.map((location) => ({
    params: { slug: location.slug },
    props: { location },
  }));
}
const { location: l } = Astro.props;
const pageFaq = l.faq ?? (l.slug === 'el-paso' ? elPasoLocationFaq : []);
const pageTitle =
  l.title ?? (l.slug === 'el-paso'
    ? 'El Paso Home Services Marketing'
    : 'Growth partner for ' + l.name + ' businesses');
const SITE = 'https://www.deadrivermanagement.com';
const rich = Boolean(l.about);
const here = `/locations/${l.slug}`;
const pageDescription =
  l.description ??
  l.intro + ' Ads, follow-up, and reporting built around where your customers are.';
const serviceLd = rich
  ? {
      '@context': 'https://schema.org',
      '@type': 'Service',
      name: `Marketing agency for ${l.name}, ${l.state}`,
      serviceType: 'Marketing services',
      description: l.description,
      provider: { '@id': `${SITE}/#organization` },
      areaServed: [
        { '@type': 'City', name: l.name, containedInPlace: { '@type': 'State', name: l.region } },
        ...l.areas.filter((a) => a !== l.name).map((a) => ({ '@type': 'Place', name: a })),
      ],
      url: `${SITE}/locations/${l.slug}`,
    }
  : l.slug === 'el-paso'
    ? {
        '@context': 'https://schema.org',
        '@type': 'Service',
        name: `Marketing agency for ${l.name}, TX`,
        serviceType: 'Marketing services',
        description: pageDescription,
        provider: { '@id': `${SITE}/#organization` },
        areaServed: [
          { '@type': 'City', name: l.name, containedInPlace: { '@type': 'State', name: l.region } },
        ],
        url: `${SITE}/locations/${l.slug}`,
      }
    : null;
const schema = [
  ...(pageFaq.length ? [faqPage(pageFaq)] : []),
  ...(serviceLd ? [serviceLd] : []),
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE}/` },
      { '@type': 'ListItem', position: 2, name: 'Locations', item: `${SITE}/locations` },
      { '@type': 'ListItem', position: 3, name: l.name, item: `${SITE}/locations/${l.slug}` },
    ],
  },
];
---

<Growth ogImage="/images/og/locations.jpg"
  title={pageTitle}
  description={pageDescription}
  schema={schema.length ? schema : undefined}
>
  <Hero scene="liquid"
    eyebrow={l.eyebrow ?? l.name + ', ' + l.region}
    title={l.headline ?? 'A clearer path to growth, close to home.'}
    intro={l.intro}
  >
    {l.answer && <AnswerBlock html={l.answer} related={l.answerRelated} />}
  </Hero>
  {rich && l.about && (
    <section class="section wrap loc-about">
      <p class="eyebrow">Local first</p>
      <h2>{l.about.heading}</h2>
      {l.about.paragraphs.map((p) => <p set:html={linkify(p, here)} />)}
    </section>
  )}
  {rich && l.services && (
    <section class="section soft">
      <div class="wrap">
        <p class="eyebrow">What we run in {l.name}</p>
        <h2>Every channel, targeted to {l.name}.</h2>
        <div class="loc-grid">
          {l.services.map((s) => (
            <a class="feature-panel loc-service" href={s.href}>
              <h3>{s.name}</h3>
              <p>{s.blurb}</p>
              <span class="text-link">How we run it <Arrow /></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
  <section class="section wrap split">
    <div>
      <p class="eyebrow">{rich ? 'Where to start' : 'Local first'}</p>
      <h2>Where you work shapes how you grow.</h2>
      <p class="intro" set:html={linkify(l.context, here)} />
    </div>
    <div>
      <h3>Start with the practical stuff.</h3>
      <ul class="check-list">
        {l.priorities.map((p) => (
          <li>{p}</li>
        ))}
      </ul>
    </div>
  </section>
  <section class="section soft">
    <div class="wrap split">
      <div>
        <p class="eyebrow">{rich ? l.name + ' and nearby' : 'El Paso and the borderland'}</p>
        <h2>Be specific about the customers you can serve.</h2>
        {l.nearby && (
          <p class="loc-nearby">Also see:{l.nearby.map((n, i) => (
            <>{i > 0 && ','}<a class="inline-link" href={n.href}>{n.label}</a></>
          ))}</p>
        )}
      </div>
      <div>
        <p>
          {rich
            ? `We can plan around ${l.areas.join(', ')}, and anywhere else your crews go.`
            : `We can plan around ${l.areas.join(', ')}, and around Sunland Park and Las Cruces in New Mexico if you serve them.`}
        </p>
        <p>
          Before ads run, we confirm the areas you cover, how far your team will
          travel, and how much work you can take on. Every business is
          different, and we don't assume.
        </p>
      </div>
    </div>
  </section>
  {rich && l.demand && (
    <section class="section wrap split">
      <div>
        <p class="eyebrow">Demand</p>
        <h2>{l.demand.heading}</h2>
        <p>{l.demand.lead}</p>
      </div>
      <div>
        <ul class="check-list">
          {l.demand.items.map((d) => <li>{d}</li>)}
        </ul>
        <p class="small">{l.demand.note}</p>
      </div>
    </section>
  )}
  <section class="section wrap split">
    <div>
      <h2>Local team. Real numbers.</h2>
    </div>
    <div>
      <p set:html={linkify(l.proof, here)} />
      <div class="stack">
        <a class="text-link" href="/work">
          See our results <Arrow />
        </a>
        <a class="text-link" href="/book">
          Book a strategy call <Arrow />
        </a>
      </div>
    </div>
  </section>
  {l.slug === 'el-paso' && <OfficeMap heading="Based in downtown El Paso." />}
  {pageFaq.length > 0 && (
    <section class="section wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Before you start</p>
          <h2>{rich ? `Questions ${l.name} businesses ask us.` : 'A few clear answers.'}</h2>
        </div>
      </div>
      <div class="faq">
        {pageFaq.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p set:html={linkify(item.a, here)} />
          </details>
        ))}
      </div>
    </section>
  )}
  <section class="wrap">
    <ServiceLinks label="Our services" heading="Every channel we run." />
    <ServiceLinks
      label="By trade"
      heading="Built for how your trade gets the call."
      links={industryPages.map((p) => ({ label: p.name, href: '/industries/' + p.slug, blurb: p.headline }))}
    />
  </section>
  <CTA />
</Growth>

<style>
  .loc-about { max-width: 860px; }
  .loc-about h2 { margin-bottom: 14px; }
  .loc-about p { color: var(--muted); font-size: 17px; line-height: 1.6; margin-bottom: 14px; }
  .loc-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-top: 12px; }
  .loc-grid > * { min-width: 0; display: flex; flex-direction: column; }
  .loc-service h3 { font-size: 20px; margin-bottom: 8px; }
  .loc-service p { color: var(--muted); font-size: 15px; margin-bottom: 14px; }
  .loc-service .text-link { margin-top: auto; font-size: 14px; }
  .loc-nearby { margin-top: 12px; font-size: 14px; color: var(--muted); }
  .loc-nearby a { margin-left: 6px; }
  @media (max-width: 1000px) { .loc-grid { grid-template-columns: 1fr; } }
</style>
