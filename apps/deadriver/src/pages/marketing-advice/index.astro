---
import Growth from '../../layouts/Growth.astro';
import Hero from '../../components/growth/Hero.astro';
import Arrow from '../../components/growth/Arrow.astro';
import { getCollection } from 'astro:content';
import { breadcrumbList, itemList } from '../../lib/schema';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
// Same cards as the page, skipping the one guide kept out of the sitemap.
const listed = posts.filter((p) => p.id !== '30-leads-in-60-days-guarantee');
const schema = [
  breadcrumbList([
    { name: 'Home', path: '/' },
    { name: 'Marketing Advice', path: '/marketing-advice' },
  ]),
  itemList(listed.map((p) => ({ name: p.data.title, path: '/marketing-advice/' + p.id }))),
];
---

<Growth ogImage="/images/og/marketing-advice.jpg"
  title="Marketing Advice and Guides"
  description="Plain-language articles from Dead River Management. Short guides on getting found, your website, and fast follow-up, written in plain words for busy owners."
  schema={schema}
>
  <Hero scene="liquid"
    eyebrow="Articles"
    title="Simple ideas to get more customers."
    intro="Short guides on getting found, your website, fast follow-up, and growth. Written in plain words for busy owners."
  />
  <section class="section wrap">
    <a class="back-link" href="/resources">
      ← Tools and articles
    </a>
    <div class="section-head">
      <h2>Guides worth reading</h2>
    </div>
    <div class="resource-grid">
      {posts.map((p) => (
        <a class="resource-card" href={'/marketing-advice/' + p.id}>
          <span class="mini-label">
            {p.data.category} ·{' '}
            {p.data.date.toLocaleDateString('en-US', {
              month: 'short',
              year: 'numeric',
              timeZone: 'UTC',
            })}
          </span>
          <h3>{p.data.title}</h3>
          <p>{p.data.description}</p>
          <span class="card-bottom">
            Read the article <Arrow />
          </span>
        </a>
      ))}
    </div>
  </section>
</Growth>
