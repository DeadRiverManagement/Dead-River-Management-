---
import Growth from '../layouts/Growth.astro';
import Hero from '../components/growth/Hero.astro';
import Arrow from '../components/growth/Arrow.astro';
const priceRows = [
  {
    provider: 'Dead River Demand Intelligence',
    price: '$3,000/month',
    setup: '$0',
    allowance: 'Full platform access',
    detail: 'No audience-credit ceiling',
    featured: true,
    href: '/demand-intelligence',
  },
  {
    provider: 'AudienceLab · 2M-credit plan',
    price: '$1,497/month',
    setup: '$500',
    allowance: '2 million audience credits',
    detail: 'Usage capped by credits',
    featured: false,
    href: null,
  },
  {
    provider: 'AudienceLab · 3.5M-credit plan',
    price: '$2,000/month',
    setup: '$500',
    allowance: '3.5 million audience credits',
    detail: 'Usage capped by credits',
    featured: false,
    href: null,
  },
];
const criteria = [
  ['B2B and B2C coverage', 'Decide whether you need company-level business signals, consumer audiences, or both. Many intent data providers specialize in only one side.'],
  ['Signal source and freshness', 'Ask what activity contributes to a signal, how recently it occurred, how frequently data refreshes, and what a signal does not prove.'],
  ['Identity and visitor matching', 'Confirm whether the platform only scores companies or can also support eligible person-level audiences and website visitor identification.'],
  ['Audience activation', 'Check whether audiences can move into the advertising platforms, CRM, and sales workflows your team actually uses.'],
  ['Pricing and limits', 'Compare monthly access, record or credit limits, seats, exports, destinations, onboarding costs, and contract length.'],
  ['Privacy and permitted use', 'A provider should explain coverage and restrictions clearly. Intent or identity data does not automatically create consent for outreach.'],
];
const faqs = [
  ['What is an intent data provider?', 'An intent data provider collects or organizes behavioral signals that may indicate people or businesses are researching particular topics, products, or services.'],
  ['Which intent data provider is best?', 'The best provider depends on whether you need B2B, B2C, visitor identification, advertising activation, sales prioritization, or a combination. Compare coverage, freshness, integrations, limits, and permitted use.'],
  ['How much does intent data cost?', 'Pricing varies widely by coverage, seats, records, exports, integrations, and contract terms. Dead River Demand Intelligence provides full platform access for $3,000 per month with no setup fee.'],
  ['Does intent data guarantee someone is ready to buy?', 'No. Intent data is a prioritization signal. It does not guarantee identity, interest, timing, permission, or a purchase.'],
];
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: 'How to Compare Intent Data Providers',
    description: 'Compare buyer intent data providers by coverage, freshness, identity resolution, activation, pricing, and permitted use.',
    author: { '@type': 'Organization', name: 'Dead River Management' },
    publisher: { '@type': 'Organization', name: 'Dead River Management' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(([name, text]) => ({
      '@type': 'Question',
      name,
      acceptedAnswer: { '@type': 'Answer', text },
    })),
  },
];
---

<Growth
  title="Intent Data Provider Comparison"
  description="Compare intent data providers on coverage, freshness, visitor ID, activation, integrations, pricing, and permitted use."
  schema={schema}
>
  <Hero
    eyebrow="Intent data providers · Independent buying guide"
    title="Compare intent data providers by what your team can actually use."
    intro="The best buyer intent data platform is not the one with the longest feature list. It is the one with the right coverage, fresh enough signals, usable activation, clear limits, and responsible rules for your market."
  >
    <div class="button-row">
      <a class="button" href="/demo">See Dead River Demand Intelligence <Arrow /></a>
      <a class="text-link" href="/demand-intelligence">View platform details <Arrow /></a>
    </div>
  </Hero>

  <section class="section wrap comparison-section">
    <div class="section-head">
      <div>
        <p class="eyebrow">Compare the pricing model</p>
        <h2>Know what happens when your usage grows.</h2>
      </div>
      <p>
        A lower starting price can still come with setup costs and a fixed
        credit ceiling. Compare the access model, not only the monthly number.
      </p>
    </div>
    <div class="comparison-scroll" tabindex="0" aria-label="Intent data provider pricing comparison. Scroll sideways on small screens.">
      <table class="comparison-table">
        <thead>
          <tr>
            <th>Provider</th>
            <th>Monthly</th>
            <th>Setup</th>
            <th>Access</th>
          </tr>
        </thead>
        <tbody>
          {priceRows.map((row) => (
            <tr class:list={{ featured: row.featured }}>
              <th scope="row">
                {row.featured && <span class="value-badge">Predictable access</span>}
                {row.href ? <a href={row.href}>{row.provider}</a> : <span class="provider-name">{row.provider}</span>}
              </th>
              <td class="price-cell"><strong>{row.price}</strong></td>
              <td class:list={{ 'zero-cost': row.setup === '$0' }}>{row.setup}</td>
              <td>
                <strong>{row.allowance}</strong>
                <span class="access-detail">{row.detail}</span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="comparison-takeaway">
      One flat monthly plan. No setup fee. No audience-credit ceiling.
    </p>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <div><p class="eyebrow">Six buying criteria</p><h2>What to ask every intent data provider.</h2></div>
      <p>Use the same questions in every demo so a polished dashboard does not hide weak coverage, stale data, or unusable exports.</p>
    </div>
    <div class="capability-grid">
      {criteria.map(([h, p]) => <article><h3>{h}</h3><p>{p}</p></article>)}
    </div>
  </section>

  <section class="section soft">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Choose around the use case</p>
        <h2>“Intent data” can describe very different products.</h2>
      </div>
      <div>
        <h3>B2B account intent</h3>
        <p>Useful when sales teams need to prioritize companies or buying groups researching a category.</p>
        <h3>Consumer purchase intent</h3>
        <p>Useful when brands and advertisers need B2C audiences built around relevant behavioral or category signals.</p>
        <h3>Website visitor identification</h3>
        <p>Useful when a team wants more context around a portion of its own anonymous site traffic.</p>
        <h3>Audience building and activation</h3>
        <p>Useful when data must become an addressable audience inside supported advertising or CRM systems.</p>
      </div>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <div><p class="eyebrow">Our approach</p><h2>One platform across B2B and B2C intent.</h2></div>
      <p>Dead River Demand Intelligence combines audience building, relevant purchase-intent signals, visitor identification capabilities, and supported activation in one full-access plan.</p>
    </div>
    <div class="feature-grid">
      <article class="feature-panel"><h3>Full platform access</h3><p><strong>$3,000 per month.</strong> No setup fee. Exact coverage, destinations, and agency arrangements are confirmed during the demo.</p></article>
      <article class="feature-panel"><h3>Use signals responsibly</h3><p>Signals help prioritize attention. They do not prove someone will buy and do not grant permission for unsolicited outreach.</p></article>
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head"><div><p class="eyebrow">Common questions</p><h2>Intent data provider FAQ.</h2></div></div>
    <div class="faq-list">
      {faqs.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
    </div>
  </section>

  <section class="closing wrap">
    <div>
      <p class="eyebrow">Compare it with your own market</p>
      <h2>Bring a real audience and evaluate the output.</h2>
      <p>A focused demo is more useful than a generic feature tour. Bring the market, geography, and activation goal your team actually has.</p>
    </div>
    <div class="closing-actions"><a class="button" href="/demo">Book a Demo <Arrow /></a></div>
  </section>
</Growth>

<style>
  .comparison-section {
    position: relative;
  }
  .comparison-scroll {
    overflow-x: auto;
    margin: 30px 0 18px;
    border: 1px solid #dce3d8;
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 18px 50px rgba(37, 79, 67, 0.08);
  }
  .comparison-table {
    width: 100%;
    min-width: 760px;
    border-collapse: separate;
    border-spacing: 0;
    text-align: left;
  }
  .comparison-table th,
  .comparison-table td {
    padding: 21px 20px;
    border-bottom: 1px solid #e5ebe2;
    vertical-align: middle;
  }
  .comparison-table thead th {
    color: #5c6b62;
    background: #f4f7f1;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .comparison-table thead th:first-child {
    border-radius: 15px 0 0;
  }
  .comparison-table thead th:last-child {
    border-radius: 0 15px 0 0;
  }
  .comparison-table tbody th {
    min-width: 215px;
  }
  .comparison-table tbody tr:last-child > * {
    border-bottom: 0;
  }
  .comparison-table tbody tr.featured > * {
    background: #eef5ef;
    border-top: 2px solid #285b48;
    border-bottom: 2px solid #285b48;
  }
  .comparison-table tbody tr.featured > *:first-child {
    border-left: 2px solid #285b48;
  }
  .comparison-table tbody tr.featured > *:last-child {
    border-right: 2px solid #285b48;
  }
  .comparison-table a,
  .provider-name {
    display: block;
    color: #19382f;
    font-weight: 750;
    text-decoration: none;
  }
  .comparison-table a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .price-cell strong {
    color: #19382f;
    font-size: 18px;
    white-space: nowrap;
  }
  .zero-cost {
    color: #285b48;
    font-weight: 800;
  }
  .value-badge {
    display: inline-flex;
    margin: 0 0 8px;
    padding: 4px 9px;
    border-radius: 999px;
    color: #fff;
    background: #285b48;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
  }
  .access-detail {
    display: block;
    margin-top: 5px;
    color: #5c6b62;
    font-size: 13px;
  }
  .comparison-takeaway {
    margin: 0;
    color: #19382f;
    font-weight: 700;
    text-align: center;
  }
  @media (max-width: 719px) {
    .comparison-scroll {
      margin-inline: -2px;
      border-radius: 12px;
    }
    .comparison-table th,
    .comparison-table td {
      padding: 17px 16px;
    }
    .comparison-takeaway {
      text-align: left;
      line-height: 1.5;
    }
  }
</style>
