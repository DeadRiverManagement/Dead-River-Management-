---
// Step two of the Demand Intelligence hero form: pick a demo time. Same
// GoHighLevel calendar as /book/thanks.
import Growth from '../../layouts/Growth.astro';
import { DEMANDFLOW_CALENDAR_URL } from '../../lib/demandflow-handoff.js';
const BOOKING_CALENDAR_URL = DEMANDFLOW_CALENDAR_URL;
---

<Growth
  title="Pick a Time for Your Demo"
  description="Your demo request is received. Choose a time for your Dead River Demand Intelligence demo."
  robots="noindex,nofollow"
  campaign
>
  <section class="thanks wrap" aria-labelledby="thanks-title">
    <div class="thanks-intro">
      <h1 id="thanks-title">Pick a time for your demo.</h1>
      <p class="intro">
        We have your request. Choose a time below and the calendar invite will
        be emailed to you.
      </p>
      <p class="thanks-spam">
        Don't see the invite link? Check your spam or promotions folder.
      </p>
    </div>

    <div class="thanks-calendar">
      <iframe
        src={BOOKING_CALENDAR_URL}
        allow="payment"
        style="width:100%;border:none;overflow:hidden;min-height:780px;"
        height="1100"
        scrolling="no"
        id="rfaj3m31onqPQEFYhwyE_di_thanks"
        title="Pick a time for your Demand Intelligence demo"
        referrerpolicy="no-referrer"
      ></iframe>
      <script is:inline src="https://link.msgsndr.com/js/form_embed.js" type="text/javascript"></script>
    </div>

    <div class="thanks-next">
      <h2>What to expect on the demo:</h2>
      <ul class="check-list">
        <li>We pull live purchase intent data for your market</li>
        <li>You see how many in-market prospects we can find right now</li>
        <li>We walk you through the 60-day 2x guarantee</li>
      </ul>
      <p>
        After you book, check your inbox for the invite link. If it's not
        there, check your spam folder. Can't find a time that works? Call or
        text <a href="tel:+19152283054">(915) 228-3054</a>.
      </p>
    </div>
  </section>
</Growth>

<style>
  :global(.campaign-cta) {
    display: none !important;
  }
  .thanks {
    padding-block: clamp(20px, 3vw, 40px) clamp(40px, 6vw, 80px);
    max-width: 1120px;
  }
  .thanks-intro {
    max-width: 790px;
    margin: 0 auto 20px;
    text-align: center;
  }
  .thanks-intro h1 {
    font-size: clamp(28px, 3.6vw, 44px);
  }
  .thanks-intro .intro {
    margin: 12px auto 0;
    font-size: 17px;
  }
  .thanks-spam {
    display: inline-block;
    margin: 14px auto 0;
    padding: 10px 16px;
    border-radius: 8px;
    background: #fff4df;
    border: 1px solid #ecd3a4;
    color: var(--ink);
    font-weight: 600;
    font-size: 16px;
  }
  .thanks-calendar {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 20px;
    box-shadow: 0 14px 45px rgb(25 56 47 / 6%);
    overflow: hidden;
  }
  .thanks-calendar iframe {
    display: block;
    max-width: 100%;
  }
  .thanks-next {
    margin: 28px auto 0;
    max-width: 640px;
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--sage);
  }
  .thanks-next h2 {
    font-size: 24px;
    margin-bottom: 8px;
  }
  .thanks-next .check-list li {
    font-size: 16px;
    color: var(--ink);
  }
  .thanks-next p {
    margin-top: 14px;
  }
  .thanks-next a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
