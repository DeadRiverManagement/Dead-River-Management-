---
// Demand Intelligence VSL. The walkthrough video people used to watch on
// /demand-intelligence lives here, in front of a live demo booking. Ad traffic
// only: noindex and kept out of the sitemap, like /50k-demand-flow.
import Growth from '../../layouts/Growth.astro';
import HeroScene from '../../components/growth/HeroScene.astro';
import ClientTrust from '../../components/growth/ClientTrust.astro';
import FaqList from '../../components/FaqList.astro';
import Arrow from '../../components/growth/Arrow.astro';
import { faqPage } from '../../lib/schema';
import { DEMANDFLOW_CALENDAR_URL } from '../../lib/demandflow-handoff.js';

const video = {
  src: '/media/demand-intelligence-walkthrough.mp4',
  poster: '/media/demand-intelligence-demo-poster.jpg',
};

// Owner confirmed these shared platform figures on October 5, 2026.
const stats = [
  ['280M', 'U.S. consumer profiles'],
  ['95%', 'Contact-data accuracy'],
  ['60B', 'Weekly behaviors and URLs'],
];

const pains = [
  ['Your ads reach everyone', "You pay for clicks from people who were never going to buy."],
  ['Your list is cold', "You're emailing and calling people who stopped looking months ago."],
  ["You can't see who's visiting", 'People check out your website and leave. You never find out who they were.'],
  ['Slow seasons hit hard', "You wait for the phone to ring instead of knowing who's in the market this week."],
  ['Every platform starts over', 'You rebuild the same audience in Meta, Google, and your CRM, and none of them match.'],
  ["You can't tell what worked", 'You see clicks and leads, but not which ones turned into money.'],
];

const walkthrough = [
  ['Pick the topics', 'Roofing. Roof repair. Roof inspection. Roof damage. Up to five topics that match what you sell.'],
  ['Set the lookback', 'Last 2 days or last 7 days. The list only holds people who looked recently.'],
  ['Pull the list', '4,500 people in Dallas with names and contact details, ready for ads, email, or calls.'],
];

const stages = [
  ['Target', 'Demand Intelligence finds the people looking up your service right now. What they searched, read, and compared in the last few days, matched to real business and consumer records.'],
  ['Create', 'Your offer goes in front of only those people, on Facebook, Instagram, Google, and email. No broad audiences. No wasted spend.'],
  ['Capture', 'When someone raises their hand, a landing page, a quick text back, and a booking link catch them right then. Nobody waits until tomorrow.'],
  ['Convert', 'Reminders, follow-up, and weekly tuning turn those leads into booked work and paid invoices, synced to your ads, CRM, and sales tools.'],
];

const results = [
  ['Gonzalez & Sons Roofing', 'From 2 to 8 roofs a month in 6 months', ['2 to 8 roofs per month', '$50K to $200K monthly revenue', '6-month case study'], '/work/gonzalez-and-sons-roofing'],
  ['The Pipe Whisperers', 'From $60K to $250K in annual revenue', ['About $60K annual revenue before', 'About $250K annual revenue after', '24-month case study'], '/work/the-pipe-whisperers'],
  ['Wicked Logistics', 'From 1 to 2 leads a week to 5 to 6 a day', ['1 to 2 leads per week before', '5 to 6 leads per day within 3 months', 'One contract valued at $1.2M per year'], '/work/wicked-logistics'],
];

const faqs = [
  {
    q: 'What is Demand Intelligence?',
    a: "It's our data platform. It finds people who have been looking up what you sell, matches your website visitors to real profiles, fills in missing contact details, and lets you use those lists in your ads, email, and sales tools.",
  },
  {
    q: 'What happens on the demo?',
    a: "We pull your market live. You tell us what you sell and where. We pick the topics, set the lookback, and show you how many people are shopping right now. Then we show you how that list plugs into the tools you already use. It takes about 30 minutes.",
  },
  {
    q: 'What does purchase intent mean?',
    a: "It means someone recently looked up a topic, product, or service like yours. Searches, pages they read, things they compared. It tells you who is in the market today. It doesn't promise that person is ready to buy this minute.",
  },
  {
    q: 'How recent is the data?',
    a: 'It updates every day. You pick how far back to look, like the last 2 days or the last 7 days. Older activity drops off, so the list stays fresh.',
  },
  {
    q: 'Does it work for my industry?',
    a: "If people look up what you sell before they buy, yes. It covers business and consumer audiences anywhere in the country. Roofing, plumbing, HVAC, auto repair, logistics, dental, med spa, and plenty more. On the demo we'll show you the real number for your market.",
  },
  {
    q: 'Can I use the list in my own tools?',
    a: 'Yes. Export it, turn it into a Meta or Google audience, or send the contacts to your CRM and sales tools. Build the list once and use it everywhere.',
  },
  {
    q: 'Is this the same as Demand Flow?',
    a: "No. Demand Intelligence is the data. Demand Flow is the full system we run for you, with the ads, landing pages, follow-up, and the $50,000 guarantee. Demand Flow starts with Demand Intelligence. You can use the data on its own.",
  },
  {
    q: 'What does it cost?',
    a: "We go over scope and pricing on the demo, after we pull your market. We don't list a public price, because the right setup depends on how many markets and topics you need.",
  },
];

const url = 'https://www.deadrivermanagement.com/demand-intelligence/demo';
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'VideoObject',
    name: 'Demand Intelligence: Dallas roofing walkthrough',
    description: 'A product walkthrough filtering the Dallas roofing market by recent purchase-intent activity using two-day and seven-day lookback windows.',
    thumbnailUrl: `https://www.deadrivermanagement.com${video.poster}`,
    contentUrl: `https://www.deadrivermanagement.com${video.src}`,
    uploadDate: '2026-09-19',
    url,
  },
  faqPage(faqs),
];
---

<Growth
  title="See Who Is Shopping in Your Market | Demand Intelligence Demo"
  description="Watch a live walkthrough of Demand Intelligence pulling 4,500 people shopping for roofing in Dallas. Then book a demo and we build the list for your market."
  ogImage="/images/og/demand-intelligence.jpg"
  robots="noindex,nofollow"
  schema={schema}
  campaign
  campaignHref="#book"
  campaignLabel="Book a live demo"
  campaignShort="Book a demo"
>
  <section class="page-hero wrap has-scene vsl-hero">
    <HeroScene variant="signals" />
    <div class="page-hero-copy">
      <p class="eyebrow" data-rise>Demand Intelligence · Live walkthrough</p>
      <h1 data-split>See the people in your market who are looking for what you sell. <em>Today.</em></h1>
      <p class="intro" data-rise>
        Most ads guess. Demand Intelligence doesn't. It finds the people who looked up your service in the last few days and hands you the list. Watch the walkthrough. Then book a demo and we'll build the list for your business while you watch.
      </p>
    </div>
    <div class="vsl-frame" data-rise>
      <video
        class="vsl-video"
        controls
        playsinline
        preload="metadata"
        width="1920"
        height="1080"
        poster={video.poster}
        aria-label="Demand Intelligence walkthrough: pulling the Dallas roofing market by recent purchase intent"
      >
        <source src={video.src} type="video/mp4" />
        Your browser does not support video playback. <a href={video.src}>Download the walkthrough.</a>
      </video>
      <button class="vsl-play" type="button" aria-label="Play the walkthrough"><span></span></button>
    </div>
    <div class="vsl-hero-actions" data-rise>
      <div class="button-row">
        <a class="button" href="#book">Book a live demo <Arrow /></a>
        <a class="button secondary" href="tel:+19152283054">Call or text (915) 228-3054 <Arrow /></a>
      </div>
      <p class="vsl-note">Your market. Your numbers. A live list, built on the call.</p>
    </div>
  </section>

  <ClientTrust />

  <section class="section wrap" id="fit">
    <div class="section-head">
      <div>
        <p class="eyebrow">This is for you if</p>
        <h2>You're done guessing who to market to.</h2>
        <p class="intro">If any of these sound familiar, Demand Intelligence fixes the first step. The one everything else depends on.</p>
      </div>
    </div>
    <div class="steps home-steps">
      {pains.map(([title, body]) => (
        <article>
          <h3>{title}</h3>
          <p>{body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section soft band-dark" id="walkthrough">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">What you saw in the video</p>
          <h2>Three clicks. One list of real buyers.</h2>
          <p class="intro">That was Dallas roofing. On your demo we do the same thing for your business, your area, and the topics your customers look up.</p>
        </div>
      </div>
      <div class="steps home-steps vsl-steps">
        {walkthrough.map(([title, body], i) => (
          <article>
            <span class="number">Step {i + 1}</span>
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        ))}
      </div>
      <dl class="vsl-stats">
        {stats.map(([number, label]) => (
          <div>
            <dt>{label}</dt>
            <dd>{number}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section vsl-mechanism" id="how">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Where the list goes next</p>
          <h2>Target. Create. Capture. Convert.</h2>
          <p class="intro">Demand Intelligence tells us who is shopping. Demand Flow handles what happens next. Use the data on its own, or let us run the whole thing.</p>
        </div>
        <a class="text-link" href="/demand-flow#how">How Demand Flow works, start to finish <Arrow /></a>
      </div>
    </div>
    <div class="flow-stage" data-flow>
      <div class="wrap flow-track">
        <svg class="flow-line" viewBox="0 0 1200 220" preserveAspectRatio="none" aria-hidden="true">
          <path class="flow-glow flow-draw" d="M-20 170C180 175 230 40 420 60C600 80 560 190 760 150C930 115 980 20 1220 50" fill="none" stroke-linecap="round" />
          <path class="flow-path flow-draw" d="M-20 170C180 175 230 40 420 60C600 80 560 190 760 150C930 115 980 20 1220 50" fill="none" stroke-linecap="round" />
        </svg>
        <div class="steps home-steps flow-steps">
          {stages.map(([title, body], i) => (
            <article data-flow-step>
              <span class="number">Stage {i + 1}</span>
              <h3>{title}</h3>
              <p>{body}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section soft" id="results">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Proven results</p>
          <h2>What happens when the targeting is right.</h2>
          <p class="intro">Real businesses in different markets. Each case study shows its own results and timeframe. Your results will depend on your business.</p>
        </div>
        <a class="text-link" href="/work">View all case studies <Arrow /></a>
      </div>
      <div class="steps home-steps">
        {results.map(([name, headline, facts, href]) => (
          <article>
            <span class="number">{name}</span>
            <h3>{headline}</h3>
            <ul class="check-list">{facts.map((f) => <li>{f}</li>)}</ul>
            <a class="text-link" href={href}>Read the case study <Arrow /></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section wrap vsl-founder" id="founder">
    <div class="vsl-founder-photo">
      <img src="/50k-demand-flow/assets/brandon.jpg" alt="Brandon Aubey, founder of Dead River Management" width="640" height="800" loading="lazy" />
    </div>
    <div>
      <p class="eyebrow">Who I am</p>
      <h2>A bit about me.</h2>
      <p class="intro">I'm Brandon, and I run Dead River Management. We help businesses connect their marketing to paying customers.</p>
      <p>Demand Intelligence is how we find the people already shopping. Our Demand Flow system connects the ads, landing pages, replies, and follow-up that move them toward buying.</p>
      <p>On the demo I'll pull your market live, so you see the real number before you spend a dollar on ads.</p>
      <div class="button-row">
        <a class="button" href="#book">Book a live demo <Arrow /></a>
      </div>
    </div>
  </section>

  <section class="section soft band-dark vsl-book" id="book">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Book your live demo</p>
          <h2>Pick a time. We'll pull your market while you watch.</h2>
          <p class="intro">Here's what we'll go over together.</p>
        </div>
      </div>
      <div class="vsl-book-grid">
        <ul class="check-list">
          <li>The live purchase intent data for your market, pulled on the call.</li>
          <li>How many people are shopping for what you sell right now.</li>
          <li>How the list plugs into your ads, email, CRM, and sales tools.</li>
          <li>Whether Demand Flow and the $50,000 guarantee make sense for you.</li>
        </ul>
        <div class="vsl-calendar">
          <iframe
            src={DEMANDFLOW_CALENDAR_URL}
            allow="payment"
            style="width:100%;border:none;overflow:hidden;min-height:780px;"
            height="1100"
            scrolling="no"
            id="rfaj3m31onqPQEFYhwyE_di_demo"
            title="Book your Demand Intelligence demo"
            referrerpolicy="no-referrer"
          ></iframe>
          <script is:inline src="https://link.msgsndr.com/js/form_embed.js" type="text/javascript"></script>
          <p class="vsl-note">
            Can't find a time that works? Call or text <a href="tel:+19152283054">(915) 228-3054</a>, or <a href={DEMANDFLOW_CALENDAR_URL} target="_blank" rel="noopener">open the calendar in a new tab</a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section wrap" id="faq">
    <div class="section-head">
      <div>
        <p class="eyebrow">FAQ</p>
        <h2>What people ask before they book.</h2>
      </div>
    </div>
    <FaqList items={faqs} />
  </section>

  <section class="section closing wrap">
    <p class="eyebrow">One more thing</p>
    <h2>See your market before you spend a dollar on ads.</h2>
    <div class="button-row">
      <a class="button" href="#book">Book a live demo <Arrow /></a>
      <a class="text-link" href="/demand-intelligence">Explore Demand Intelligence <Arrow /></a>
    </div>
  </section>
</Growth>

<style>
  .vsl-hero.page-hero.has-scene {
    min-height: 0;
    padding-bottom: 32px;
  }
  .vsl-hero .page-hero-copy {
    max-width: 860px;
  }
  .vsl-hero h1 em {
    color: var(--ember);
    font-style: normal;
  }
  .vsl-frame {
    position: relative;
    width: min(100%, 1040px);
    margin-top: 40px;
    border-radius: 20px;
    overflow: hidden;
    background: #000;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow:
      0 40px 120px -30px rgba(0, 0, 0, 0.9),
      0 0 0 1px rgba(227, 160, 112, 0.12),
      0 0 120px -20px rgba(227, 160, 112, 0.35);
  }
  .vsl-video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
  }
  .vsl-play {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    border: 0;
    padding: 0;
    cursor: pointer;
    background: rgba(10, 10, 11, 0.18);
    transition: opacity 0.4s ease;
  }
  .vsl-play span {
    width: 104px;
    height: 104px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: linear-gradient(180deg, var(--ember), var(--copper-deep));
    box-shadow:
      0 20px 60px -10px rgba(227, 160, 112, 0.7),
      0 0 0 14px rgba(227, 160, 112, 0.12);
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .vsl-play span::after {
    content: '';
    margin-left: 6px;
    border-left: 32px solid #140b04;
    border-top: 20px solid transparent;
    border-bottom: 20px solid transparent;
  }
  .vsl-play:hover span {
    transform: scale(1.06);
  }
  .vsl-frame.is-playing .vsl-play {
    opacity: 0;
    pointer-events: none;
  }
  .vsl-hero-actions {
    margin-top: 28px;
  }
  .vsl-note {
    margin-top: 14px;
    font-size: 14px;
    color: var(--muted);
  }
  .vsl-note a {
    color: var(--ink);
  }
  .vsl-steps {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .vsl-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin: 56px 0 0;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.12);
  }
  .vsl-stats > div {
    padding: 26px 28px;
    background: var(--paper);
  }
  .vsl-stats dt {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .vsl-stats dd {
    margin: 10px 0 0;
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(36px, 4vw, 52px);
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--ember);
  }
  .vsl-founder {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }
  .vsl-founder-photo {
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: var(--cream);
    aspect-ratio: 4 / 5;
  }
  .vsl-founder-photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .vsl-founder p {
    color: #cfccc4;
  }
  .vsl-founder .button-row {
    margin-top: 24px;
  }
  .vsl-book-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.6fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }
  .vsl-calendar {
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: #fff;
    padding: 8px;
  }
  .vsl-calendar .vsl-note {
    padding: 14px 12px 8px;
    color: #4a4945;
  }
  .vsl-calendar .vsl-note a {
    color: var(--copper-deep);
  }
  @media (max-width: 1000px) {
    .vsl-steps {
      grid-template-columns: 1fr;
    }
    .vsl-founder,
    .vsl-book-grid {
      grid-template-columns: 1fr;
    }
    .vsl-founder-photo {
      max-width: 420px;
    }
  }
  @media (max-width: 620px) {
    .vsl-play span {
      width: 72px;
      height: 72px;
    }
    .vsl-play span::after {
      border-left-width: 22px;
      border-top-width: 14px;
      border-bottom-width: 14px;
    }
    .vsl-stats {
      grid-template-columns: 1fr;
    }
    .vsl-frame {
      margin-top: 28px;
      border-radius: 14px;
    }
  }
</style>

<script>
  // The copper play button covers the poster until the first play. The
  // native controls take over from there.
  const frame = document.querySelector('.vsl-frame');
  const media = frame?.querySelector('video');
  const play = frame?.querySelector('.vsl-play');
  if (frame && media && play) {
    play.addEventListener('click', () => media.play());
    media.addEventListener('play', () => frame.classList.add('is-playing'));
  }
</script>
