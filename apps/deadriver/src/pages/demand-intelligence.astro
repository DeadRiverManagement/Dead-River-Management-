---
import Growth from '../layouts/Growth.astro';
import Arrow from '../components/growth/Arrow.astro';
// Owner confirmed these shared platform figures on October 5, 2026.
// AudienceLab customer counts and customer results do not belong to DRM.
const stats = [
  ['280M', 'U.S. consumer profiles', 'Audience coverage across consumer markets.'],
  ['95%', 'Contact-data accuracy', 'Accuracy of matched contact information.'],
  ['60B', 'Weekly behaviors and URLs', 'Research activity used to build focused audiences.'],
];
const capabilities = [
  ['01', 'Find your audience.', 'Start with what people are researching. Narrow your audience by topic, location and recent activity, then add the business or consumer filters that matter to your campaign.', ['Purchase-intent signals', 'Location and recency filters', 'Business and consumer audiences']],
  ['02', 'Identify website visitors.', 'Connect website activity with matched visitor profiles. See who is engaging with your business and build audiences for your next campaign.', ['Visitor identification', 'Matched contact profiles', 'Retargeting audiences']],
  ['03', 'Fill in the missing details.', 'Enrich contact records with available consumer and business information. Give your sales and marketing teams a clearer picture of who they are trying to reach.', ['Contact enrichment', 'Business attributes', 'Consumer attributes']],
  ['04', 'Put your data to work.', 'Export focused lists and prepare audiences for your advertising and sales tools. Use the same audience intelligence across your campaigns instead of starting from scratch in each platform.', ['Audience exports', 'Meta and Google audiences', 'Sales and marketing activation']],
];
const faqs = [
  ['What does Demand Intelligence do?', 'Demand Intelligence helps you find audiences showing relevant research activity, identify matched website visitors, enrich contact information and use those audiences in your marketing and sales tools.'],
  ['What does purchase intent mean?', 'Purchase-intent signals indicate that someone has recently researched a relevant topic, product or service. They help you focus your audience, but do not guarantee that a person is qualified or ready to buy.'],
  ['How recent are the signals?', 'The platform refreshes intent data daily. You can filter by the available lookback windows, including the last two or seven days shown in our Dallas roofing walkthrough.'],
  ['Does it support businesses and consumers?', 'Yes. Build business and consumer audiences nationwide, using the topics, locations and attributes available for your market.'],
  ['Can I use the audiences in my existing tools?', 'You can export lists and prepare audiences for Meta and Google. On the demo, we show how the available exports and connections fit your current tools.'],
  ['Is this the same as Demand Flow?', 'Demand Intelligence is the data platform. Demand Flow is our managed marketing system, which uses audience intelligence alongside advertising, landing pages and follow-up.'],
];
const schema = [
  {'@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Demand Intelligence', applicationCategory: 'BusinessApplication', operatingSystem: 'Web', description: 'A purchase-intent audience platform for audience building, website visitor identification, contact enrichment and campaign activation.'},
  {'@context': 'https://schema.org', '@type': 'VideoObject', name: 'Demand Intelligence: Dallas roofing walkthrough', description: 'A product walkthrough filtering the Dallas roofing market by recent purchase-intent activity using two-day and seven-day lookback windows.', thumbnailUrl: 'https://www.deadrivermanagement.com/media/demand-intelligence-walkthrough-poster.jpg', contentUrl: 'https://www.deadrivermanagement.com/media/demand-intelligence-walkthrough.mp4', uploadDate: '2026-09-19'},
  {'@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({'@type': 'Question', name, acceptedAnswer: {'@type': 'Answer', text}}))},
];
---

<Growth title="Buyer Intent & Audience Data | Demand Intelligence" description="Find people researching what you sell. Build audiences, identify website visitors, enrich contacts and activate your data with Demand Intelligence." ogImage="/media/demand-intelligence-walkthrough-poster.jpg" schema={schema} campaign={true} campaignHref="#di-demo" campaignLabel="See a live demo" campaignShort="See a demo">
  <div class="di-product">
    <section class="di-hero di-wrap">
      <div class="di-hero-copy">
        <p class="di-label"><span></span> Demand Intelligence</p>
        <h1>Find the people.<br />See the intent.<br /><em>Reach your market.</em></h1>
        <p class="di-intro">Your next customer is already researching. Demand Intelligence helps you find that audience and put it to work across your advertising and sales tools.</p>
        <div class="di-actions"><a class="di-button" href="#di-demo">See a live demo <Arrow /></a><a class="di-watch" href="#platform"><span aria-hidden="true">▶</span> Watch the platform</a></div>
        <p class="di-hero-note">Business and consumer data. Nationwide coverage. Daily intent refresh.</p>
      </div>
      <div class="di-audience-visual" aria-label="Illustration of audience research filters, not a live search result">
        <div class="di-visual-top"><span class="di-mini-mark">di</span><span>Audience explorer</span><span class="di-visual-caption">Illustration</span></div>
        <div class="di-search"><span aria-hidden="true">⌕</span> What is your audience researching?</div>
        <div class="di-filters"><span>Roofing</span><span>Dallas, Texas</span><span>Last 2–7 days</span></div>
        <svg class="di-network" viewBox="0 0 520 280" fill="none" aria-hidden="true">
          <defs><radialGradient id="di-glow"><stop stop-color="#b6f5c9" stop-opacity=".28"/><stop offset="1" stop-color="#b6f5c9" stop-opacity="0"/></radialGradient></defs>
          <circle cx="260" cy="140" r="134" fill="url(#di-glow)"/>
          <g stroke="#587666" stroke-width="1"><path d="M260 140L90 52M260 140L170 38M260 140L340 40M260 140L432 88M260 140L430 220M260 140L320 245M260 140L115 225M260 140L52 148M90 52L170 38L340 40L432 88L430 220L320 245L115 225L52 148Z"/><path d="M90 52L115 225M170 38L320 245M340 40L430 220M52 148L432 88" stroke-opacity=".35"/></g>
          <g fill="#b6f5c9"><circle cx="90" cy="52" r="6"/><circle cx="170" cy="38" r="5"/><circle cx="340" cy="40" r="7"/><circle cx="432" cy="88" r="5"/><circle cx="430" cy="220" r="7"/><circle cx="320" cy="245" r="5"/><circle cx="115" cy="225" r="7"/><circle cx="52" cy="148" r="5"/></g>
          <circle cx="260" cy="140" r="52" fill="#14281e" stroke="#b6f5c9" stroke-opacity=".45"/><circle cx="260" cy="140" r="38" stroke="#b6f5c9" stroke-opacity=".25"/>
          <path d="M245 140l10 10 22-23" stroke="#b6f5c9" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <div class="di-visual-bottom"><span><i></i> Recent research activity</span><span>Focused audience <Arrow /></span></div>
      </div>
    </section>

    <section class="di-data di-wrap" aria-labelledby="data-heading">
      <div class="di-section-intro"><p class="di-label">The data behind your audience</p><h2 id="data-heading">A bigger picture.<br />A sharper audience.</h2></div>
      <div class="di-stats">{stats.map(([number, label, detail]) => <article><strong>{number}</strong><h3>{label}</h3><p>{detail}</p></article>)}</div>
    </section>

    <section class="di-problem di-wrap">
      <p class="di-label">Take control of your targeting</p>
      <h2>A broad audience is easy.<br /><em>A relevant audience is the point.</em></h2>
      <p class="di-section-copy">A job title or a location only tells you part of the story. Add what people are researching, when they researched it and how it fits your market. Give your next campaign a more focused starting point.</p>
      <div class="di-process"><span>Research activity</span><b aria-hidden="true">→</b><span>Matched profiles</span><b aria-hidden="true">→</b><span>Your audience</span><b aria-hidden="true">→</b><span>Your campaigns</span></div>
    </section>

    <section class="di-capabilities di-wrap" id="capabilities">
      <div class="di-section-intro"><p class="di-label">One platform. Four practical jobs.</p><h2>From intent to action.</h2></div>
      {capabilities.map(([number, title, description, tags]) => <article class="di-capability"><span class="di-step">{number}</span><div><h3>{title}</h3><p>{description}</p></div><ul>{tags.map(tag => <li>{tag}</li>)}</ul></article>)}
    </section>

    <section class="di-demo-video di-wrap" id="platform">
      <div class="di-section-intro di-video-intro"><div><p class="di-label">See the actual platform</p><h2>Your market.<br />Your audience.<br /><em>Right on screen.</em></h2></div><p>Watch us search the Dallas roofing market and filter recent research activity. The walkthrough shows the last two days and the last seven days, so you can see how recency changes the audience.</p></div>
      <figure><video controls preload="metadata" playsinline poster="/media/demand-intelligence-walkthrough-poster.jpg" width="1920" height="1080" aria-label="Demand Intelligence Dallas roofing walkthrough"><source src="/media/demand-intelligence-walkthrough.mp4" type="video/mp4" />Your browser does not support this video. <a href="/media/demand-intelligence-walkthrough.mp4">Download the walkthrough.</a></video><figcaption>Dallas roofing demonstration. Audience counts reflect the recorded search.</figcaption></figure>
    </section>

    <section class="di-activation di-wrap">
      <div><p class="di-label">Built for the way you work</p><h2>Your data should<br />move with you.</h2><p class="di-section-copy">Build the audience once. Export the list, prepare an advertising audience or bring enriched contact information into your sales tools.</p><a class="di-text-link" href="#di-demo">See it with your use case <Arrow /></a></div>
      <div class="di-tools" aria-label="Audience activation use cases"><span>Meta Ads</span><span>Google Ads</span><span>Contact lists</span><span>Customer management</span><span>Audience exports</span><span>Sales tools</span></div>
    </section>

    <section class="di-questions di-wrap" aria-labelledby="questions-heading"><div><p class="di-label">A closer look</p><h2 id="questions-heading">What you<br />want to know.</h2></div><div>{faqs.map(([question, answer]) => <article><h3>{question}</h3><p>{answer}</p></article>)}</div></section>

    <section class="di-demo-section di-wrap">
      <div><p class="di-label">See Demand Intelligence</p><h2>Let’s look at<br /><em>your market.</em></h2><p class="di-section-copy">Tell us who you want to reach. We’ll walk through the platform and show how to build an audience around your business, your location and what your customers are researching.</p><p class="di-demo-detail">A live product walkthrough with the Dead River Management team.</p></div>
      <form class="di-form" id="di-demo" data-redirect="/demand-intelligence/thanks">
        <h3>Request your demo</h3><p class="di-form-sub">See what the platform can do for your team.</p>
        <label class="field">Name<input name="name" type="text" autocomplete="name" maxlength="120" required /></label>
        <label class="field">Phone number<input name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="40" pattern="[+()\d\s.\-]{7,40}" required /></label>
        <label class="field">Email<input name="email" type="email" autocomplete="email" maxlength="200" required /></label>
        <label class="di-hp" aria-hidden="true">Fax<input name="fax" type="text" tabindex="-1" autocomplete="off" /></label>
        <button class="di-button di-submit" type="submit">Request my demo <Arrow /></button>
        <p class="di-form-status" role="status" aria-live="polite"></p>
        <p class="di-form-fine">By submitting, you agree that Dead River Management may contact you about your demo by phone or email. <a href="/privacy">Privacy policy</a>.</p>
      </form>
    </section>
  </div>
</Growth>

<script>import '../scripts/di-lead.js';</script>

<style>
  :global(body:has(.di-product)) { --paper:#0b100e; --ink:#f3f6f3; --muted:#a5b2aa; --green:#b6f5c9; --line:#28362e; --copper:#b6f5c9; background:var(--paper); }
  :global(body:has(.di-product) .site-header) { background:#0b100ef2; border-color:#28362e; }
  :global(body:has(.di-product) .brand img) { filter:brightness(0) invert(1); }
  :global(body:has(.di-product) .site-header .button) { background:#b6f5c9; color:#10251a; border-color:#b6f5c9; }
  :global(body:has(.di-product) .site-footer) { background:#0b100e; color:#a5b2aa; border-top:1px solid #28362e; }
  :global(body:has(.di-product) .nav-contact) { color:#a5b2aa; }
  .di-product { overflow:hidden; background:radial-gradient(ellipse at 75% 8%,#193b2626,transparent 30%),#0b100e; }
  .di-wrap { width:min(1280px,calc(100% - 96px)); margin-inline:auto; }
  .di-label { color:#b6f5c9; font-size:12px; font-weight:600; letter-spacing:.14em; text-transform:uppercase; margin-bottom:25px; display:flex; align-items:center; gap:10px; }
  .di-label span { width:7px; height:7px; background:#b6f5c9; border-radius:50%; }
  h1,h2,h3 { color:#f3f6f3; }
  h1 { font-size:clamp(48px,5.2vw,76px); line-height:1.06; letter-spacing:-.055em; }
  h2 { font-size:clamp(36px,4vw,56px); line-height:1.1; letter-spacing:-.045em; }
  em { color:#b6f5c9; font-style:normal; }
  .di-hero { display:grid; grid-template-columns:1.15fr 1fr; gap:64px; align-items:center; padding:98px 0 110px; }
  .di-intro { font-size:18px; line-height:1.7; max-width:510px; margin-top:28px; }
  .di-actions { display:flex; gap:28px; align-items:center; margin-top:34px; flex-wrap:wrap; }
  .di-button { display:inline-flex; align-items:center; justify-content:center; gap:24px; background:#b6f5c9; color:#10251a; border:1px solid #b6f5c9; border-radius:7px; padding:17px 23px; font-weight:600; font-size:15px; }
  .di-button:hover { background:#d0ffdf; color:#10251a; transform:translateY(-2px); }
  .di-button svg,.di-text-link svg,.di-visual-bottom svg { width:18px; }
  .di-watch { font-size:14px; color:#f3f6f3; display:flex; align-items:center; gap:12px; }
  .di-watch span { width:32px; height:32px; display:grid; place-items:center; border:1px solid #425d4e; border-radius:50%; font-size:10px; color:#b6f5c9; }
  .di-hero-note { margin-top:28px; font-size:12px; color:#82958a; max-width:410px; }
  .di-audience-visual { background:linear-gradient(150deg,#15231b,#0e1712); border:1px solid #344d3e; border-radius:14px; padding:24px; transform:rotate(-2deg); box-shadow:0 35px 70px #030b0640; }
  .di-visual-top { display:flex; align-items:center; gap:12px; color:#e6efe8; font-size:13px; }
  .di-mini-mark { color:#b6f5c9; font-size:24px; font-weight:600; letter-spacing:-.08em; }
  .di-visual-caption { margin-left:auto; color:#819488; font-size:10px; text-transform:uppercase; letter-spacing:.1em; }
  .di-search { background:#0b120e; border:1px solid #2d4134; border-radius:6px; margin-top:25px; padding:14px; font-size:12px; color:#a5b2aa; display:flex; gap:12px; }
  .di-search span { font-size:21px; color:#b6f5c9; line-height:1; }
  .di-filters { display:flex; flex-wrap:wrap; gap:7px; margin-top:12px; }
  .di-filters span { padding:5px 9px; background:#223c2c; border:1px solid #36513f; color:#c4e4cf; font-size:10px; border-radius:4px; }
  .di-network { width:100%; display:block; margin:5px 0; }
  .di-visual-bottom { display:flex; justify-content:space-between; gap:15px; padding-top:17px; border-top:1px solid #2d4134; color:#a8bfb0; font-size:10px; }
  .di-visual-bottom span { display:flex; gap:7px; align-items:center; }
  .di-visual-bottom i { width:5px; height:5px; border-radius:50%; background:#b6f5c9; }
  .di-data { border-top:1px solid #28362e; padding-top:62px; padding-bottom:88px; }
  .di-section-intro { margin-bottom:42px; }
  .di-section-intro .di-label { margin-bottom:18px; }
  .di-stats { display:grid; grid-template-columns:repeat(3,1fr); gap:40px; }
  .di-stats article { padding:15px 0 5px; border-top:1px solid #34483b; }
  .di-stats strong { display:block; font-size:clamp(60px,6.6vw,90px); font-family:var(--display); font-variant-numeric:tabular-nums; line-height:1.2; letter-spacing:-.06em; color:#b6f5c9; }
  .di-stats h3 { font-family:var(--body); font-size:16px; letter-spacing:0; margin:14px 0 10px; }
  .di-stats p { font-size:13px; max-width:270px; }
  .di-problem { border-top:1px solid #28362e; padding:84px 0; }
  .di-section-copy { font-size:17px; line-height:1.8; max-width:600px; margin-top:25px; }
  .di-process { margin-top:38px; display:flex; align-items:center; gap:20px; flex-wrap:wrap; font-size:13px; }
  .di-process span { padding:12px 17px; background:#14221a; border:1px solid #2f4537; border-radius:4px; }
  .di-process b { color:#b6f5c9; font-weight:400; }
  .di-capabilities { padding:50px 0 80px; }
  .di-capability { display:grid; grid-template-columns:70px 1fr .6fr; gap:35px; padding:38px 0; border-top:1px solid #28362e; align-items:start; }
  .di-step { font-family:var(--display); color:#698674; font-size:23px; }
  .di-capability h3 { font-size:31px; margin-bottom:15px; }
  .di-capability p { font-size:15px; max-width:560px; line-height:1.8; }
  .di-capability ul { list-style:none; padding:0; display:flex; flex-direction:column; gap:12px; font-size:13px; color:#c3d4c8; }
  .di-capability li::before { content:'↗'; color:#b6f5c9; margin-right:12px; }
  .di-demo-video { padding:70px 0 90px; border-top:1px solid #28362e; }
  .di-video-intro { display:grid; grid-template-columns:1fr .7fr; align-items:end; gap:70px; }
  .di-video-intro > p { max-width:430px; font-size:16px; line-height:1.8; }
  video { width:100%; height:auto; display:block; border-radius:10px; background:#14221a; border:1px solid #34483b; }
  figcaption { color:#82958a; font-size:12px; margin-top:12px; }
  .di-activation { padding:60px 0 100px; display:grid; grid-template-columns:1fr 1fr; gap:100px; align-items:center; }
  .di-text-link { display:inline-flex; align-items:center; gap:20px; color:#b6f5c9; font-size:14px; margin-top:25px; }
  .di-tools { display:grid; grid-template-columns:1fr 1fr; gap:15px; }
  .di-tools span { border:1px solid #32473a; border-radius:6px; padding:30px 18px; text-align:center; font-size:15px; color:#d5e2d9; background:#14221a; }
  .di-questions { border-top:1px solid #28362e; padding:85px 0; display:grid; grid-template-columns:.7fr 1fr; gap:100px; }
  .di-questions article { margin-bottom:28px; padding-bottom:28px; border-bottom:1px solid #28362e; }
  .di-questions h3 { font-family:var(--body); font-size:17px; letter-spacing:-.01em; margin-bottom:13px; }
  .di-questions p { font-size:14px; line-height:1.8; }
  .di-demo-section { border-top:1px solid #28362e; padding:95px 0 110px; display:grid; grid-template-columns:1fr .8fr; gap:100px; align-items:center; }
  .di-demo-detail { font-size:13px; color:#b6f5c9; margin-top:25px; }
  .di-form { background:#14221a; border:1px solid #34483b; border-radius:12px; padding:32px; }
  .di-form h3 { font-size:28px; }
  .di-form-sub { font-size:14px; margin:10px 0 24px; }
  .di-form .field { display:flex; flex-direction:column; gap:7px; margin-bottom:17px; color:#d5e2d9; font-size:13px; }
  .di-form input { background:#0b120e; border:1px solid #405648; border-radius:5px; color:#f3f6f3; padding:13px; width:100%; }
  .di-submit { width:100%; margin-top:6px; }
  .di-submit:disabled { opacity:.6; cursor:wait; }
  .di-hp { position:absolute; left:-9999px; }
  .di-form-status:empty { display:none; }
  .di-form-status { margin-top:15px; font-size:14px; color:#b6f5c9; }
  .di-form-status[data-state='error'] { color:#ffb8a4; }
  .di-form-fine { font-size:11px; color:#91a398; margin-top:16px; line-height:1.7; }
  .di-form-fine a { text-decoration:underline; }
  @media(max-width:1000px) { .di-hero { gap:35px; } h1 { font-size:54px; } .di-activation,.di-questions,.di-demo-section { gap:45px; } .di-wrap { width:calc(100% - 64px); } }
  @media(max-width:760px) { .di-wrap { width:calc(100% - 40px); } .di-hero { grid-template-columns:1fr; padding:62px 0 72px; gap:46px; } h1 { font-size:clamp(43px,9vw,62px); } .di-audience-visual { transform:none; } .di-stats { gap:18px; } .di-stats strong { font-size:49px; } .di-stats h3 { font-size:13px; } .di-stats p { font-size:11px; } .di-capability { grid-template-columns:35px 1fr; gap:17px; } .di-capability ul { grid-column:2; } .di-video-intro,.di-activation,.di-questions,.di-demo-section { grid-template-columns:1fr; gap:35px; } .di-video-intro > p { max-width:100%; } .di-data,.di-problem,.di-demo-video,.di-questions,.di-demo-section { padding-block:60px; } .di-process { gap:9px; } .di-process span { padding:9px 11px; font-size:11px; } .di-process b { display:none; } .di-tools span { padding:24px 12px; } }
  @media(max-width:420px) { .di-stats { grid-template-columns:1fr; gap:24px; } .di-stats article { display:grid; grid-template-columns:115px 1fr; column-gap:15px; } .di-stats strong { grid-row:span 2; font-size:50px; } .di-stats h3 { margin:8px 0; } .di-actions { gap:20px; } .di-form { padding:25px 20px; } }
  @media(prefers-reduced-motion:reduce) { .di-button { transition:none; } .di-button:hover { transform:none; } }
</style>
