---
import Growth from '../layouts/Growth.astro';
import Arrow from '../components/growth/Arrow.astro';
import { breadcrumbList } from '../lib/schema';
// Owner confirmed these shared platform figures on October 5, 2026.
// AudienceLab customer counts and customer results do not belong to DRM.
const stats = [
  ['280M', 'U.S. consumer profiles', 'Coverage across consumer markets.'],
  ['95%', 'Contact-data accuracy', 'How accurate the matched contact details are.'],
  ['60B', 'Weekly behaviors and URLs', 'The research activity we use to build your list.'],
];
const capabilities = [
  ['01', 'Find your audience.', 'Start with what people are looking up. Narrow the list by topic, location, and how recent the activity is. Then add the business or consumer filters that matter to you.', ['Purchase-intent signals', 'Location and recency filters', 'Business and consumer audiences']],
  ['02', 'Identify website visitors.', 'Match the people visiting your website to real profiles. See who is checking out your business and build a list for your next campaign.', ['Visitor identification', 'Matched contact profiles', 'Retargeting audiences']],
  ['03', 'Fill in the missing details.', "Add the consumer and business details we've to your contact records. Your sales and marketing teams get a clearer picture of who they're reaching.", ['Contact enrichment', 'Business attributes', 'Consumer attributes']],
  ['04', 'Put your data to work.', 'Export your lists and set up audiences for your ad and sales tools. Use the same list across all your campaigns instead of starting over in each platform.', ['Audience exports', 'Meta and Google audiences', 'Sales and marketing activation']],
];
const faqs = [
  ['What does Demand Intelligence do?', 'It finds people who have been looking up what you offer, matches your website visitors to real profiles, fills in missing contact details, and lets you use those lists in your marketing and sales tools.'],
  ['What does purchase intent mean?', "It means someone recently looked up a topic, product, or service like yours. It helps you focus on the right people. It doesn't guarantee that person is ready to buy."],
  ['How recent are the signals?', 'The data updates every day. You can filter by how far back to look, like the last two days or the last seven days.'],
  ['Does it support businesses and consumers?', 'Yes. You can build business and consumer lists anywhere in the country, using the topics, locations, and details available for your market.'],
  ['Can I use the audiences in my existing tools?', 'Yes. You can export lists and set up audiences for Meta and Google. On the demo, we show you how the exports and connections fit the tools you already use.'],
  ['What is buyer intent data?', "Same thing as purchase intent data. It's the signs that a person or company is looking up a product or service right now, like searches, page visits, and articles read in the last few days. It tells you who is in the market today, so you can reach them before they pick someone else."],
  ['How do I get intent data for my business?', "Through a platform that collects and matches the signals, like Demand Intelligence. You tell us the topics and locations that matter. The platform sends you the matching list every day, and you use it in email, ads, or calls. Book a demo and we'll show you the live numbers for your market."],
  ['Is this the same as Demand Flow?', 'No. Demand Intelligence is the data platform. Demand Flow is the marketing system we run for you. It uses this data along with ads, landing pages, and follow-up.'],
];
// Pulse points on the intent map (percent positions on the lower-48 dot map).
const _unusedPulses = [
  ['El Paso', 31.64, 70.51, 0], ['Dallas', 48.21, 66.48, .6], ['Houston', 50.65, 78.42, 2.4], ['Phoenix', 22.1, 63.83, 1.3], ['Las Cruces', 31.15, 68.34, 3.1],
  ['Denver', 34.21, 38.97, 1.9], ['Atlanta', 69.42, 62.65, .9], ['Chicago', 63.88, 30.51, 2.8], ['Miami', 76.6, 94.23, 1.6], ['Los Angeles', 11.56, 61.46, 2.2],
  ['Seattle', 4.56, 7.87, 3.4], ['New York', 87.16, 35.14, .3], ['Nashville', 65.33, 53.12, 2.6], ['Kansas City', 52.0, 41.5, 1.1], ['Minneapolis', 54.24, 18.26, 3.7],
  ['Charlotte', 75.49, 56.8, 2.0], ['Salt Lake City', 22.41, 34.94, 1.5], ['San Antonio', 45.32, 79.76, 3.0], ['Boston', 92.21, 28.62, 2.3], ['Tampa', 72.72, 85.57, .8],
];
const schema = [
  {'@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Demand Intelligence', applicationCategory: 'BusinessApplication', operatingSystem: 'Web', description: 'A purchase-intent audience platform for audience building, website visitor identification, contact enrichment and campaign activation.'},
  {'@context': 'https://schema.org', '@type': 'VideoObject', name: 'Demand Intelligence: Dallas roofing walkthrough', description: 'A product walkthrough filtering the Dallas roofing market by recent purchase-intent activity using two-day and seven-day lookback windows.', thumbnailUrl: 'https://www.deadrivermanagement.com/media/demand-intelligence-walkthrough-poster.jpg', contentUrl: 'https://www.deadrivermanagement.com/media/demand-intelligence-walkthrough.mp4', uploadDate: '2026-09-19'},
  {'@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({'@type': 'Question', name, acceptedAnswer: {'@type': 'Answer', text}}))},
  breadcrumbList([
    { name: 'Home', path: '/' },
    { name: 'Demand Intelligence', path: '/demand-intelligence' },
  ]),
];
---

