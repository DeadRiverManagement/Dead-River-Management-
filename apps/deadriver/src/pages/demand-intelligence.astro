---
import Growth from '../layouts/Growth.astro';
import Arrow from '../components/growth/Arrow.astro';
// Owner confirmed these shared platform figures on October 5, 2026.
// AudienceLab customer counts and customer results do not belong to DRM.
const stats = [
  ['280M', 'U.S. consumer profiles', 'Audience coverage across consumer markets.'],
  ['95%', 'Contact-data accuracy', 'Accuracy of matched contact information.'],
  ['60B', 'Weekly behaviors and URLs', 'Research activity used to build focused audiences.'],
];
const capabilities = [
  ['01', 'Find your audience.', 'Start with what people are researching. Narrow your audience by topic, location and recent activity, then add the business or consumer filters that matter to your campaign.', ['Purchase-intent signals', 'Location and recency filters', 'Business and consumer audiences']],
  ['02', 'Identify website visitors.', 'Connect website activity with matched visitor profiles. See who is engaging with your business and build audiences for your next campaign.', ['Visitor identification', 'Matched contact profiles', 'Retargeting audiences']],
  ['03', 'Fill in the missing details.', 'Enrich contact records with available consumer and business information. Give your sales and marketing teams a clearer picture of who they are trying to reach.', ['Contact enrichment', 'Business attributes', 'Consumer attributes']],
  ['04', 'Put your data to work.', 'Export focused lists and prepare audiences for your advertising and sales tools. Use the same audience intelligence across your campaigns instead of starting from scratch in each platform.', ['Audience exports', 'Meta and Google audiences', 'Sales and marketing activation']],
];
const faqs = [
  ['What does Demand Intelligence do?', 'Demand Intelligence helps you find audiences showing relevant research activity, identify matched website visitors, enrich contact information and use those audiences in your marketing and sales tools.'],
  ['What does purchase intent mean?', 'Purchase-intent signals indicate that someone has recently researched a relevant topic, product or service. They help you focus your audience, but do not guarantee that a person is qualified or ready to buy.'],
  ['How recent are the signals?', 'The platform refreshes intent data daily. You can filter by the available lookback windows, including the last two or seven days shown in our Dallas roofing walkthrough.'],
  ['Does it support businesses and consumers?', 'Yes. Build business and consumer audiences nationwide, using the topics, locations and attributes available for your market.'],
  ['Can I use the audiences in my existing tools?', 'You can export lists and prepare audiences for Meta and Google. On the demo, we show how the available exports and connections fit your current tools.'],
  ['What is buyer intent data?', 'Buyer intent data is the same thing as purchase intent data: signals that a person or company is actively researching a product or service right now, such as searches, page visits and content reads in the last few days. It tells you who is in the market today, so you can reach them before they pick someone else.'],
  ['How do I get intent data for my business?', 'Through a platform that collects and matches the signals, like Demand Intelligence. You tell us the topics and locations that matter, the platform delivers the matching audiences daily, and you use them in email, ads or calls. Book a demo and we will show you the live reach for your market.'],
  ['Is this the same as Demand Flow?', 'Demand Intelligence is the data platform. Demand Flow is our managed marketing system, which uses audience intelligence alongside advertising, landing pages and follow-up.'],
];
// Pulse points on the intent map (percent positions on the lower-48 dot map).
const pulses = [
  ['El Paso', 31.64, 70.51, 0], ['Dallas', 48.21, 66.48, .6], ['Houston', 50.65, 78.42, 2.4], ['Phoenix', 22.1, 63.83, 1.3], ['Las Cruces', 31.15, 68.34, 3.1],
  ['Denver', 34.21, 38.97, 1.9], ['Atlanta', 69.42, 62.65, .9], ['Chicago', 63.88, 30.51, 2.8], ['Miami', 76.6, 94.23, 1.6], ['Los Angeles', 11.56, 61.46, 2.2],
  ['Seattle', 4.56, 7.87, 3.4], ['New York', 87.16, 35.14, .3], ['Nashville', 65.33, 53.12, 2.6], ['Kansas City', 52.0, 41.5, 1.1], ['Minneapolis', 54.24, 18.26, 3.7],
  ['Charlotte', 75.49, 56.8, 2.0], ['Salt Lake City', 22.41, 34.94, 1.5], ['San Antonio', 45.32, 79.76, 3.0], ['Boston', 92.21, 28.62, 2.3], ['Tampa', 72.72, 85.57, .8],
];
const schema = [
  {'@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Demand Intelligence', applicationCategory: 'BusinessApplication', operatingSystem: 'Web', description: 'A purchase-intent audience platform for audience building, website visitor identification, contact enrichment and campaign activation.'},
  {'@context': 'https://schema.org', '@type': 'VideoObject', name: 'Demand Intelligence: Dallas roofing walkthrough', description: 'A product walkthrough filtering the Dallas roofing market by recent purchase-intent activity using two-day and seven-day lookback windows.', thumbnailUrl: 'https://www.deadrivermanagement.com/media/demand-intelligence-walkthrough-poster.jpg', contentUrl: 'https://www.deadrivermanagement.com/media/demand-intelligence-walkthrough.mp4', uploadDate: '2026-09-19'},
  {'@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({'@type': 'Question', name, acceptedAnswer: {'@type': 'Answer', text}}))},
];
---

<Growth title="Buyer Intent & Audience Data | Demand Intelligence" description="Find people researching what you sell. Build audiences, identify website visitors, enrich contacts and activate your data with Demand Intelligence." ogImage="/media/demand-intelligence-walkthrough-poster.jpg" schema={schema}>
  <div class="di-product">
    <section class="di-hero di-wrap">
      <div class="di-glass di-glass-a" aria-hidden="true"></div>
      <div class="di-glass di-glass-b" aria-hidden="true"></div>
      <div class="di-hero-copy">
        <p class="di-label"><span></span> Demand Intelligence</p>
        <h1>Find the people.<br />See the intent.<br /><em>Reach your market.</em></h1>
        <p class="di-intro">Your next customer is already researching. Demand Intelligence helps you find that audience and put it to work across your advertising and sales tools.</p>
        <div class="di-actions"><a class="di-button" href="#di-demo">See a live demo <Arrow /></a><a class="di-watch" href="#platform"><span aria-hidden="true">▶</span> Watch the platform</a></div>
        <p class="di-hero-note">Business and consumer data. Nationwide coverage. Daily intent refresh.</p>
      </div>
      <div class="di-stage">
        <div class="di-map" aria-label="Illustration: research activity lighting up across the United States">
          <img src="/images/di-us-dots.webp" width="1400" height="768" alt="" decoding="async" fetchpriority="high" />
          {pulses.map(([name, x, y, delay]) => <span class="di-ping" style={`--x:${x}%;--y:${y}%;--d:${delay}s`} title={name}><i></i></span>)}
          <span class="di-map-tag di-map-tag-b" style="--x:48.21%;--y:66.48%">Dallas · 4,500 searching</span>
        </div>
      <div class="di-audience-visual" aria-label="Illustration of audience research filters, not a live search result">
        <div class="di-visual-top"><span class="di-mini-mark">di</span><span>Audience explorer</span><span class="di-visual-caption">Illustration</span></div>
        <div class="di-search"><span aria-hidden="true">⌕</span> What is your audience researching?</div>
        <div class="di-filters"><span>Roofing</span><span>Dallas, Texas</span><span>Last 2-7 days</span></div>
        <div class="di-bars" aria-hidden="true">
          <div><span>Last 2 days</span><i style="--w:42%"></i><b>1,900</b></div>
          <div><span>Last 7 days</span><i style="--w:100%"></i><b>4,500</b></div>
        </div>
        <div class="di-visual-bottom"><span><i></i> Recent research activity</span><span class="di-reach"><strong data-count="4500">4,500</strong> matching contacts</span></div>
      </div>
      </div>
    </section>

    <section class="di-data di-wrap di-reveal" aria-labelledby="data-heading">
      <div class="di-section-intro"><p class="di-label">The data behind your audience</p><h2 id="data-heading">A bigger picture.<br />A sharper audience.</h2></div>
      <div class="di-stats">{stats.map(([number, label, detail]) => <article class="di-reveal"><strong data-count={number.replace(/[^0-9.]/g, '')} data-suffix={number.replace(/[0-9.]/g, '')}>{number}</strong><h3>{label}</h3><p>{detail}</p></article>)}</div>
    </section>

    <section class="di-problem di-wrap di-reveal">
      <div class="di-problem-copy">
        <p class="di-label">Take control of your targeting</p>
        <h2>A broad audience is easy.<br /><em>A relevant audience is the point.</em></h2>
        <p class="di-section-copy">A job title or a location only tells you part of the story. Add what people are researching, when they researched it and how it fits your market. Give your next campaign a more focused starting point.</p>
      </div>
      <div class="di-flow" role="list" aria-label="How an audience is built">
        <svg class="di-flow-line" viewBox="0 0 1000 220" preserveAspectRatio="none" fill="none" aria-hidden="true">
          <defs><linearGradient id="di-flow-grad" x1="0" x2="1"><stop stop-color="#b6f5c9" stop-opacity=".15"/><stop offset="1" stop-color="#b6f5c9"/></linearGradient></defs>
          <path d="M40 190 C 260 190, 260 130, 360 130 S 560 70, 660 70 S 880 30, 960 30" stroke="url(#di-flow-grad)" stroke-width="2"/>
        </svg>
        {[['Research activity', 'What people searched, read and compared in the last few days.'], ['Matched profiles', 'That activity matched to real business and consumer records.'], ['Your audience', 'Filtered by topic, location, recency and the attributes you choose.'], ['Your campaigns', 'Exported to ads, email and sales tools, ready to run.']].map(([t, d], i) => (
          <div class="di-flow-step di-reveal" role="listitem" style={`--i:${i};--reveal-delay:${i * 0.12}s`}><span class="di-flow-dot" aria-hidden="true"></span><strong>{t}</strong><p>{d}</p></div>
        ))}
      </div>
    </section>

    <section class="di-capabilities di-wrap di-reveal" id="capabilities">
      <div class="di-section-intro"><p class="di-label">One platform. Four practical jobs.</p><h2>From intent to action.</h2></div>
      <div class="di-cap-grid">
        {capabilities.map(([number, title, description, tags], i) => (
          <article class="di-capability di-reveal">
            <span class="di-cap-icon" aria-hidden="true">
              {i === 0 && <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l5 5"/></svg>}
              {i === 1 && <svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/></svg>}
              {i === 2 && <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="3"/><path d="M7 9h10M7 13h7M7 17h4"/></svg>}
              {i === 3 && <svg viewBox="0 0 24 24"><path d="M4 12h12M12 6l6 6-6 6"/><path d="M20 4v16"/></svg>}
            </span>
            <span class="di-step">{number}</span>
            <h3>{title}</h3>
            <p>{description}</p>
            <ul>{tags.map(tag => <li>{tag}</li>)}</ul>
          </article>
        ))}
      </div>
    </section>

    <section class="di-demo-video di-wrap di-reveal" id="platform">
      <div class="di-section-intro di-video-intro"><div><p class="di-label">See the actual platform</p><h2>Your market.<br />Your audience.<br /><em>Right on screen.</em></h2></div><p>Watch us search the Dallas roofing market and filter recent research activity. The walkthrough shows the last two days and the last seven days, so you can see how recency changes the audience.</p></div>
      <figure class="di-screen"><video controls preload="metadata" playsinline poster="/media/demand-intelligence-walkthrough-poster.jpg" width="1920" height="1080" aria-label="Demand Intelligence Dallas roofing walkthrough"><source src="/media/demand-intelligence-walkthrough.mp4" type="video/mp4" />Your browser does not support this video. <a href="/media/demand-intelligence-walkthrough.mp4">Download the walkthrough.</a></video><figcaption>Dallas roofing demonstration. Audience counts reflect the recorded search.</figcaption></figure>
    </section>

    <section class="di-activation di-wrap di-reveal">
      <div><p class="di-label">Built for the way you work</p><h2>Your data should<br />move with you.</h2><p class="di-section-copy">Build the audience once. Export the list, prepare an advertising audience or bring enriched contact information into your sales tools.</p><a class="di-text-link" href="#di-demo">See it with your use case <Arrow /></a></div>
      <div class="di-tools" aria-label="Audience activation use cases">
        {[['Meta Ads', 'M8 12c0-3 1.6-5 3.2-5s2.6 2 4 5 2.4 5 4 5 3.2-2 3.2-5-1.6-5-3.2-5-2.6 2-4 5-2.4 5-4 5S8 15 8 12z'], ['Google Ads', 'M12 3l8 14H4z'], ['Contact lists', 'M5 6h14M5 12h14M5 18h9'], ['Customer management', 'M12 4a4 4 0 110 8 4 4 0 010-8zM4 20c0-4 3.6-6 8-6s8 2 8 6'], ['Audience exports', 'M12 4v12M6 10l6 6 6-6M4 20h16'], ['Sales tools', 'M4 18l5-6 4 3 7-9']].map(([label, d]) => (
          <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d={d}/></svg>{label}</span>
        ))}
      </div>
    </section>

    <section class="di-questions di-wrap di-reveal" aria-labelledby="questions-heading"><div><p class="di-label">A closer look</p><h2 id="questions-heading">What you<br />want to know.</h2></div><div>{faqs.map(([question, answer]) => <article><h3>{question}</h3><p>{answer}</p></article>)}<nav aria-label="Related"><p class="di-label"><span></span> Related</p><p><a class="di-text-link" href="/audience-builder">Audience builder</a></p><p><a class="di-text-link" href="/intent-data-providers">Intent data providers</a></p><p><a class="di-text-link" href="/website-visitor-identification">Website visitor identification</a></p></nav></div></section>

    <section class="di-demo-section di-wrap di-reveal">
      <svg class="di-prism" viewBox="0 0 320 360" aria-hidden="true">
        <defs>
          <linearGradient id="pz1" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#e9fff2" stop-opacity=".55"/><stop offset=".5" stop-color="#b6f5c9" stop-opacity=".18"/><stop offset="1" stop-color="#0b1a12" stop-opacity=".6"/></linearGradient>
          <linearGradient id="pz2" x1="1" y1="0" x2="0" y2="1"><stop stop-color="#ffffff" stop-opacity=".35"/><stop offset=".6" stop-color="#e39a6b" stop-opacity=".16"/><stop offset="1" stop-color="#070c0a" stop-opacity=".7"/></linearGradient>
          <linearGradient id="pz3" x1="0" y1="1" x2="1" y2="0"><stop stop-color="#b6f5c9" stop-opacity=".45"/><stop offset="1" stop-color="#ffffff" stop-opacity=".05"/></linearGradient>
          <filter id="pzblur"><feGaussianBlur stdDeviation="18"/></filter>
        </defs>
        <ellipse cx="160" cy="330" rx="120" ry="18" fill="#b6f5c9" opacity=".25" filter="url(#pzblur)"/>
        <g class="di-prism-body">
          <polygon points="160,20 290,120 160,180 30,120" fill="url(#pz1)" stroke="#ffffff66"/>
          <polygon points="30,120 160,180 160,330 30,250" fill="url(#pz2)" stroke="#ffffff33"/>
          <polygon points="290,120 160,180 160,330 290,250" fill="url(#pz3)" stroke="#ffffff55"/>
          <path d="M60 110 L160 40" stroke="#ffffff" stroke-opacity=".7" stroke-width="2" stroke-linecap="round"/>
          <path d="M175 200 L175 300" stroke="#ffffff" stroke-opacity=".25" stroke-width="6" stroke-linecap="round"/>
        </g>
      </svg>
      <div><p class="di-label">See Demand Intelligence</p><h2>Let’s look at<br /><em>your market.</em></h2><p class="di-section-copy">Tell us who you want to reach. We’ll walk through the platform and show how to build an audience around your business, your location and what your customers are researching.</p><p class="di-demo-detail">A live product walkthrough with the Dead River Management team.</p></div>
      <form class="di-form" id="di-demo" data-redirect="/demand-intelligence/thanks">
        <h3>Request your demo</h3><p class="di-form-sub">See what the platform can do for your team.</p>
        <label class="field">Name<input name="name" type="text" autocomplete="name" maxlength="120" required /></label>
        <label class="field">Phone number<input name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="40" pattern="[+()\d\s.\-]{7,40}" required /></label>
        <label class="field">Email<input name="email" type="email" autocomplete="email" maxlength="200" required /></label>
        <label class="di-hp" aria-hidden="true">Fax<input name="fax" type="text" tabindex="-1" autocomplete="off" /></label>
        <button class="di-button di-submit" type="submit">Request my demo <Arrow /></button>
        <p class="di-form-status" role="status" aria-live="polite"></p>
        <p class="di-form-fine">By submitting, you agree that Dead River Management may contact you about your demo by phone or email. <a href="/privacy">Privacy policy</a>.</p>
      </form>
    </section>
  </div>
</Growth>

<script>
  import '../scripts/di-lead.js';
  // Count numbers up and reveal sections as they scroll in. Everything stays static if motion is off.
  document.body.classList.add('di-js');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const reveals = document.querySelectorAll('.di-reveal');
  if (reduce) reveals.forEach((el) => el.classList.add('is-in'));
  else {
    const ro = new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); ro.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
    reveals.forEach((el) => ro.observe(el));
  }
  if (!reduce) {
    const counters = document.querySelectorAll('[data-count]');
    const co = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        co.unobserve(entry.target);
        const el = entry.target; const target = Number(el.dataset.count); const suffix = el.dataset.suffix || ''; const start = performance.now();
        const tick = (t) => {
          const p = Math.min(1, (t - start) / 1400);
          const v = target * (1 - Math.pow(1 - p, 3));
          el.textContent = (Number.isInteger(target) ? Math.round(v).toLocaleString('en-US') : v.toFixed(1)) + suffix;
          if (p < 1) requestAnimationFrame(tick); else el.textContent = (Number.isInteger(target) ? target.toLocaleString('en-US') : target) + suffix;
        };
        requestAnimationFrame(tick);
      });
    });
    counters.forEach((el) => co.observe(el));
  }
</script>

<style>
  /* Dark product theme: deep forest black, mint signal, a warm copper glow. */
  :global(body:has(.di-product)) { --paper:#070c0a; --ink:#f3f6f3; --muted:#a5b2aa; --green:#b6f5c9; --sage:#13211a; --line:#243129; --copper:#e39a6b; background:var(--paper); }
  :global(body:has(.di-product) .site-header) { background:#070c0aeb; border-color:#243129; }
  :global(body:has(.di-product) .brand img) { filter:brightness(0) invert(1); }
  :global(body:has(.di-product) .nav-wrap nav a) { color:#e6efe8; }
  :global(body:has(.di-product) .nav-cta),:global(body:has(.di-product) .nav-text) { border-color:#3a4f42; color:#f3f6f3; }
  :global(body:has(.di-product) .nav-dropdown > div),:global(body:has(.di-product) .nav-wrap nav.is-open) { background:#0d1511; border-color:#243129; }
  :global(body:has(.di-product) .nav-contact) { color:#a5b2aa; border-color:#243129; }
  :global(body:has(.di-product) .nav-contact a) { color:#f3f6f3; }
  :global(body:has(.di-product) .nav-contact .nav-text) { border-color:#f3f6f3; }
  :global(body:has(.di-product) .menu-toggle) { border-color:#3a4f42; }
  :global(body:has(.di-product) .menu-toggle span) { background:#f3f6f3; }
  :global(body:has(.di-product) .site-footer) { background:#070c0a; border-top:1px solid #243129; }
  :global(body:has(.di-product) .site-footer .button) { background:#b6f5c9; color:#10251a; border-color:#b6f5c9; }
  :global(body:has(.di-product) .site-footer .button.secondary) { background:transparent; color:#f3f6f3; border-color:#3a4f42; }
  :global(body:has(.di-product) .footer-social a) { border-color:#3a4f42; color:#a5b2aa; }
  :global(body:has(.di-product) .footer-bottom) { border-color:#243129; }
  :global(body:has(.di-product) .footer-bottom .brand img) { filter:brightness(0) invert(1); }

  .di-product { overflow:hidden; position:relative; background:#070c0a; }
  .di-product::before { content:""; position:absolute; inset:-20%; z-index:0; pointer-events:none; background:radial-gradient(900px 600px at 82% 12%,#1a3f2a66,transparent 60%),radial-gradient(700px 500px at 8% 38%,#7a3d1e38,transparent 60%),radial-gradient(800px 600px at 60% 85%,#143a2655,transparent 60%); animation:di-mesh 26s ease-in-out infinite alternate; }
  .di-product > * { position:relative; z-index:1; }
  @keyframes di-mesh { 0% { transform:translate(0,0) scale(1); } 100% { transform:translate(-4%,3%) scale(1.08); } }
  :global(body.di-js) .di-reveal { opacity:0; transform:translateY(22px); transition:opacity .8s cubic-bezier(.22,1,.36,1) var(--reveal-delay,0s), transform .8s cubic-bezier(.22,1,.36,1) var(--reveal-delay,0s); }
  :global(body.di-js) .di-reveal.is-in { opacity:1; transform:none; }
  .di-wrap { width:min(1280px,calc(100% - 96px)); margin-inline:auto; position:relative; }
  .di-label { color:#b6f5c9; font-size:12px; font-weight:600; letter-spacing:.14em; text-transform:uppercase; margin-bottom:25px; display:flex; align-items:center; gap:10px; }
  .di-label span { width:7px; height:7px; background:#b6f5c9; border-radius:50%; box-shadow:0 0 12px #b6f5c9; }
  h1,h2,h3 { color:#f3f6f3; }
  h1 { font-size:clamp(48px,5.2vw,78px); line-height:1.04; letter-spacing:-.055em; }
  h2 { font-size:clamp(36px,4vw,56px); line-height:1.08; letter-spacing:-.045em; }
  em { color:#b6f5c9; font-style:normal; background:linear-gradient(90deg,#b6f5c9,#e9fff0 60%,#b6f5c9); -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent; }

  /* Glass shards: the one piece of theatre on the page. */
  .di-glass { position:absolute; pointer-events:none; border-radius:28px; background:linear-gradient(135deg,#ffffff38,#ffffff0a 40%,#b6f5c926 70%,#ffffff1f); border:1px solid #ffffff4d; box-shadow:inset 0 1px 0 #ffffff80, inset 0 -30px 60px #b6f5c926, 0 0 60px #b6f5c922, 0 40px 90px #00000080; backdrop-filter:blur(6px); transform:rotate(-14deg) skewY(6deg); animation:di-float 11s ease-in-out infinite; }
  .di-glass::after { content:""; position:absolute; inset:14%; border-radius:18px; background:linear-gradient(120deg,#ffffff18,transparent 55%,#e39a6b22); filter:blur(2px); }
  .di-glass-a { width:220px; height:320px; right:-110px; top:-20px; opacity:.85; }
  .di-glass-b { width:150px; height:220px; right:120px; bottom:-90px; transform:rotate(22deg) skewY(-6deg); animation-delay:-5s; opacity:.7; }
  .di-prism { position:absolute; width:300px; left:-30px; bottom:-40px; pointer-events:none; opacity:.95; filter:drop-shadow(0 30px 50px #00000080); }
  .di-prism-body { animation:di-float 9s ease-in-out infinite; transform-box:fill-box; transform-origin:center; }
  @keyframes di-float { 0%,100% { translate:0 0; } 50% { translate:0 -18px; } }

  .di-hero { display:grid; grid-template-columns:1fr 1.15fr; gap:40px; align-items:center; padding:88px 0 110px; }
  .di-stage { position:relative; z-index:1; min-height:540px; }
  .di-map { position:absolute; inset:-30px -140px auto 20px; aspect-ratio:1400/768; }
  .di-map img { width:100%; height:100%; display:block; opacity:.9; -webkit-mask-image:radial-gradient(ellipse at 50% 50%,#000 55%,transparent 85%); mask-image:radial-gradient(ellipse at 50% 50%,#000 55%,transparent 85%); }
  .di-ping { position:absolute; left:var(--x); top:var(--y); width:10px; height:10px; margin:-5px 0 0 -5px; }
