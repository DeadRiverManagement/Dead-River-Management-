<script>
  import '../scripts/di-lead.js';
  import { mountRiver } from '../scripts/river-scene.js';
  const scene = document.querySelector('[data-signals]');
  if (scene) mountRiver(scene, { variant: 'signals' });
  // Count numbers up and reveal sections as they scroll in. Everything stays static if motion is off.
  document.body.classList.add('di-js');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const reveals = document.querySelectorAll('.di-reveal');
  if (reduce) reveals.forEach((el) => el.classList.add('is-in'));
  else {
    const ro = new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); ro.unobserve(e.target); } }), { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
    reveals.forEach((el) => ro.observe(el));
  }
  if (!reduce) {
    const counters = document.querySelectorAll('[data-count]');
    const co = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        co.unobserve(entry.target);
        const el = entry.target; const target = Number(el.dataset.count); const suffix = el.dataset.suffix || ''; const start = performance.now();
        const tick = (t) => {
          const p = Math.min(1, (t - start) / 1400);
          const v = target * (1 - Math.pow(1 - p, 3));
          el.textContent = (Number.isInteger(target) ? Math.round(v).toLocaleString('en-US') : v.toFixed(1)) + suffix;
          if (p < 1) requestAnimationFrame(tick); else el.textContent = (Number.isInteger(target) ? target.toLocaleString('en-US') : target) + suffix;
        };
        requestAnimationFrame(tick);
      });
    });
    counters.forEach((el) => co.observe(el));
  }
</script>

<style>
  /* Dark product theme: deep forest black, mint signal, a warm copper glow. */
  .di-product { overflow:hidden; position:relative; background:#0a0a0b; }
  .di-product::before { content:""; position:absolute; inset:-20%; z-index:0; pointer-events:none; background:radial-gradient(900px 600px at 82% 12%,#c8743f22,transparent 60%),radial-gradient(700px 500px at 8% 38%,#7a3d1e2e,transparent 60%); animation:di-mesh 26s ease-in-out infinite alternate; }
  .di-product > * { position:relative; z-index:1; }
  @keyframes di-mesh { 0% { transform:translate(0,0) scale(1); } 100% { transform:translate(-4%,3%) scale(1.08); } }
  :global(body.di-js) .di-reveal { opacity:0; transform:translateY(22px); transition:opacity .8s cubic-bezier(.22,1,.36,1) var(--reveal-delay,0s), transform .8s cubic-bezier(.22,1,.36,1) var(--reveal-delay,0s); }
  :global(body.di-js) .di-reveal.is-in { opacity:1; transform:none; }
  .di-wrap { width:min(1280px,calc(100% - 96px)); margin-inline:auto; position:relative; }
  .di-label { color:#f2b183; font-size:12px; font-weight:600; letter-spacing:.14em; text-transform:uppercase; margin-bottom:25px; display:flex; align-items:center; gap:10px; }
  .di-label span { width:7px; height:7px; background:#f2b183; border-radius:50%; box-shadow:0 0 12px #f2b183; }
  h1,h2,h3 { color:#f1efea; }
  h1 { font-size:clamp(48px,5.2vw,78px); line-height:1.04; letter-spacing:-.055em; }
  h2 { font-size:clamp(36px,4vw,56px); line-height:1.08; letter-spacing:-.045em; }
  em { color:#f2b183; font-style:normal; background:linear-gradient(90deg,#f2b183,#ffd9bf 60%,#f2b183); -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent; }

  @keyframes di-float { 0%,100% { translate:0 0; } 50% { translate:0 -18px; } }

  .di-hero { display:grid; grid-template-columns:1fr 1.15fr; gap:40px; align-items:center; padding:88px 0 110px; }
  .di-scene { position:absolute; top:-120px; bottom:-40px; left:calc(50% - 50vw); width:100vw; z-index:0; pointer-events:none; -webkit-mask-image:linear-gradient(180deg,transparent,#000 12%,#000 70%,transparent); mask-image:linear-gradient(180deg,transparent,#000 12%,#000 70%,transparent); }
  .di-scene canvas { width:100%; height:100%; display:block; }
  .di-hero > :not(.di-scene) { position:relative; z-index:1; }
  .di-stage { position:relative; z-index:1; min-height:560px; perspective:1400px; }
  /* The intent core: signals orbit it on tilted rings. */
  .di-orbit { position:absolute; right:-30px; top:-70px; width:min(520px,100%); aspect-ratio:1; transform-style:preserve-3d; transition:transform .8s cubic-bezier(.22,1,.36,1); }
  .di-stage:hover .di-orbit { transform:rotateX(6deg) rotateY(-8deg); }
  .di-core { position:absolute; left:50%; top:50%; width:150px; height:150px; margin:-75px 0 0 -75px; border-radius:50%; background:radial-gradient(circle at 38% 34%,#ffe2cc,#f2b183 28%,#b5663f 58%,#3a1c10 100%); box-shadow:0 0 60px #c8743f88, 0 0 140px #c8743f44, inset -20px -24px 50px #2a1208; animation:di-float 9s ease-in-out infinite; }
  .di-core i { position:absolute; inset:-28px; border-radius:50%; border:1px solid #f2b18355; animation:di-breathe 4s ease-in-out infinite; }
  @keyframes di-breathe { 0%,100% { transform:scale(1); opacity:.6; } 50% { transform:scale(1.18); opacity:0; } }
  .di-ring { position:absolute; left:50%; top:50%; width:var(--d); height:var(--d); margin:calc(var(--d) / -2) 0 0 calc(var(--d) / -2); border-radius:50%; border:1px solid #f2b18333; box-shadow:0 0 30px #c8743f22 inset; transform-style:preserve-3d; transform:rotateX(var(--tilt)) rotateY(var(--lean)); }
  .di-ring::before { content:""; position:absolute; inset:-1px; border-radius:50%; border:1px solid transparent; border-top-color:#f2b183aa; animation:di-spin var(--t) linear infinite; }
  .di-ring-a { --d:300px; --tilt:68deg; --lean:0deg; --t:18s; --start:0deg; }
  .di-ring-b { --d:420px; --tilt:72deg; --lean:-18deg; --t:26s; --start:140deg; }
  .di-ring-c { --d:540px; --tilt:66deg; --lean:14deg; --t:34s; --start:250deg; }
  .di-ring-d { --d:360px; --tilt:76deg; --lean:30deg; --t:22s; --start:60deg; }
  .di-ring-e { --d:480px; --tilt:62deg; --lean:-32deg; --t:30s; --start:200deg; }
  .di-node { position:absolute; inset:0; transform-style:preserve-3d; animation:di-spin var(--t) linear infinite; animation-delay:calc(var(--start) / 360deg * var(--t) * -1); }
  .di-node-face { position:absolute; left:50%; top:0; transform-style:preserve-3d; animation:di-spin var(--t) linear infinite reverse; animation-delay:calc(var(--start) / 360deg * var(--t) * -1); }
  .di-node-face > * { display:block; transform:rotateY(calc(-1 * var(--lean))) rotateX(calc(-1 * var(--tilt))); transform-origin:0 0; }
  .di-node-face b { width:12px; height:12px; margin:-6px 0 0 -6px; border-radius:50%; background:#f2b183; box-shadow:0 0 16px #f2b183, 0 0 0 5px #f2b18322; }
  .di-node-face span, .di-node-face small { position:absolute; left:14px; top:-9px; white-space:nowrap; font-size:12px; color:#f1efea; background:#0a0a0bcc; border:1px solid #ffffff22; border-radius:999px; padding:4px 10px; backdrop-filter:blur(6px); }
  .di-node-face small { top:14px; left:14px; font-size:10px; color:#9c9b94; letter-spacing:.08em; text-transform:uppercase; }
  @keyframes di-spin { to { transform:rotateZ(360deg); } }
