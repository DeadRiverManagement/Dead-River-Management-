---
import Growth from '../layouts/Growth.astro';
import Arrow from '../components/growth/Arrow.astro';
// Cold-traffic offer page: claim, guarantee, proof. Same formula as the trade pages.
const videoSchema = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: 'Dead River Demand Intelligence walkthrough',
  description:
    'A continuous walkthrough of Dead River Demand Intelligence narrowing the Dallas roofing market into in-market prospects using purchase-intent signals from the last 24-48 hours.',
  thumbnailUrl:
    'https://www.deadrivermanagement.com/media/demand-intelligence-walkthrough-poster.jpg',
  contentUrl:
    'https://www.deadrivermanagement.com/media/demand-intelligence-walkthrough.mp4',
  uploadDate: '2026-09-19',
};
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Dead River Demand Intelligence',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  description:
    'Unlimited daily-refreshed purchase intent data delivered as verified email lists and custom ad audiences for Meta and Google.',
};
const faqs = [
  [
    'What is purchase intent data?',
    "Purchase intent data shows you who searched for your solution in the last 24-48 hours. It helps you target warm prospects instead of cold traffic. It doesn't prove someone will buy, but it shows they're actively researching right now.",
  ],
  [
    'How accurate is the data?',
    "45-55% accuracy, which is industry-leading. We had 1 bounce out of 10,000 emails. Compare that to ZoomInfo or Apollo where you're lucky to get 60%. Plus, you're protected by the guarantee.",
  ],
  [
    'What counts as "2x email response rates"?',
    'If your current open rate is 20%, we need to get you to 40%+. If your current reply rate is 2%, we need to get you to 4%+. We track this via read-only access to your email platform.',
  ],
  [
    'What counts as "double your ad ROAS"?',
    'If your current ROAS is 1.5x, we need to get you to 3x+. If your current ROAS is 2x, we need to get you to 4x+. We track this via read-only access to your ad accounts.',
  ],
  [
    "What if I don't hit the targets?",
    'You get a partial refund. Hit one target (either 2x email OR 2x ROAS), you get 50% back. Hit neither target, you get 75% back. Full guarantee terms are in your agreement.',
  ],
  [
    'Does this work for B2B and B2C?',
    'Yes. Dead River Demand Intelligence supports business and consumer audience use cases, subject to platform coverage and the rules that apply to each market.',
  ],
  [
    'Can I use this data for cold calling?',
    'No. The data is optimized for email and ad targeting only. Cold calling and SMS are NOT supported. Using data for cold calls or texts will void the guarantee.',
  ],
  [
    'How is this different from ZoomInfo or Bombora?',
    'Three things: 1) Daily refresh (our data is from the last 24-48 hours, not 30-90 days old). 2) Unlimited data points (no caps). 3) Instant delivery (5 minutes vs. 3-7 days). Plus, we have the guarantee.',
  ],
  [
    'How does Demand Intelligence pricing work?',
    'Scope and fees are confirmed on a demo based on your market and use case. Unlimited data points, daily refresh, instant delivery, and a partial refund guarantee if targets are not hit.',
  ],
  [
    'What is buyer intent data?',
    "Buyer intent data is the same thing as purchase intent data: signals that a person or company is actively researching a product or service right now, such as searches, page visits, and content reads in the last 24 to 48 hours. It tells you who is in the market today, so you can reach them before they pick someone else.",
  ],
  [
    'How do I get intent data for my business?',
    'Through a provider that collects and matches the signals, like Demand Intelligence. You tell us the topics and locations that matter, we deliver the matching audiences daily, and you use them in email, ads, or calls. Book a demo and we will show you the live reach for your market.',
  ],
  [
    "What if I'm already using another intent data provider?",
    "Cool. What's your current email reply rate? What's your ad ROAS? If we can't beat it, you get a refund. Other providers often cap or age their data; we provide unlimited daily-refreshed data and discuss fit and scope on a demo.",
  ],
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(([name, text]) => ({
    '@type': 'Question',
    name,
    acceptedAnswer: { '@type': 'Answer', text },
  })),
};
const results = [
  ['45%', 'email open rate (2x industry average of 20%)'],
  ['22%', 'link click rate (2x industry average of 10%)'],
  ['12%', 'positive reply rate (6-12x industry average of 1-2%)'],
  ['58%', 'meeting booking rate from positive replies (7 meetings from 12 positive replies)'],
  ['2x', 'ad ROAS improvement (from 1.5x to 3x+)'],
  ['85%', 'lower ad cost per lead ($30 on Facebook vs. industry average $200+)'],
];
const tiers = [
  ['Hit BOTH targets (2x email response AND 2x ROAS)', 'You pay full price, no refund'],
  ['Hit ONE target (either 2x email OR 2x ROAS)', 'You get 50% refund'],
  ['Hit NEITHER target (less than 1.5x improvement on both)', 'You get 75% refund'],
];
const requirements = [
  'You must be sending minimum 1,000 emails/month',
  'You must have meaningful paid spend on Meta or Google',
  'You must email provided lists within 7 days of delivery',
  'You must upload provided ad audiences within 7 days of delivery',
  'You must run campaigns for full 60 days without pausing for more than 48 consecutive hours',
  'You must provide read-only access to email platform and ad accounts for performance tracking',
  'You must use data refreshed within 48 hours (no using 30-day-old data)',
];
const features = [
  [
    'Verified email lists (Instantly enriched)',
    'Get unlimited verified emails of prospects who searched for your solution in the last 24-48 hours. <1% bounce rate. Instant delivery.',
  ],
  [
    'Custom ad audiences (Meta/Google)',
    'Get ready-to-upload ad audiences for Facebook, Instagram, and Google Ads. No manual audience building. Just upload and run.',
  ],
  [
    'Daily data refresh',
    'Your data is never stale. We refresh daily with new prospects who searched in the last 24-48 hours. Competitors use 30-90 day old data.',
  ],
  [
    'Instant delivery (5 minutes)',
    'Pull a custom list in 5 minutes. No waiting 3-7 days like other providers. Segment by company size, industry, job title, location, and search topic.',
  ],
  [
    'Unlimited data points',
    'No caps. No limits. You get unlimited data with daily refresh; scope and fees are confirmed on a demo.',
  ],
  [
    'B2B and B2C',
    'Use the same platform across both business and consumer markets. All industries supported.',
  ],
];
const bestFor = [
  'Marketing agencies running ads or email campaigns for clients',
  'SaaS companies with meaningful paid ad budgets',
  'B2B companies doing outbound email (1,000+ emails/month)',
  'Sales teams tired of working completely cold lists',
  'Growth teams that need better targeting data',
];
const minimums = [
  'Sending 1,000+ emails/month OR running meaningful paid campaigns',
  'Targeting B2B or B2C audiences in the U.S.',
  'Product/service with minimum $1,000 LTV',
  'Email deliverability above 85% (if doing email outreach)',
];
const compare = [
  ['Data freshness', '24-48 hours (daily refresh)', '30-90 days old (stale data)'],
  ['Data volume', 'Unlimited data points', '2M-4M data points (capped)'],
  ['Delivery speed', '5 minutes (instant)', '3-7 days (slow)'],
  ['Pricing', 'Scope confirmed on a demo', 'Varies by provider and data limits'],
  ['Guarantee', 'Partial refund if targets not hit', 'No guarantee (you waste money on bad data)'],
  ['Email accuracy', '<1% bounce rate (Instantly enriched)', '5-10% bounce rate (unverified)'],
  ['Ad audiences', 'Ready-to-upload (Meta/Google)', 'You build them yourself'],
  ['Results', '45% open, 12% reply, 2x ROAS', '20% open, 1-2% reply, 1.5x ROAS (industry avg)'],
];
const included = [
  'Unlimited daily-refreshed purchase intent data',
  'Verified email lists (Instantly enriched, <1% bounce rate)',
  'Custom ad audiences (Meta/Google, ready-to-upload)',
  'Instant delivery (5 minutes to pull custom list)',
  'Segment by company size, industry, job title, location, search topic',
  'B2B and B2C support (all industries)',
  'Partial refund guarantee if targets not hit in 60 days',
];
const seeing = [
  '4,500 homeowners who searched for "roofing," "roof repair," "roof inspection," or "roof damage" in the last 7 days',
  'Verified emails delivered instantly (Instantly enriched, <1% bounce rate)',
  'Ready-to-upload custom ad audiences for Meta and Google',
  'Segmented by location, search topic, and recency',
];
---

<Growth
  title="2x Email Response & Ad ROAS in 60 Days | Demand Intelligence"
  description="Unlimited daily purchase intent data for agencies and SaaS. 2x email response rates and double ad ROAS in 60 days, or you pay nothing. Book a demo."
  ogImage="/media/demand-intelligence-walkthrough-poster.jpg"
  schema={[videoSchema, productSchema, faqSchema]}
>
  <section class="page-hero wrap di-hero">
    <div class="di-hero-copy">
    <p class="eyebrow">
      Dead River Demand Intelligence • Daily-Refreshed Purchase Intent Data
    </p>
    <h1>
      2x your email response rates and double your ad ROAS in 60 days,{' '}
      <em>guaranteed.</em>
    </h1>
    <p class="intro">
      Most marketing agencies and SaaS companies waste 60-80% of their ad spend
      and email outreach on cold prospects who will never buy. Dead River Demand
      Intelligence gives you unlimited purchase intent data showing exactly who
      searched for your solution in the last 24-48 hours, delivered as verified
      email lists and custom ad audiences. No guessing, no cold outreach, no
      wasted budget. Just warm prospects who are actively in-market right now.
    </p>
    <p class="di-lead">
      If we don't 2x your email response rates AND double your ad ROAS within
      60 days, you get a partial refund.
    </p>
    <ul class="di-trust">
      <li>Scope confirmed on a demo</li>
      <li>Unlimited data points</li>
      <li>Daily refresh</li>
      <li>Instant delivery</li>
    </ul>
    <div class="button-row">
      <a class="button" href="#platform">See the Platform <Arrow /></a>
      <a class="text-link" href="#di-demo">Book a Demo <Arrow /></a>
    </div>
    </div>
    <form
      class="di-form"
      id="di-demo"
      data-redirect="/demand-intelligence/thanks"
    >
      <h2>Book your demo</h2>
      <p class="di-form-sub">
        See how many in-market prospects we can find in your market.
      </p>
      <label class="field">
        Name
        <input name="name" type="text" autocomplete="name" maxlength="120" required />
      </label>
      <label class="field">
        Phone number
        <input name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="40" pattern="[+()\d\s.\-]{7,40}" required />
      </label>
      <label class="field">
        Email
        <input name="email" type="email" autocomplete="email" maxlength="200" required />
      </label>
      <label class="di-hp" aria-hidden="true">
        Fax <input name="fax" type="text" tabindex="-1" autocomplete="off" />
      </label>
      <button class="button di-submit" type="submit">Book My Demo <Arrow /></button>
      <p class="di-form-status" role="status" aria-live="polite"></p>
      <p class="di-form-fine">
        By submitting, you agree that Dead River Management may contact you
        about your demo by phone or email.
      </p>
    </form>
  </section>

  <section class="section soft">
    <div class="wrap">
      <p class="eyebrow">Proven results</p>
      <h2>Here's what we did for ourselves using this exact data.</h2>
      <p class="intro">
        Before using daily-refreshed purchase intent data, we were getting
        industry-average results: 20% email open rates, 1-2% reply rates, and
        1.5x ad ROAS. After switching to targeting only prospects who searched
        for our solution in the last 24-48 hours, everything changed.
      </p>
      <h3 class="di-sub">Results using Dead River Demand Intelligence:</h3>
      <div class="di-results">
        {results.map(([n, l]) => (
          <article>
            <strong>{n}</strong>
            <p>{l}</p>
          </article>
        ))}
      </div>
      <p class="di-lead">
        This is the same data we're giving you. Same daily refresh. Same
        verified emails. Same custom ad audiences.
      </p>
    </div>
  </section>

  <section class="section wrap" id="platform">
    <div class="section-head">
      <div>
        <p class="eyebrow">See the platform</p>
        <h2>See how fast you can go from broad market to in-market prospects.</h2>
      </div>
      <p>
        Watch how quickly a broad market can be narrowed into a focused audience
        using recent purchase-intent signals from the last 24-48 hours.
      </p>
    </div>
    <figure class="video-frame">
      <video
        controls
        preload="metadata"
        playsinline
        poster="/media/demand-intelligence-walkthrough-poster.jpg"
        width="1920"
        height="1080"
        aria-label="Dead River Demand Intelligence product walkthrough"
      >
        <source
          src="/media/demand-intelligence-walkthrough.mp4"
          type="video/mp4"
        />
        Your browser does not support embedded video. You can
        <a href="/media/demand-intelligence-walkthrough.mp4">
          download the walkthrough
        </a>
        instead.
      </video>
      <figcaption>
        This walkthrough uses the Dallas roofing market as an example, but the
        same platform supports B2B and B2C use cases nationwide.
      </figcaption>
    </figure>
    <div class="split di-seeing">
      <div>
        <h3>What you're seeing:</h3>
        <ul class="check-list">
          {seeing.map((s) => <li>{s}</li>)}
        </ul>
        <p class="di-lead">
          This is what your sales and marketing teams get: warm prospects who
          are actively looking for what you sell right now.
        </p>
      </div>
      <figure class="shot-frame">
        <div class="shot-bar" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
          <em>Dead River Demand Intelligence · Purchase Intent</em>
        </div>
        <div
          class="shot-scroll"
          tabindex="0"
          aria-label="Product screenshot. Scroll sideways on small screens."
        >
          <picture>
            <source
              srcset="/images/demand-intelligence-purchase-intent.webp"
              type="image/webp"
            />
            <img
              src="/images/demand-intelligence-purchase-intent.png"
              width="1641"
              height="366"
              alt="Demand Intelligence purchase-intent screen. Filters: Purchase Intent, lookback last 7 days, topics Roofing, Roof Repair, Roof Inspection, and Roof Damage, location Dallas, TX. Estimated reach: 4.5K matching contacts."
              loading="lazy"
              decoding="async"
            />
          </picture>
        </div>
        <figcaption>
          Dallas, TX · last 7 days · Roofing, Roof Repair, Roof Inspection, Roof
          Damage · 4.5K matching contacts.
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="section wrap">
    <div class="di-guarantee">
      <p class="eyebrow">Zero-risk guarantee</p>
      <h2>If we don't 2x your results in 60 days, you get a partial refund.</h2>
      <p class="di-lead">Here's how the guarantee works:</p>
      <p>
        If we don't 2x your email response rates AND double your ad ROAS within
        60 days, here's what happens:
      </p>
      <div class="di-tiers">
        {tiers.map(([when, then]) => (
          <article>
            <p>{when}</p>
            <strong>→ {then}</strong>
          </article>
        ))}
      </div>
      <h3>Requirements to qualify for the guarantee:</h3>
      <ul class="check-list">
        {requirements.map((r) => <li>{r}</li>)}
      </ul>
      <p class="di-small">Full guarantee terms are confirmed in your agreement.</p>
    </div>
  </section>

  <section class="section soft">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">What you get</p>
          <h2>
            Unlimited daily-refreshed purchase intent data delivered in 5
            minutes.
          </h2>
        </div>
        <p>
          Stop wasting time and money on cold prospects. Start targeting people
          who are actively searching for what you sell right now.
        </p>
      </div>
      <div class="capability-grid">
        {features.map(([h, p]) => (
          <article>
            <h3>{h}</h3>
            <p>{p}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section wrap">
    <p class="eyebrow">Who this is for</p>
    <h2>
      Built for marketing agencies and SaaS companies wasting budget on cold
      traffic.
    </h2>
    <p class="intro">
      If you're running meaningful paid campaigns or sending 1,000+ emails/month
      and not hitting 2x ROAS or 10%+ reply rates, you're wasting money on cold
      prospects. This fixes that.
    </p>
    <div class="split di-who">
      <article class="feature-panel">
        <h3>Who gets the best results:</h3>
        <ul class="check-list">
          {bestFor.map((b) => <li>{b}</li>)}
        </ul>
      </article>
      <article class="feature-panel">
        <h3>Minimum requirements:</h3>
        <ul class="check-list">
          {minimums.map((m) => <li>{m}</li>)}
        </ul>
      </article>
    </div>
  </section>

  <section class="section soft">
    <div class="wrap">
      <p class="eyebrow">How we compare</p>
      <h2>
        Why Dead River Demand Intelligence beats ZoomInfo, Bombora, and Audience
        Labs.
      </h2>
      <div class="table-scroll" tabindex="0" aria-label="Comparison table. Scroll sideways on small screens.">
        <table class="comparison-table di-compare">
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">Feature</span></th>
              <th scope="col">Dead River</th>
              <th scope="col">Competitors (ZoomInfo, Bombora, Audience Labs)</th>
            </tr>
          </thead>
          <tbody>
            {compare.map(([f, us, them]) => (
              <tr>
                <th scope="row">{f}</th>
                <td>{us}</td>
                <td>{them}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="di-lead">
        The difference: We give you better data, faster delivery, unlimited
        volume, and a guarantee. They don't.
      </p>
    </div>
  </section>

  <section class="section wrap split">
    <div>
      <p class="eyebrow">Platform access, scoped to your team.</p>
      <h2>Talk through the right scope.</h2>
      <p class="intro">
        Full platform access for your team. Scope and fees are confirmed on a
        demo based on your market and use case; no public price is listed here.
      </p>
      <p>Agency and multi-client arrangements are discussed on the demo.</p>
      <a class="button" href="#di-demo">Book a Demo <Arrow /></a>
    </div>
    <article class="feature-panel">
      <h3>What's included:</h3>
      <ul class="check-list">
        {included.map((i) => <li>{i}</li>)}
      </ul>
    </article>
  </section>

  <section class="section soft">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Purchase intent data FAQ</p>
          <h2>Clear answers before you book a demo.</h2>
        </div>
      </div>
      <div class="faq-list">
        {faqs.map(([question, answer]) => (
          <details>
            <summary>{question}</summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="closing wrap">
    <div>
      <p class="eyebrow">Next step</p>
      <h2>
        See what 2x email response rates and 2x ad ROAS looks like for your
        business.
      </h2>
      <p>
        Book a demo and we'll show you exactly how many in-market prospects we
        can identify in your market right now. No obligation. No pressure. Just
        data.
      </p>
    </div>
    <div class="closing-actions">
      <a class="button" href="#platform">See the Platform <Arrow /></a>
      <a class="text-link" href="#di-demo">Book a Demo <Arrow /></a>
    </div>
  </section>
</Growth>

<script>
  import '../scripts/di-lead.js';
</script>

<style>
  .di-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 400px;
    gap: 48px;
    align-items: start;
  }
  .di-hero h1 {
    max-width: 1000px;
  }
  .di-form {
    border: 1px solid var(--line);
    background: #fffdf9;
    border-radius: 12px;
    padding: 30px;
    box-shadow: 0 14px 45px rgb(25 56 47 / 8%);
  }
  .di-form h2 {
    font-size: 28px;
    margin-bottom: 6px;
  }
  .di-form-sub {
    margin: 0 0 18px;
    font-size: 15px;
  }
  .di-form .field {
    margin-bottom: 14px;
  }
  .di-hp {
    position: absolute;
    left: -9999px;
  }
  .di-submit {
    width: 100%;
    justify-content: center;
    font-size: 18px;
    padding-block: 17px;
    margin-top: 6px;
  }
  .di-form-status:empty {
    display: none;
  }
  .di-form-status {
    margin: 12px 0 0;
    font-size: 15px;
    color: var(--ink);
  }
  .di-form-status[data-state='error'] {
    color: #a33b2b;
  }
  .di-form-fine {
    margin: 12px 0 0;
    font-size: 12px;
    color: var(--muted);
  }
  .di-hero h1 em {
    color: #597d63;
    font-style: normal;
  }
  .di-lead {
    font-size: 19px;
    color: var(--ink);
    font-weight: 500;
    max-width: 820px;
    margin: 18px 0;
  }
  .di-trust {
    list-style: none;
    padding: 0;
    margin: 8px 0 26px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 26px;
    font-size: 15px;
    color: var(--muted);
  }
  .di-trust li:before {
    content: '✓ ';
    color: var(--green);
  }
  .di-sub {
    margin: 30px 0 16px;
    font-size: 22px;
  }
  .di-results {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .di-results > * {
    min-width: 0;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 22px;
  }
  .di-results strong {
    display: block;
    font-family: var(--display);
    font-size: 44px;
    letter-spacing: -0.04em;
    color: var(--green);
    line-height: 1;
    margin-bottom: 10px;
  }
  .di-results p {
    margin: 0;
  }
  .di-seeing {
    align-items: start;
    margin-top: 36px;
  }
  .di-seeing > *,
  .di-who > * {
    min-width: 0;
  }
  .di-seeing h3,
  .di-who h3 {
    font-size: 22px;
    margin-bottom: 10px;
  }
  .di-who {
    align-items: start;
    margin-top: 28px;
  }
  .di-guarantee {
    background: var(--green);
    border-radius: 12px;
    padding: 48px;
  }
  .di-guarantee h2,
  .di-guarantee h3,
  .di-guarantee .di-lead,
  .di-guarantee strong,
  .di-guarantee .eyebrow {
    color: #fff;
  }
  .di-guarantee p,
  .di-guarantee .check-list li {
    color: #e3ece0;
  }
  .di-guarantee .check-list li:before {
    color: #d9e9bc;
  }
  .di-guarantee h3 {
    margin: 30px 0 10px;
    font-size: 22px;
  }
  .di-tiers {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-top: 20px;
  }
  .di-tiers > * {
    min-width: 0;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 10px;
    padding: 20px;
  }
  .di-tiers p {
    margin: 0 0 10px;
  }
  .di-tiers strong {
    font-size: 18px;
  }
  .di-small {
    margin-top: 18px;
    font-size: 14px;
  }
  .di-compare th,
  .di-compare td {
    width: 38%;
  }
  .di-compare tr > :first-child {
    width: 24%;
  }
  .di-compare tr > :nth-child(3) {
    background: transparent;
  }
  .di-compare tr > :nth-child(2) {
    background: #e8eedf;
    color: var(--ink);
    font-weight: 500;
  }
  .sr-only {
    position: absolute;
